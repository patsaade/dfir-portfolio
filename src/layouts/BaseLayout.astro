---
// Base page shell — head, theme styles, sticky nav, main slot, footer, skip link.
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/motion.css'; // charm/decorative animations (see file header)
import { css } from 'styled-system/css';
import BaseHead from '../components/BaseHead.astro';
import ThemeStyles from '../components/ThemeStyles.astro';
import Background from '../components/Background.astro';
import Ticker from '../components/Ticker.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HoverCards from '../components/HoverCards.astro';
import SoundEngine from '../components/SoundEngine.astro';
import Search from '../components/Search.astro';
import OfflineIndicator from '../components/OfflineIndicator.astro';
import BackToTop from '../components/BackToTop.astro';
import ToolSidebar from '../components/ToolSidebar.astro';
import AnimatedDetails from '../components/AnimatedDetails.astro';
import AnimatedSwitch from '../components/AnimatedSwitch.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { DEFAULT_DARK } from '../themes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  section?: string;
  robots?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="theme-preload" data-theme={DEFAULT_DARK} data-mode="dark">
  <head>
    <BaseHead {...props} />
    <ThemeStyles />
  </head>
  <body>
    <Background />

    {/* Eager loader only — defines window.__soundLoad(); the Web Audio engine (window.__sound) is dynamically imported on demand. */}
    <SoundEngine />

    <a
      href="#main"
      class={css({
        position: 'absolute',
        left: '-9999px',
        _focus: {
          left: '1rem',
          top: '1rem',
          zIndex: 100,
          bg: 'primary',
          color: 'onPrimary',
          px: '1rem',
          py: '0.5rem',
          borderRadius: 'md',
        },
      })}
    >
      Skip to content
    </a>

    <Ticker />
    <Navigation />

    {/* Site-wide DFIR sidebar — desktop/tablet only, no per-page gating (see CLAUDE.md invariant 13). */}
    <ToolSidebar />

    {/* Animates every <details> element's open/close instead of the native
        instant toggle (see CLAUDE.md invariant 12). Mounted here so no page
        has to opt in, but it is NOT a site-wide payload: the component is a
        tiny gate that only dynamically imports the animation chunk when the
        page actually contains a <details> — roughly 20 pages out of ~1,700.
        See AnimatedDetails.astro's own docblock. */}
    <AnimatedDetails />

    {/* Slides a thumb behind the active segment of every segmented switch
        (role="radiogroup") site-wide — see AnimatedSwitch.astro / CLAUDE.md
        invariant 12 for the mechanism and its retrofit contract. */}
    <AnimatedSwitch />

    <main
      id="main"
      class={css({
        maxW: '960px',
        mx: 'auto',
        px: '1.25rem',
        py: { base: '2rem', md: '3rem' },
        minH: '60vh',
        animation: 'fadeIn 400ms ease both',
        // ToolSidebar (invariant 13) is `position: fixed, left: 0` at `md`+,
        // 240px wide (its own `RAIL_W` — kept as a literal here too, not an
        // import, since Panda needs a static string to generate a class;
        // update both together if the rail's width ever changes). Plain
        // `mx: 'auto'` centering computes each side's margin as
        // `(viewport − 960) / 2`, which is only ≥ 240px once the viewport is
        // ~1432px wide — below that (which includes ordinary 1280×800/
        // 1366×768 laptop screens), the rail's fixed-position right edge
        // physically overlapped this column's own left edge, truncating
        // headings behind the panel. `max(...)` guarantees at least the
        // rail's width in reserve at `md`+ without changing anything at
        // wider viewports where the natural centered margin already clears
        // it. `--sidebar-reserve` (read via `var()`, not a Panda condition —
        // see CLAUDE.md's own "a Panda selector that should compile to a
        // compound selector sometimes doesn't" gotcha) is kept in sync with
        // the rail's actual hidden/shown state by ToolSidebar.astro's own
        // `render()`, the same pattern that component already uses for
        // `--sidebar-max-h`. The `240px` literal fallback inside
        // `var()` is what a no-JS visitor gets — correct, since the rail's
        // own server-rendered default is `data-view="shown"`.
        md: {
          marginLeft: 'max(var(--sidebar-reserve, 240px), calc((100% - 960px) / 2))',
          marginRight: 'auto',
        },
      })}
    >
      <slot />
    </main>

    <Footer />

    {/* Site-wide hover/tap context cards (Floating UI). Auto-wraps companies,
        certs, and key tools; <Term> handles glossary terms. */}
    <HoverCards />

    {/* Site-wide ⌘K search palette (build-time index at /search-index.json). */}
    <Search />

    {/* Vercel Web Analytics is injected by the @astrojs/vercel adapter
        (webAnalytics.enabled in astro.config.mjs). Speed Insights below. */}
    <SpeedInsights />

    {/* Tells the reader when they've gone offline (and are on the cached copy). */}
    <OfflineIndicator />

    <BackToTop />

    {/* Register the service worker for offline reading + fast repeat loads (see public/sw.js). */}
    <script>
      // @ts-nocheck — vanilla DOM client script
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
