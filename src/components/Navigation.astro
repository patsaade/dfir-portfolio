---
// Sticky top nav — brand, links, theme picker, mode toggle, mobile menu.
import { css } from 'styled-system/css';
import { NAV_LINKS, MORE_LINKS, PERSONAL_HREFS, SITE, groupsFor } from '../consts';
import ThemePicker from './ThemePicker.astro';
import ModeToggle from './ModeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import PixelStar from './PixelStar.astro';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
// Four dropdowns — desktop menus, plus a flat link each in the mobile menu.
// Each is a list of categories (a category's label renders as a small header
// inside the menu; "More" has just one, unlabeled category so it stays a flat
// list).
// Single source of truth for the gap between the nav and EVERY dropdown
// panel (moreMenuOuter/menuPanelOuter/menuPanelOuterWide/drillsMenuOuter's own
// `pt` below) — a literal value duplicated in several places is exactly how
// they drifted out of sync before (see moreWrap's own comment for that
// history); one constant means they physically can't diverge again. Tightened
// from an earlier 0.6rem, which read as too much distance once every dropdown
// actually shared it.
const navMenuGap = '0.3rem';
// Flat, single-level selector on purpose — never nest it with a second
// self-selector (the documented Panda compound-selector gotcha).
const hideOnCyberkit = css({ '[data-brand="cyberkit"] &': { display: 'none' } });
// `groupsFor` is imported from consts.ts — the nav, the sidebar, the footer
// and the section index pages all derive their menus through that one shape,
// so none of them can drift apart. Note it takes the SINGULAR EntryType value
// ('reference' | 'tool' | 'drill'), which is deliberately not the same string
// as the dropdown ids below ('reference' | 'tools' | 'drills') — don't
// conflate the two: passing an id where a type belongs yields an EMPTY menu.
// Order here IS nav order: Reference, Tools, Drills, More. The site navigates
// by OBJECT TYPE + VERB (you read a reference, you feed a tool input, you
// practice a drill) rather than by domain — domain is a multi-valued tag
// (see DOMAINS in consts.ts), never a menu.
const dropdowns = [
  { id: 'reference', label: 'Reference', groups: groupsFor('reference') },
  { id: 'tools', label: 'Tools', groups: groupsFor('tool') },
  { id: 'drills', label: 'Drills', groups: groupsFor('drill') },
  { id: 'more', label: 'More', groups: [{ category: undefined, links: MORE_LINKS }] },
] as const;
// Each real-link dropdown's own landing page (Reference/Tools/Drills all have
// one; "More" doesn't, so it stays a button rather than a link — see the
// trigger markup below).
const LANDING_HREF: Partial<Record<(typeof dropdowns)[number]['id'], string>> = {
  reference: '/reference/',
  tools: '/tools/',
  drills: '/drills/',
};
// Every explicit link href across all four dropdowns, mapped to whichever
// dropdown owns it. This is NOT a legacy safeguard — under the type+verb
// taxonomy it is load-bearing on 19 of the site's own pages, MORE so than
// under the old domain menus it was written for.
//
// The rule: an exact match on a specific page always outranks another link's
// looser hub prefix. It exists because one entry's href can legitimately be
// the URL prefix of a completely different entry's, and a bare
// `.some(isActive)` would then light up both triggers at once.
//
// The live case today: "Tool Catalog" (/reference/tool-catalog/) is a REFERENCE entry —
// you read it — and its loose prefix match is deliberate, so its dynamically
// generated catalog-entry detail pages (e.g. /reference/tool-catalog/volatility-3/, which
// isn't individually listed anywhere) still highlight Reference. But 19
// interactive TOOLS (e.g. /tools/hash-calculator/) live under that same
// /reference/tool-catalog/* prefix while being explicitly, individually owned by the Tools
// dropdown. Each of those satisfies both Reference's loose prefix and Tools'
// own exact entry; without the tie-break below, every one of them would
// underline Reference AND Tools simultaneously. Verified: a bare
// `.some(isActive)` double-highlights exactly those 19 routes.
//
// (The original bug was the same shape across the old DFIR/IT menus, before
// each moved under its own /dfir//it/ prefix. Splitting by domain fixed that
// instance; splitting by type+verb reintroduced the shape, because "the
// catalog of tools" and "the tools themselves" are now different object types
// sharing one URL subtree. The move onto /reference/ and /tools/ URLs did not
// retire the tie-break either — it separated the two subtrees, so there are
// currently zero entry-href prefix collisions, but the same shape of bug has
// recurred under two different URL schemes already.)
const hrefOwner = new Map<string, (typeof dropdowns)[number]['id']>();
for (const d of dropdowns) {
  for (const g of d.groups) {
    for (const link of g.links) {
      if (!hrefOwner.has(link.href)) hrefOwner.set(link.href, d.id);
    }
  }
}
const isLinkActive = (href: string, ownerId: (typeof dropdowns)[number]['id']) => {
  if (pathname === href) return true;
  if (!isActive(href)) return false;
  const exactOwner = hrefOwner.get(pathname);
  return exactOwner === undefined || exactOwner === ownerId;
};
const isAnyActive = (ownerId: (typeof dropdowns)[number]['id'], groups: readonly { links: readonly { href: string }[] }[]) =>
  groups.some((g) => g.links.some((l) => isLinkActive(l.href, ownerId)));
// A dropdown's own landing page isn't inside its links (it's the page those
// links point AT), so isAnyActive alone would leave the trigger looking
// unselected while actually on that page.
const isDropdownActive = (d: (typeof dropdowns)[number]) => {
  const landing = LANDING_HREF[d.id];
  return isAnyActive(d.id, d.groups) || (landing !== undefined && isActive(landing));
};

// Desktop nav "More" dropdown (mirrors the footer's More column). Opens on
// hover/focus via CSS (the `.nav-more` ancestor) only — no click-to-pin.
// `h: '64px'` matches <nav>'s own fixed height on purpose: this LI is
// `position: relative`, so `moreMenuOuter`'s `top: 100%` below measures
// against THIS element's own height, not the nav's — and without an
// explicit height, the LI just shrink-wraps to its "More ⌄" text (~24px),
// centered within the 64px nav by the parent <ul>'s `align-items: center`.
// That made `top: 100%` land partway up the nav bar rather than at its
// bottom edge, sitting visibly closer to the nav than the mega-menu panels
// (which aren't `position: relative` — see `linkTriggerWrap` below — so
// THEIR `top: 100%` falls through to <nav> itself, i.e. the real 64px).
// Forcing this LI to be genuinely 64px tall (rather than switching it to the
// same resolve-through-to-<nav> trick they use) keeps `right: 0` anchored to
// this trigger's own edge — doing what `linkTriggerWrap` does here would recenter
// `right: 0` on the whole nav's right edge instead, well past this trigger,
// since More sits before the search/sound/theme/mode controls, not at the
// nav's own right edge. The forced height cascades the same 64px up through
// the auto-height `<ul>`/right-side `<div>` ancestors (a flex container
// always grows to fit its tallest item), which doesn't visibly move Blog/
// Labs/About or the other nav controls — they're still centered on the
// exact same nav-center line either way, just via one 64px box instead of
// several stacked auto-sized ones.
const moreWrap = css({ position: 'relative', display: 'flex', alignItems: 'center', h: '64px' });
// The Reference/Tools/Drills trigger LIs are deliberately NOT `position:
// relative` — their mega-menu panels (menuPanelOuter/menuPanelOuterWide/
// drillsMenuOuter below) need to be centered under the whole nav bar, not
// hugging the narrow "Reference ⌄" trigger, so the containing block is
// left to resolve up to `<nav>` itself (which IS position:relative — see the
// <nav> element below) instead of stopping at this LI. `h: '64px'` here is a
// SEPARATE fix from that containing-block trick, for a separate bug: without
// it, this LI's own rendered box is just its "Reference ⌄" text's natural
// height (~24px), centered within the 64px nav — but the panel (a
// sibling, positioned via the nav) starts at the nav's true bottom edge
// (64px down). That left a real gap in HOVERABLE area between this LI's own
// bottom edge and the panel's top edge — not the visible `navMenuGap`
// spacing, an actual dead zone with no `.nav-more` descendant in it at all —
// so a mouse moving from the trigger down to the panel crossed a point
// where `:hover` genuinely stopped matching, closing the panel, which then
// reopened the moment the mouse reached the panel a frame later: a flicker.
// Forcing this LI to the same 64px `moreWrap` already uses (matching
// <nav>'s own height) closes that gap without touching `navMenuGap` at all
// — the LI's hoverable area now runs continuously from y=0 to y=64px,
// exactly where the panel's own hoverable area picks up.
const linkTriggerWrap = css({ display: 'flex', alignItems: 'center', h: '64px' });
const moreBtn = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.2rem',
  fontFamily: 'inherit',
  fontSize: '0.95rem',
  fontWeight: 500,
  color: 'textMuted',
  bg: 'transparent',
  border: 'none',
  p: 0,
  cursor: 'pointer',
  borderBottom: '2px solid transparent',
  pb: '2px',
  transition: 'color 200ms ease',
  _hover: { color: 'text' },
  '& .nav-more-chev': { transition: 'transform 200ms ease' },
});
const moreBtnActive = css({ color: 'primary', borderBottomColor: 'primary' });
const moreMenuOuter = css({
  position: 'absolute',
  top: '100%',
  // Centered under the "More ⌄" trigger itself (moreWrap stays `position:
  // relative`, so this resolves against that trigger LI, not <nav>) — used
  // to be `right: 0`, which flush-aligned the panel's right edge to the
  // trigger's own right edge instead, leaving it hanging off to the left
  // and visibly off-center under the button, unlike the mega-menus (which
  // ARE centered, just under the whole nav bar — see menuPanelOuter's own
  // comment, a different technique for a much wider, fixed-size panel).
  left: '50%',
  pt: navMenuGap, // transparent hover-bridge so the menu stays open between button and panel
  zIndex: 60,
  // Reference/Tools/Drills/More are four separate .nav-more groups whose
  // panels (the first three centered under the whole nav, More's own
  // min-width ~210px) genuinely overlap in screen space at typical nav
  // widths. Every panel shares this same base z-index, so with
  // no further rule, plain DOM order decides the tie — the later-in-markup
  // dropdown (More) always paints on top of the earlier ones (Reference,
  // Tools, Drills), regardless of which one you're actually interacting
  // with. That means moving the pointer from More back to Reference hid
  // Reference's entire opening slide behind More's still-fading-out panel — "only one slide
  // visible at a time," and always the wrong one when going in that
  // direction. Fix: whichever dropdown is currently open/opening (hovered or
  // focus-within) always wins the stacking order over its sibling, so the
  // one you're looking at is always the one you see animate.
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const moreMenuInner = css({
  minW: '210px',
  // Horizontal centering lives here, on the INNER panel, not on
  // moreMenuOuter (which carries the `.nav-more-menu` class and already
  // owns `transform: translateY()` for the open/close slide in global.css —
  // a second `transform` on that same element would silently clobber it,
  // per menuPanelOuter's own comment on the identical hazard). This element
  // has no transform of its own, so `translateX(-50%)` here is free, and —
  // unlike the mega-menus' fixed `w` + `left: calc(50% - w/2)` math — it centers
  // correctly against this panel's real auto/min-width content without
  // needing to hardcode a pixel width up front.
  transform: 'translateX(-50%)',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '0.4rem',
  display: 'flex',
  flexDirection: 'column',
  gap: '0.15rem',
});

// Shared mega-menu panel — one grid CELL per CATEGORY (a category header plus
// its own sub-list of links). Used by Reference (3 categories / 16 links) at
// the standard 600px width below, and by Tools (4 categories / 25 links) via
// the wider variant after it. Centered under the WHOLE nav, not the narrow
// "Reference ⌄" trigger: fixed width + a matching fixed
// `left: calc(50% - width/2)` rather than the more obvious
// `left: 50%; transform: translateX(-50%)` — `.nav-more-menu` in
// global.css already owns `transform: translateY(...)` for the open/close
// slide, and a second `transform` here would silently clobber it (only one
// `transform` declaration on an element ever wins, they don't merge). Do not
// "simplify" this back to a translate; it is a real, previously-shipped bug.
// Fixed pixel math is safe specifically because these dropdowns only ever
// render at the `md` breakpoint and up (768px, this whole `<ul>` is `md:flex`)
// and the nav's own `maxW` is 960px — both 600px and the 720px variant
// comfortably fit with margin at every width in that whole range, so there's
// no responsive case to account for.
const menuPanelOuter = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 300px)',
  w: '600px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
// Tools' own wider panel — Tools has 4 categories to Reference's 3, so it
// needs a 4th column, and squeezing that into the 600px above would leave
// ~124px per column (600 − 32px padding − 3×24px gap, ÷ 4), well under the
// 3-column layout's own ~173px. 720px is the widest that still clears the
// nav's own 960px `maxW` with real margin, and — paired with the tighter
// 1rem column gap in menuGridCols4 below — gives ~160px per column, close
// enough to Reference's ~173px that the wrap behavior is unchanged for every
// current label (the handful long enough to wrap at 173px, e.g. "Data Size &
// Storage Unit Converter", already wrapped to two lines there and still wrap
// to two here; nothing that fit on one line stops fitting). Same fixed
// `left: calc(50% - width/2)` math as above, for exactly the same reason
// (never a second `transform`).
const menuPanelOuterWide = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 360px)',
  w: '720px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const menuPanelInner = css({
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '1rem',
  // Safety net, not an expected case: every category fits on a single grid
  // row today (3-of-3 for Reference, 4-of-4 for Tools), and the tallest
  // column is 8 links — comfortably under this even on the shortest
  // realistic viewport. Kept anyway so a future extra category degrades to a
  // scrollbar instead of quietly pushing past the viewport bottom again.
  maxH: '75vh',
  overflowY: 'auto',
});
const menuGridCols3 = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(3, 1fr)',
  gap: '0.5rem 1.5rem',
  mt: '0.75rem',
});
// Column gap tightened from menuGridCols3's 1.5rem to 1rem — with a 4th
// column to fit, every 8px of gutter comes straight out of label width (see
// menuPanelOuterWide's own arithmetic). Row gap stays matched to the 3-column
// grid so the two panels read as the same system.
const menuGridCols4 = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(4, 1fr)',
  gap: '0.5rem 1rem',
  mt: '0.75rem',
});
// Drills' own dropdown — same "real link + centered-under-whole-nav"
// treatment as the two mega-menus above (see menuPanelOuter's own comment for
// the technique), but sized for 7 FLAT links rather than a grid of
// categories: `menuGridCols3`/`menuGridCols4` lay out one grid CELL per
// CATEGORY (`d.groups.map`, each cell a header + sub-list), which only works
// because Reference and Tools have exactly 3 and 4 of them to fill their own
// row. Drills is a single category ('Drills' — the only CategoryId of type
// 'drill'), so reusing either grid as-is would render a single lonely column
// with the rest of a 600px panel sitting empty. Instead this maps that one
// group's links directly — one grid cell per LINK, not per group — in a
// narrower 2-column panel, and skips the redundant category header (the
// trigger already says "Drills").
const drillsMenuOuter = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 220px)',
  w: '440px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const drillsMenuInner = css({
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '1rem',
});
const drillsGrid = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(2, 1fr)',
  gap: '0.15rem 1rem',
  mt: '0.75rem',
});
const menuCatLabel = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.1em',
  color: 'primary',
  px: '0.5rem',
  pb: '0.3rem',
});
// Unlike `moreLink` (a flat single-column list with room to spare), a 600px
// panel split 3 ways leaves ~170px per column (and the 720px Tools panel
// ~180px split 4 ways) — plenty for most labels, but a couple of the longer
// ones ("MITRE ATT&CK Coverage Map", "ASCII Table & Character Encoding
// Reference") wrap to two lines rather than overflow their column, so no
// `whiteSpace: nowrap` here.
const menuGridLink = css({
  display: 'block',
  px: '0.5rem',
  py: '0.35rem',
  fontSize: '0.85rem',
  lineHeight: 1.3,
  color: 'textMuted',
  borderRadius: 'md',
  transition: 'color 150ms ease, background 150ms ease',
  _hover: { color: 'primary', bg: 'bgSubtle' },
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const menuGroup = css({ listStyle: 'none', m: 0, p: 0 });
const menuGroupLabel = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.1em',
  color: 'primary',
  px: '0.65rem',
  pt: '0.5rem',
  pb: '0.2rem',
  '& + ul': { mt: 0 },
});
const menuGroupDivider = css({ borderTop: '1px solid token(colors.border)', my: '0.25rem' });
const moreLink = css({
  display: 'block',
  px: '0.65rem',
  py: '0.45rem',
  fontSize: '0.9rem',
  color: 'textMuted',
  borderRadius: 'md',
  whiteSpace: 'nowrap',
  transition: 'color 150ms ease, background 150ms ease',
  _hover: { color: 'primary', bg: 'bgSubtle' },
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const mobileLink = css({
  display: 'block',
  py: '0.6rem',
  fontSize: '1rem',
  color: 'textMuted',
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const mobileLinkDivider = css({ borderTop: '1px solid token(colors.border)' });
---

<header
  class={css({
    position: 'sticky',
    top: 0,
    zIndex: 50,
    // Same dissolve recipe as the footer (Footer.astro): 55% surface + blur(5px),
    // so the background nodes and any content scrolling behind read through clearly
    // (a heavy blur smears the thin node lines into nothing). The gradient seam
    // below fades the header into the content (mirror of the footer's top seam).
    bg: 'color-mix(in srgb, token(colors.bg) 55%, transparent)',
    backdropFilter: 'blur(5px)',
    borderBottom: '1px solid token(colors.border)',
    _after: {
      content: '""',
      position: 'absolute',
      left: 0,
      right: 0,
      top: '100%',
      height: '1.25rem',
      pointerEvents: 'none',
      background: 'linear-gradient(to bottom, color-mix(in srgb, token(colors.bg) 55%, transparent), transparent)',
    },
  })}
>
  <nav
    class={css({
      position: 'relative',
      maxW: '960px',
      mx: 'auto',
      px: '1.25rem',
      h: '64px',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'space-between',
      gap: '1rem',
    })}
  >
    <a
      href="/"
      class={css({
        display: 'inline-flex',
        alignItems: 'center',
        gap: '0.45rem',
        fontFamily: 'redaction50',
        fontWeight: 700,
        fontSize: '1.25rem',
        letterSpacing: '-0.01em',
        whiteSpace: 'nowrap',
      })}
    >
      <PixelStar size={17} twinkle={false} class={css({ flexShrink: 0 })} />
      {/* Domain-based brand identity (cyberkit.win vs patricksaade.com) — see
          BaseHead.astro's own pre-paint script, which sets `data-brand="cyberkit"`
          on <html> before first paint (client-side only, so <title>/meta/OG stay
          Patrick-branded regardless of domain — a deliberate tradeoff, see
          CLAUDE.md). Both brand's markup always renders server-side; a single-
          level `[data-brand="cyberkit"] &` selector toggles which is visible —
          never nested with another self-selector (that's the exact Panda
          gotcha this codebase already hit once with the switch-thumb bug). */}
      <span class={css({ display: { base: 'inline', sm: 'none' }, '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.brandShort}</span>
      <span class={css({ display: { base: 'none', sm: 'inline' }, '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.brand}</span>
      <span class={css({ display: 'none', '[data-brand="cyberkit"] &': { display: 'inline' } })}>CyberKit</span>
    </a>

    <div
      class={css({
        display: 'flex',
        alignItems: 'center',
        gap: { base: '0.5rem', md: '1.5rem' },
      })}
    >
      <ul
        class={css({
          display: { base: 'none', md: 'flex' },
          alignItems: 'center',
          gap: '1.5rem',
          listStyle: 'none',
          m: 0,
          p: 0,
        })}
      >
        {/* NAV_LINKS is exactly Blog/Labs/About — the three personal-content
            pages redirected away by vercel.json on cyberkit.win (see that
            file's own comment) — so the whole list hides together on that
            domain rather than needing per-item filtering. A visitor who
            somehow lands on one of those URLs anyway still gets redirected
            at the edge; this just keeps a dead-end link out of the nav. */}
        {
          NAV_LINKS.map((link) => (
            <li class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={css({
                  // `inline-flex` + `alignItems: 'center'` (not left as plain
                  // inline text) so this matches moreBtn's own box model
                  // below: a plain inline <a>'s rect is sized to its glyph
                  // ink-box (font ascent/descent), while an inline-flex
                  // container's rect is sized to the full line-height box —
                  // two different heights for the same font-size/line-height,
                  // which threw off the shared `align-items: center` on the
                  // parent <ul> and made Blog/Labs/About sit visibly lower
                  // than the DFIR/More triggers. Matching box models here is
                  // what actually fixes it, not a manual offset nudge.
                  display: 'inline-flex',
                  alignItems: 'center',
                  fontSize: '0.95rem',
                  color: 'textMuted',
                  fontWeight: 500,
                  transition: 'color 200ms ease',
                  borderBottom: '2px solid transparent',
                  pb: '2px',
                  _hover: { color: 'text' },
                  '&[aria-current=page]': {
                    color: 'primary',
                    borderBottomColor: 'primary',
                  },
                })}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        {dropdowns.map((d) => (
          <li class={`nav-more ${d.id === 'more' ? moreWrap : linkTriggerWrap}`}>
            {d.id === 'more' ? (
              <button
                type="button"
                id={`nav-${d.id}-btn`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={`nav-${d.id}-menu`}
                aria-label={`${d.label} links`}
                title={`${d.label} links`}
                data-sound="tick"
                class={`nav-more-btn ${moreBtn} ${isDropdownActive(d) ? moreBtnActive : ''}`}
              >
                {d.label}
                <Icon name="chevron-down" size={13} strokeWidth={2.5} class="nav-more-chev" />
              </button>
            ) : (
              // Reference, Tools and Drills, desktop only (this whole <ul> is
              // md:flex — see its own class above): a real link, not a button.
              // Hovering it still previews the dropdown below (CSS
              // :hover/:focus-within on the shared .nav-more ancestor,
              // untouched by the tag change), but a click navigates straight
              // to the section's own landing page instead of just toggling a
              // menu — this trigger IS that landing page, so clicking its own
              // label should go there, mirroring how a mega-menu trigger link
              // behaves on other sites. The mobile list below renders the same
              // three as plain flat links to the same landing pages (no
              // accordion, no hover preview) — a separate markup block
              // entirely.
              <a
                href={LANDING_HREF[d.id]}
                id={`nav-${d.id}-btn`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={`nav-${d.id}-menu`}
                aria-current={pathname === LANDING_HREF[d.id] ? 'page' : undefined}
                data-sound="tick"
                class={`nav-more-btn ${moreBtn} ${isDropdownActive(d) ? moreBtnActive : ''}`}
              >
                {d.label}
                <Icon name="chevron-down" size={13} strokeWidth={2.5} class="nav-more-chev" />
              </a>
            )}
            {d.id === 'reference' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${menuPanelOuter}`}>
                <div class={menuPanelInner}>
                  <a href={LANDING_HREF[d.id]} aria-current={pathname === LANDING_HREF[d.id] ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all Reference pages →
                  </a>
                  <div class={menuGroupDivider} />
                  <div class={menuGridCols3}>
                    {d.groups.map((g) => (
                      <div>
                        {g.category && <p class={`nav-declassify ${menuCatLabel}`}>{g.category}</p>}
                        <ul class={menuGroup} aria-label={g.category ?? d.label}>
                          {g.links.map((link) => (
                            <li>
                              <a href={link.href} aria-current={isLinkActive(link.href, d.id) ? 'page' : undefined} class={`nav-declassify ${menuGridLink}`}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : d.id === 'tools' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${menuPanelOuterWide}`}>
                <div class={menuPanelInner}>
                  <a href={LANDING_HREF[d.id]} aria-current={pathname === LANDING_HREF[d.id] ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all Tools →
                  </a>
                  <div class={menuGroupDivider} />
                  <div class={menuGridCols4}>
                    {d.groups.map((g) => (
                      <div>
                        {g.category && <p class={`nav-declassify ${menuCatLabel}`}>{g.category}</p>}
                        <ul class={menuGroup} aria-label={g.category ?? d.label}>
                          {g.links.map((link) => (
                            <li>
                              <a href={link.href} aria-current={isLinkActive(link.href, d.id) ? 'page' : undefined} class={`nav-declassify ${menuGridLink}`}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : d.id === 'drills' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${drillsMenuOuter}`}>
                <div class={drillsMenuInner}>
                  <a href={LANDING_HREF[d.id]} aria-current={pathname === LANDING_HREF[d.id] ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all Drills →
                  </a>
                  <div class={menuGroupDivider} />
                  {/* Flattened deliberately — Drills is one category, so this
                      renders one cell per LINK rather than one per group (see
                      drillsMenuOuter's own comment). flatMap over `d.groups`
                      rather than indexing [0] so the panel still renders every
                      link if a second drill category is ever added. The grid
                      lives on the <ul> itself so the links keep list semantics
                      (the other panels get theirs from their per-category
                      <ul>s); the group name comes from the trigger, since this
                      panel deliberately renders no category header. */}
                  <ul class={`${menuGroup} ${drillsGrid}`} aria-label={d.label}>
                    {d.groups.flatMap((g) => g.links).map((link) => (
                      <li>
                        <a href={link.href} aria-current={isLinkActive(link.href, d.id) ? 'page' : undefined} class={`nav-declassify ${menuGridLink}`}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${moreMenuOuter}`}>
                <div class={moreMenuInner}>
                  {d.groups.map((g, i) => (
                    <>
                      {i > 0 && <div class={menuGroupDivider} />}
                      {g.category && <p class={`nav-declassify ${menuGroupLabel}`}>{g.category}</p>}
                      <ul class={menuGroup} aria-label={g.category ?? d.label}>
                        {g.links.map((link) => (
                          <li class={PERSONAL_HREFS.includes(link.href) ? hideOnCyberkit : undefined}>
                            <a href={link.href} aria-current={isLinkActive(link.href, d.id) ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>

    {/* Utility-control cluster: search, sound, palette, light/dark. These are
        site controls rather than destinations, so they're grouped tightly
        (0.4rem) and separated from the nav links by the row's own 24px gap —
        previously all four sat at that same 24px spacing, which read as four
        more nav items rather than one control group. All four are 34px tall
        with the same border/radius/fill; the palette and mode controls used to
        be 38px and 38.4px, so the row was visibly misaligned. */}
    <div
      class={css({
        display: 'flex',
        alignItems: 'center',
        gap: '0.4rem',
      })}
    >
      <button
        type="button"
        data-search-trigger
        aria-label="Search"
        title="Search (⌘K)"
        class={css({
          display: { base: 'none', md: 'inline-flex' },
          alignItems: 'center',
          gap: '0.45rem',
          h: '34px',
          pl: '0.6rem',
          pr: '0.4rem',
          borderRadius: 'md',
          border: '1px solid token(colors.border)',
          bg: 'bgSubtle',
          color: 'textMuted',
          cursor: 'pointer',
          transition: 'all 150ms ease',
          _hover: { color: 'text', borderColor: 'primary', transform: 'translateY(-1px)' },
        })}
      >
        <Icon name="search" size={15} />
        <kbd
          data-cmdk-hint
          aria-hidden="true"
          class={css({
            fontFamily: 'mono',
            fontSize: '0.68rem',
            lineHeight: 1,
            color: 'textMuted',
            bg: 'bgCard',
            border: '1px solid token(colors.border)',
            borderRadius: 'sm',
            px: '0.3rem',
            py: '0.18rem',
          })}
        >⌘K</kbd>
      </button>

      <SoundToggle />

      <ThemePicker />

      {/* Standalone light/dark/system switch — furthest-right control */}
      <ModeToggle />
    </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        title="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class={css({
          display: { base: 'inline-flex', md: 'none' },
          alignItems: 'center',
          justifyContent: 'center',
          w: '38px',
          h: '38px',
          borderRadius: 'md',
          border: '1px solid token(colors.border)',
          bg: 'transparent',
          color: 'text',
          cursor: 'pointer',
        })}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <ul
    id="mobile-menu"
    hidden
    class={css({
      display: { base: 'flex', md: 'none' },
      flexDirection: 'column',
      gap: '0.25rem',
      listStyle: 'none',
      m: 0,
      px: '1.25rem',
      py: '0.75rem',
      borderTop: '1px solid token(colors.border)',
      bg: 'bg',
    })}
  >
    <li>
      <button
        type="button"
        data-search-trigger
        class={css({
          display: 'flex',
          alignItems: 'center',
          gap: '0.5rem',
          w: '100%',
          py: '0.6rem',
          fontSize: '1rem',
          color: 'textMuted',
          bg: 'transparent',
          border: 'none',
          cursor: 'pointer',
          textAlign: 'left',
          _hover: { color: 'primary' },
        })}
      >
        <Icon name="search" size={16} /> Search
      </button>
    </li>
    {
      NAV_LINKS.map((link) => (
        <li class={hideOnCyberkit}>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={mobileLink}>
            {link.label}
          </a>
        </li>
      ))
    }
    {/* Reference / Tools / Drills — flat links straight to each section's own
        landing page, no accordion: saves vertical space on mobile (desktop
        keeps its own hover mega-menus above, unaffected). This link already is
        what each panel's "Browse all X →" link points at, so there's nothing to
        duplicate underneath it. Fully data-driven off `dropdowns` + LANDING_HREF
        — the type+verb rename needed no structural change here. */}
    {
      dropdowns
        .filter((d) => d.id !== 'more')
        .map((d, i) => (
          <li class={i === 0 ? mobileLinkDivider : undefined}>
            <a
              href={LANDING_HREF[d.id]}
              aria-current={pathname === LANDING_HREF[d.id] ? 'page' : undefined}
              class={mobileLink}
            >
              {d.label}
            </a>
          </li>
        ))
    }
    {/* More (Certifications/Privacy/Colophon) — same flat treatment, no
        grouping label needed for 3 items. */}
    {
      MORE_LINKS.map((link, i) => (
        <li class={`${i === 0 ? mobileLinkDivider : ''} ${PERSONAL_HREFS.includes(link.href) ? hideOnCyberkit : ''}`}>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={mobileLink}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  // @ts-nocheck — vanilla DOM client script
  (function () {
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    // Dismiss on outside click / Escape, mirroring ThemePicker. Listeners are
    // attached only while open (capture phase, so the toggle's own click that
    // opened it doesn't immediately re-close it) and removed on close.
    function onDocClick(e) {
      if (!menu.contains(e.target) && !toggle.contains(e.target)) close();
    }
    function onKey(e) {
      if (e.key === 'Escape') { close(); toggle.focus(); }
    }
    function open() {
      menu.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.addEventListener('click', onDocClick, true);
      document.addEventListener('keydown', onKey);
    }
    function close() {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', onDocClick, true);
      document.removeEventListener('keydown', onKey);
    }
    toggle.addEventListener('click', function () {
      if (menu.hasAttribute('hidden')) open();
      else close();
    });

    // Desktop dropdowns (Reference / Tools / Drills / More): open purely via
    // CSS :hover/:focus-within (see global.css's `.nav-more-menu` rule) — no
    // click-to-pin. A previous version toggled a `data-open` attribute on
    // click so the panel stayed open until a second click or an outside click
    // dismissed it; that read as the menu getting stuck open (move the pointer
    // away and it's still there), so it's gone. The Reference/Tools/Drills
    // triggers are real links (see the markup above) and just navigate on
    // click, no JS needed. This loop is generic over every `.nav-more` group
    // on the page and reads each group's own `.nav-more-btn` (the <a> or the
    // <button>, either way), so the number and naming of the dropdowns is
    // irrelevant to it. Two things
    // still need script, since CSS alone can't do them: keeping
    // `aria-expanded` accurate for screen readers (it has to track the same
    // hover/focus-within condition the CSS reveal already uses — there's no
    // way to bind an ARIA attribute to a CSS pseudo-class), and letting
    // Escape close an open menu for keyboard users (moving focus away is the
    // only thing that stops :focus-within from matching, and Escape has no
    // native "unfocus everything" behavior).
    var groups = Array.prototype.slice.call(document.querySelectorAll('.nav-more'));
    groups.forEach(function (group) {
      var btn = group.querySelector('.nav-more-btn');
      if (!btn) return;
      function syncExpanded() {
        btn.setAttribute('aria-expanded', String(group.matches(':hover') || group.matches(':focus-within')));
      }
      group.addEventListener('mouseenter', syncExpanded);
      group.addEventListener('mouseleave', syncExpanded);
      group.addEventListener('focusin', syncExpanded);
      group.addEventListener('focusout', syncExpanded);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var active = document.activeElement;
      if (active && groups.some(function (g) { return g.contains(active); })) active.blur();
    });
  })();
</script>
