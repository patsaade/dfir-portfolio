---
// Sticky top nav — brand, links, theme picker, mode toggle, mobile menu.
import { css } from 'styled-system/css';
import { NAV_LINKS, DFIR_GROUPS, IT_GROUPS, DRILLS_LINKS, MORE_LINKS, SITE } from '../consts';
import ThemePicker from './ThemePicker.astro';
import ModeToggle from './ModeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import PixelStar from './PixelStar.astro';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
// Two dropdowns — desktop menus, mobile collapsible <details>. Each is a list
// of categories (a category's `label` renders as a small header inside the
// menu; "More" has just one, unlabeled category so it stays a flat list).
// Single source of truth for the gap between the nav and BOTH dropdown
// panels (moreMenuOuter/dfirMenuOuter's own `pt` below) — a literal value
// duplicated in two places is exactly how they drifted out of sync before
// (see moreWrap's own comment for that history); one constant means they
// physically can't diverge again. Tightened from an earlier 0.6rem, which
// read as too much distance once both dropdowns actually shared it.
const navMenuGap = '0.3rem';
// Order here IS nav order: DFIR, IT, Drills, More.
const dropdowns = [
  { id: 'dfir', label: 'DFIR', groups: DFIR_GROUPS },
  { id: 'it', label: 'IT', groups: IT_GROUPS },
  { id: 'drills', label: 'Drills', groups: [{ category: undefined, links: DRILLS_LINKS }] },
  { id: 'more', label: 'More', groups: [{ category: undefined, links: MORE_LINKS }] },
] as const;
// Each real-link dropdown's own landing page (DFIR/IT/Drills all have one;
// "More" doesn't, so it stays a button rather than a link — see the trigger
// markup below).
const LANDING_HREF: Partial<Record<(typeof dropdowns)[number]['id'], string>> = {
  dfir: '/dfir/',
  it: '/it/',
  drills: '/drills/',
};
// Every explicit link href across all four dropdowns, mapped to whichever
// dropdown owns it. Needed because DFIR's "Tool Catalog" entry links to the
// bare hub page "/tools/" — a prefix match meant to catch its own dynamically
// generated catalog-entry detail pages (e.g. "/tools/volatility-3/", which
// isn't individually listed anywhere) — but several IT_GROUPS tool pages
// (e.g. "/tools/cidr-calculator/") live under that same "/tools/*" URL
// prefix while being explicitly, individually owned by IT instead. Without a
// tie-break, viewing an IT tool page satisfied both DFIR's loose "/tools/"
// prefix AND IT's own exact entry, underlining both nav triggers at once. An
// exact match on a specific page is always more specific than another
// section's looser hub prefix, so exact ownership wins outright.
const hrefOwner = new Map<string, (typeof dropdowns)[number]['id']>();
for (const d of dropdowns) {
  for (const g of d.groups) {
    for (const link of g.links) {
      if (!hrefOwner.has(link.href)) hrefOwner.set(link.href, d.id);
    }
  }
}
const isLinkActive = (href: string, ownerId: (typeof dropdowns)[number]['id']) => {
  if (pathname === href) return true;
  if (!isActive(href)) return false;
  const exactOwner = hrefOwner.get(pathname);
  return exactOwner === undefined || exactOwner === ownerId;
};
const isAnyActive = (ownerId: (typeof dropdowns)[number]['id'], groups: readonly { links: readonly { href: string }[] }[]) =>
  groups.some((g) => g.links.some((l) => isLinkActive(l.href, ownerId)));
// A dropdown's own landing page isn't inside its links (it's the page those
// links point AT), so isAnyActive alone would leave the trigger looking
// unselected while actually on that page.
const isDropdownActive = (d: (typeof dropdowns)[number]) => {
  const landing = LANDING_HREF[d.id];
  return isAnyActive(d.id, d.groups) || (landing !== undefined && isActive(landing));
};

// Desktop nav "More" dropdown (mirrors the footer's More column). Opens on
// hover/focus via CSS (the `.nav-more` ancestor) and on click/tap via JS.
// `h: '64px'` matches <nav>'s own fixed height on purpose: this LI is
// `position: relative`, so `moreMenuOuter`'s `top: 100%` below measures
// against THIS element's own height, not the nav's — and without an
// explicit height, the LI just shrink-wraps to its "More ⌄" text (~24px),
// centered within the 64px nav by the parent <ul>'s `align-items: center`.
// That made `top: 100%` land partway up the nav bar rather than at its
// bottom edge, sitting visibly closer to the nav than DFIR's panel (which
// isn't `position: relative` — see `dfirWrap` below — so ITS `top: 100%`
// falls through to <nav> itself, i.e. the real 64px). Forcing this LI to be
// genuinely 64px tall (rather than switching it to the same
// resolve-through-to-<nav> trick DFIR uses) keeps `right: 0` anchored to
// this trigger's own edge — doing what `dfirWrap` does here would recenter
// `right: 0` on the whole nav's right edge instead, well past this trigger,
// since More sits before the search/sound/theme/mode controls, not at the
// nav's own right edge. The forced height cascades the same 64px up through
// the auto-height `<ul>`/right-side `<div>` ancestors (a flex container
// always grows to fit its tallest item), which doesn't visibly move Blog/
// Labs/About or the other nav controls — they're still centered on the
// exact same nav-center line either way, just via one 64px box instead of
// several stacked auto-sized ones.
const moreWrap = css({ position: 'relative', display: 'flex', alignItems: 'center', h: '64px' });
// DFIR's own trigger LI is deliberately NOT `position: relative` — its mega-
// menu panel (dfirMenuOuter below) needs to be centered under the whole nav
// bar, not hugging this narrow "DFIR ⌄" trigger, so its containing block is
// left to resolve up to `<nav>` itself (which IS position:relative — see the
// <nav> element below) instead of stopping at this LI. `h: '64px'` here is a
// SEPARATE fix from that containing-block trick, for a separate bug: without
// it, this LI's own rendered box is just its "DFIR ⌄" text's natural height
// (~24px), centered within the 64px nav — but dfirMenuOuter's panel (a
// sibling, positioned via the nav) starts at the nav's true bottom edge
// (64px down). That left a real gap in HOVERABLE area between this LI's own
// bottom edge and the panel's top edge — not the visible `navMenuGap`
// spacing, an actual dead zone with no `.nav-more` descendant in it at all —
// so a mouse moving from the trigger down to the panel crossed a point
// where `:hover` genuinely stopped matching, closing the panel, which then
// reopened the moment the mouse reached the panel a frame later: a flicker.
// Forcing this LI to the same 64px `moreWrap` already uses (matching
// <nav>'s own height) closes that gap without touching `navMenuGap` at all
// — the LI's hoverable area now runs continuously from y=0 to y=64px,
// exactly where the panel's own hoverable area picks up.
const dfirWrap = css({ display: 'flex', alignItems: 'center', h: '64px' });
const moreBtn = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.2rem',
  fontFamily: 'inherit',
  fontSize: '0.95rem',
  fontWeight: 500,
  color: 'textMuted',
  bg: 'transparent',
  border: 'none',
  p: 0,
  cursor: 'pointer',
  borderBottom: '2px solid transparent',
  pb: '2px',
  transition: 'color 200ms ease',
  _hover: { color: 'text' },
  '& .nav-more-chev': { transition: 'transform 200ms ease' },
});
const moreBtnActive = css({ color: 'primary', borderBottomColor: 'primary' });
const moreMenuOuter = css({
  position: 'absolute',
  top: '100%',
  // Centered under the "More ⌄" trigger itself (moreWrap stays `position:
  // relative`, so this resolves against that trigger LI, not <nav>) — used
  // to be `right: 0`, which flush-aligned the panel's right edge to the
  // trigger's own right edge instead, leaving it hanging off to the left
  // and visibly off-center under the button, unlike DFIR's mega-menu (which
  // IS centered, just under the whole nav bar — see dfirMenuOuter's own
  // comment, a different technique for a much wider, fixed-size panel).
  left: '50%',
  pt: navMenuGap, // transparent hover-bridge so the menu stays open between button and panel
  zIndex: 60,
  // DFIR and More are two separate .nav-more groups whose panels (each
  // min-width ~210px, right: 0) can genuinely overlap in screen space at
  // typical nav widths. Both panels share this same base z-index, so with
  // no further rule, plain DOM order decides the tie — the later-in-markup
  // dropdown (More) always paints on top of the earlier one (DFIR),
  // regardless of which one you're actually interacting with. That means
  // moving the pointer from More back to DFIR hid DFIR's entire 1500ms
  // opening slide behind More's still-fading-out panel — "only one slide
  // visible at a time," and always the wrong one when going in that
  // direction. Fix: whichever dropdown is currently open/opening (hovered or
  // focus-within) always wins the stacking order over its sibling, so the
  // one you're looking at is always the one you see animate.
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const moreMenuInner = css({
  minW: '210px',
  // Horizontal centering lives here, on the INNER panel, not on
  // moreMenuOuter (which carries the `.nav-more-menu` class and already
  // owns `transform: translateY()` for the open/close slide in global.css —
  // a second `transform` on that same element would silently clobber it,
  // per dfirMenuOuter's own comment on the identical hazard). This element
  // has no transform of its own, so `translateX(-50%)` here is free, and —
  // unlike DFIR's fixed `w` + `left: calc(50% - w/2)` math — it centers
  // correctly against this panel's real auto/min-width content without
  // needing to hardcode a pixel width up front.
  transform: 'translateX(-50%)',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '0.4rem',
  display: 'flex',
  flexDirection: 'column',
  gap: '0.15rem',
});

// DFIR's own mega-menu — a 3-column grid (17 links across 6 categories no
// longer fits any single stacked column without spilling well past the nav
// bar). Centered under the WHOLE nav, not the narrow "DFIR ⌄" trigger: fixed
// width + a matching fixed `left: calc(50% - width/2)` rather than the more
// obvious `left: 50%; transform: translateX(-50%)` — `.nav-more-menu` in
// global.css already owns `transform: translateY(...)` for the open/close
// slide, and a second `transform` here would silently clobber it (only one
// `transform` declaration on an element ever wins, they don't merge). Fixed
// pixel math is safe specifically because this dropdown only ever renders at
// the `md` breakpoint and up (768px, this whole `<ul>` is `md:flex`) and the
// nav's own `maxW` is 960px — 600px comfortably fits with margin at every
// width in that whole range, so there's no responsive case to account for.
const dfirMenuOuter = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 300px)',
  w: '600px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const dfirMenuInner = css({
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '1rem',
  // Safety net, not an expected case: 6 categories in a 3-column grid is 2
  // rows, comfortably under this even on the shortest realistic viewport —
  // kept anyway so a future 7th/8th category degrades to a scrollbar instead
  // of quietly pushing past the viewport bottom again.
  maxH: '75vh',
  overflowY: 'auto',
});
const dfirGrid = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(3, 1fr)',
  gap: '0.5rem 1.5rem',
  mt: '0.75rem',
});
// Drills' own dropdown — same "real link + centered-under-whole-nav" DFIR
// treatment (see dfirMenuOuter's own comment for the technique), but sized
// for 6 FLAT links rather than DFIR's 20-links-across-6-categories: DFIR's
// `dfirGrid` lays out one grid CELL per CATEGORY (`d.groups.map`, each cell
// a header + sub-list), which only works because DFIR always has 6 of them
// to fill a 3-column row. Drills has exactly one ungrouped group (see
// DRILLS_LINKS above), so reusing dfirGrid as-is would render a single
// lonely column with the other two thirds of a 600px panel sitting empty.
// Instead this maps DRILLS_LINKS directly — one grid cell per LINK, not per
// group — in a narrower 2-column panel sized for 6 items (3 rows) rather
// than DFIR's wider 3-column one.
const drillsMenuOuter = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 220px)',
  w: '440px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const drillsMenuInner = css({
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '1rem',
});
const drillsGrid = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(2, 1fr)',
  gap: '0.15rem 1rem',
  mt: '0.75rem',
});
// IT's own dropdown — same centered-under-whole-nav treatment as DFIR/Drills
// (see dfirMenuOuter's own comment) and now the SAME category-grid shape as
// DFIR too (IT_GROUPS moved to the same {category,id,blurb,intro,links}[]
// structure — see consts.ts), just narrower and 2 columns instead of 3 since
// IT currently has 2 categories to DFIR's 6. Reuses dfirGroupLabel/dfirLink
// for the actual category-label/link styling — only the outer panel
// dimensions and column count differ.
const itMenuOuter = css({
  position: 'absolute',
  top: '100%',
  left: 'calc(50% - 170px)',
  w: '340px',
  pt: navMenuGap,
  zIndex: 60,
  '.nav-more:hover &': { zIndex: 70 },
  '.nav-more:focus-within &': { zIndex: 70 },
});
const itMenuInner = css({
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'lg',
  boxShadow: 'cardHover',
  p: '1rem',
});
const itGrid = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(2, 1fr)',
  gap: '0.5rem 1rem',
  mt: '0.75rem',
});
const dfirGroupLabel = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.1em',
  color: 'primary',
  px: '0.5rem',
  pb: '0.3rem',
});
// Unlike `moreLink` (a flat single-column list with room to spare), a 600px
// panel split 3 ways leaves ~170px per column — plenty for most labels, but
// a couple of the longer ones ("MITRE ATT&CK Coverage Map") wrap to two
// lines rather than overflow their column, so no `whiteSpace: nowrap` here.
const dfirLink = css({
  display: 'block',
  px: '0.5rem',
  py: '0.35rem',
  fontSize: '0.85rem',
  lineHeight: 1.3,
  color: 'textMuted',
  borderRadius: 'md',
  transition: 'color 150ms ease, background 150ms ease',
  _hover: { color: 'primary', bg: 'bgSubtle' },
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const menuGroup = css({ listStyle: 'none', m: 0, p: 0 });
const menuGroupLabel = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.1em',
  color: 'primary',
  px: '0.65rem',
  pt: '0.5rem',
  pb: '0.2rem',
  '& + ul': { mt: 0 },
});
const menuGroupDivider = css({ borderTop: '1px solid token(colors.border)', my: '0.25rem' });
const moreLink = css({
  display: 'block',
  px: '0.65rem',
  py: '0.45rem',
  fontSize: '0.9rem',
  color: 'textMuted',
  borderRadius: 'md',
  whiteSpace: 'nowrap',
  transition: 'color 150ms ease, background 150ms ease',
  _hover: { color: 'primary', bg: 'bgSubtle' },
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const mobileLink = css({
  display: 'block',
  py: '0.6rem',
  fontSize: '1rem',
  color: 'textMuted',
  '&[aria-current=page]': { color: 'primary', fontWeight: 600 },
});
const mobileLinkDivider = css({ borderTop: '1px solid token(colors.border)' });
---

<header
  class={css({
    position: 'sticky',
    top: 0,
    zIndex: 50,
    // Same dissolve recipe as the footer (Footer.astro): 55% surface + blur(5px),
    // so the background nodes and any content scrolling behind read through clearly
    // (a heavy blur smears the thin node lines into nothing). The gradient seam
    // below fades the header into the content (mirror of the footer's top seam).
    bg: 'color-mix(in srgb, token(colors.bg) 55%, transparent)',
    backdropFilter: 'blur(5px)',
    borderBottom: '1px solid token(colors.border)',
    _after: {
      content: '""',
      position: 'absolute',
      left: 0,
      right: 0,
      top: '100%',
      height: '1.25rem',
      pointerEvents: 'none',
      background: 'linear-gradient(to bottom, color-mix(in srgb, token(colors.bg) 55%, transparent), transparent)',
    },
  })}
>
  <nav
    class={css({
      position: 'relative',
      maxW: '960px',
      mx: 'auto',
      px: '1.25rem',
      h: '64px',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'space-between',
      gap: '1rem',
    })}
  >
    <a
      href="/"
      class={css({
        display: 'inline-flex',
        alignItems: 'center',
        gap: '0.45rem',
        fontFamily: 'redaction50',
        fontWeight: 700,
        fontSize: '1.25rem',
        letterSpacing: '-0.01em',
        whiteSpace: 'nowrap',
      })}
    >
      <PixelStar size={17} twinkle={false} class={css({ flexShrink: 0 })} />
      {/* Domain-based brand identity (cyberkit.win vs patricksaade.com) — see
          BaseHead.astro's own pre-paint script, which sets `data-brand="cyberkit"`
          on <html> before first paint (client-side only, so <title>/meta/OG stay
          Patrick-branded regardless of domain — a deliberate tradeoff, see
          CLAUDE.md). Both brand's markup always renders server-side; a single-
          level `[data-brand="cyberkit"] &` selector toggles which is visible —
          never nested with another self-selector (that's the exact Panda
          gotcha this codebase already hit once with the switch-thumb bug). */}
      <span class={css({ display: { base: 'inline', sm: 'none' }, '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.brandShort}</span>
      <span class={css({ display: { base: 'none', sm: 'inline' }, '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.brand}</span>
      <span class={css({ display: 'none', '[data-brand="cyberkit"] &': { display: 'inline' } })}>CyberKit</span>
    </a>

    <div
      class={css({
        display: 'flex',
        alignItems: 'center',
        gap: { base: '0.5rem', md: '1.5rem' },
      })}
    >
      <ul
        class={css({
          display: { base: 'none', md: 'flex' },
          alignItems: 'center',
          gap: '1.5rem',
          listStyle: 'none',
          m: 0,
          p: 0,
        })}
      >
        {/* NAV_LINKS is exactly Blog/Labs/About — the three personal-content
            pages redirected away by vercel.json on cyberkit.win (see that
            file's own comment) — so the whole list hides together on that
            domain rather than needing per-item filtering. A visitor who
            somehow lands on one of those URLs anyway still gets redirected
            at the edge; this just keeps a dead-end link out of the nav. */}
        {
          NAV_LINKS.map((link) => (
            <li class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={css({
                  // `inline-flex` + `alignItems: 'center'` (not left as plain
                  // inline text) so this matches moreBtn's own box model
                  // below: a plain inline <a>'s rect is sized to its glyph
                  // ink-box (font ascent/descent), while an inline-flex
                  // container's rect is sized to the full line-height box —
                  // two different heights for the same font-size/line-height,
                  // which threw off the shared `align-items: center` on the
                  // parent <ul> and made Blog/Labs/About sit visibly lower
                  // than the DFIR/More triggers. Matching box models here is
                  // what actually fixes it, not a manual offset nudge.
                  display: 'inline-flex',
                  alignItems: 'center',
                  fontSize: '0.95rem',
                  color: 'textMuted',
                  fontWeight: 500,
                  transition: 'color 200ms ease',
                  borderBottom: '2px solid transparent',
                  pb: '2px',
                  _hover: { color: 'text' },
                  '&[aria-current=page]': {
                    color: 'primary',
                    borderBottomColor: 'primary',
                  },
                })}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        {dropdowns.map((d) => (
          <li class={`nav-more ${d.id === 'more' ? moreWrap : dfirWrap}`}>
            {d.id === 'more' ? (
              <button
                type="button"
                id={`nav-${d.id}-btn`}
                aria-expanded="false"
                aria-controls={`nav-${d.id}-menu`}
                aria-label={`${d.label} links`}
                title={`${d.label} links`}
                data-sound="tick"
                class={`nav-more-btn ${moreBtn} ${isDropdownActive(d) ? moreBtnActive : ''}`}
              >
                {d.label}
                <Icon name="chevron-down" size={13} strokeWidth={2.5} class="nav-more-chev" />
              </button>
            ) : (
              // DFIR and Drills, desktop only (this whole <ul> is md:flex —
              // see its own class above): a real link, not a button. Hovering
              // it still previews the dropdown below (CSS :hover/:focus-within
              // on the shared .nav-more ancestor, untouched by the tag
              // change), but a click navigates straight to the section's own
              // landing page instead of just toggling a menu — this trigger
              // IS that landing page, so clicking its own label should go
              // there, mirroring how a mega-menu trigger link behaves on
              // other sites. The mobile accordion below (<details
              // class="nav-mobile-section">) is a completely separate markup
              // block and keeps its own tap-to-expand behavior — a link can't
              // both navigate and expand on a single tap, so mobile
              // intentionally does not get this behavior.
              <a
                href={LANDING_HREF[d.id]}
                id={`nav-${d.id}-btn`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={`nav-${d.id}-menu`}
                aria-current={LANDING_HREF[d.id] && isActive(LANDING_HREF[d.id]!) ? 'page' : undefined}
                data-sound="tick"
                class={`nav-more-btn ${moreBtn} ${isDropdownActive(d) ? moreBtnActive : ''}`}
              >
                {d.label}
                <Icon name="chevron-down" size={13} strokeWidth={2.5} class="nav-more-chev" />
              </a>
            )}
            {d.id === 'dfir' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${dfirMenuOuter}`}>
                <div class={dfirMenuInner}>
                  <a href="/dfir/" aria-current={isActive('/dfir/') ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all DFIR pages →
                  </a>
                  <div class={menuGroupDivider} />
                  <div class={dfirGrid}>
                    {d.groups.map((g) => (
                      <div>
                        {g.category && <p class={`nav-declassify ${dfirGroupLabel}`}>{g.category}</p>}
                        <ul class={menuGroup} aria-label={g.category ?? d.label}>
                          {g.links.map((link) => (
                            <li>
                              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={`nav-declassify ${dfirLink}`}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : d.id === 'it' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${itMenuOuter}`}>
                <div class={itMenuInner}>
                  <a href="/it/" aria-current={isActive('/it/') ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all IT pages →
                  </a>
                  <div class={menuGroupDivider} />
                  <div class={itGrid}>
                    {d.groups.map((g) => (
                      <div>
                        {g.category && <p class={`nav-declassify ${dfirGroupLabel}`}>{g.category}</p>}
                        <ul class={menuGroup} aria-label={g.category ?? d.label}>
                          {g.links.map((link) => (
                            <li>
                              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={`nav-declassify ${dfirLink}`}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : d.id === 'drills' ? (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${drillsMenuOuter}`}>
                <div class={drillsMenuInner}>
                  <a href="/drills/" aria-current={isActive('/drills/') ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                    Browse all Drills →
                  </a>
                  <div class={menuGroupDivider} />
                  <div class={drillsGrid}>
                    {DRILLS_LINKS.map((link) => (
                      <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={`nav-declassify ${dfirLink}`}>
                        {link.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <div id={`nav-${d.id}-menu`} class={`nav-more-menu ${moreMenuOuter}`}>
                <div class={moreMenuInner}>
                  {d.groups.map((g, i) => (
                    <>
                      {i > 0 && <div class={menuGroupDivider} />}
                      {g.category && <p class={`nav-declassify ${menuGroupLabel}`}>{g.category}</p>}
                      <ul class={menuGroup} aria-label={g.category ?? d.label}>
                        {g.links.map((link) => (
                          <li>
                            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={`nav-declassify ${moreLink}`}>
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>

      <button
        type="button"
        data-search-trigger
        aria-label="Search"
        title="Search (⌘K)"
        class={css({
          display: { base: 'none', md: 'inline-flex' },
          alignItems: 'center',
          gap: '0.45rem',
          h: '34px',
          pl: '0.6rem',
          pr: '0.4rem',
          borderRadius: 'md',
          border: '1px solid token(colors.border)',
          bg: 'bgSubtle',
          color: 'textMuted',
          cursor: 'pointer',
          transition: 'all 150ms ease',
          _hover: { color: 'text', borderColor: 'primary', transform: 'translateY(-1px)' },
        })}
      >
        <Icon name="search" size={15} />
        <kbd
          data-cmdk-hint
          aria-hidden="true"
          class={css({
            fontFamily: 'mono',
            fontSize: '0.68rem',
            lineHeight: 1,
            color: 'textMuted',
            bg: 'bgCard',
            border: '1px solid token(colors.border)',
            borderRadius: 'sm',
            px: '0.3rem',
            py: '0.18rem',
          })}
        >⌘K</kbd>
      </button>

      <SoundToggle />

      <ThemePicker />

      {/* Standalone light/dark/system switch — furthest-right control */}
      <ModeToggle />

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        title="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class={css({
          display: { base: 'inline-flex', md: 'none' },
          alignItems: 'center',
          justifyContent: 'center',
          w: '38px',
          h: '38px',
          borderRadius: 'md',
          border: '1px solid token(colors.border)',
          bg: 'transparent',
          color: 'text',
          cursor: 'pointer',
        })}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <ul
    id="mobile-menu"
    hidden
    class={css({
      display: { base: 'flex', md: 'none' },
      flexDirection: 'column',
      gap: '0.25rem',
      listStyle: 'none',
      m: 0,
      px: '1.25rem',
      py: '0.75rem',
      borderTop: '1px solid token(colors.border)',
      bg: 'bg',
    })}
  >
    <li>
      <button
        type="button"
        data-search-trigger
        class={css({
          display: 'flex',
          alignItems: 'center',
          gap: '0.5rem',
          w: '100%',
          py: '0.6rem',
          fontSize: '1rem',
          color: 'textMuted',
          bg: 'transparent',
          border: 'none',
          cursor: 'pointer',
          textAlign: 'left',
          _hover: { color: 'primary' },
        })}
      >
        <Icon name="search" size={16} /> Search
      </button>
    </li>
    {
      NAV_LINKS.map((link) => (
        <li class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={mobileLink}>
            {link.label}
          </a>
        </li>
      ))
    }
    {/* DFIR / IT / Drills — flat links straight to each section's own landing
        page, no accordion: saves vertical space on mobile (desktop keeps its
        own hover mega-menus above, unaffected). This link already is what the
        old "Browse all X pages →" sub-link pointed at, so there's nothing to
        duplicate underneath it. */}
    {
      dropdowns
        .filter((d) => d.id !== 'more')
        .map((d, i) => (
          <li class={i === 0 ? mobileLinkDivider : undefined}>
            <a
              href={LANDING_HREF[d.id]}
              aria-current={LANDING_HREF[d.id] && isActive(LANDING_HREF[d.id]!) ? 'page' : undefined}
              class={mobileLink}
            >
              {d.label}
            </a>
          </li>
        ))
    }
    {/* More (Certifications/Privacy/Colophon) — same flat treatment, no
        grouping label needed for 3 items. */}
    {
      MORE_LINKS.map((link, i) => (
        <li class={`${i === 0 ? mobileLinkDivider : ''} ${link.href === '/certifications/' ? css({ '[data-brand="cyberkit"] &': { display: 'none' } }) : ''}`}>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={mobileLink}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  // @ts-nocheck — vanilla DOM client script
  (function () {
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    // Dismiss on outside click / Escape, mirroring ThemePicker. Listeners are
    // attached only while open (capture phase, so the toggle's own click that
    // opened it doesn't immediately re-close it) and removed on close.
    function onDocClick(e) {
      if (!menu.contains(e.target) && !toggle.contains(e.target)) close();
    }
    function onKey(e) {
      if (e.key === 'Escape') { close(); toggle.focus(); }
    }
    function open() {
      menu.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.addEventListener('click', onDocClick, true);
      document.addEventListener('keydown', onKey);
    }
    function close() {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', onDocClick, true);
      document.removeEventListener('keydown', onKey);
    }
    toggle.addEventListener('click', function () {
      if (menu.hasAttribute('hidden')) open();
      else close();
    });

    // Desktop dropdowns (DFIR / More): open purely via CSS :hover/:focus-within
    // (see global.css's `.nav-more-menu` rule) — no click-to-pin. A previous
    // version toggled a `data-open` attribute on click so the panel stayed
    // open until a second click or an outside click dismissed it; that read
    // as the menu getting stuck open (move the pointer away and it's still
    // there), so it's gone. The DFIR trigger is now a real link (see the
    // markup above) and just navigates on click, no JS needed. Two things
    // still need script, since CSS alone can't do them: keeping
    // `aria-expanded` accurate for screen readers (it has to track the same
    // hover/focus-within condition the CSS reveal already uses — there's no
    // way to bind an ARIA attribute to a CSS pseudo-class), and letting
    // Escape close an open menu for keyboard users (moving focus away is the
    // only thing that stops :focus-within from matching, and Escape has no
    // native "unfocus everything" behavior).
    var groups = Array.prototype.slice.call(document.querySelectorAll('.nav-more'));
    groups.forEach(function (group) {
      var btn = group.querySelector('.nav-more-btn');
      if (!btn) return;
      function syncExpanded() {
        btn.setAttribute('aria-expanded', String(group.matches(':hover') || group.matches(':focus-within')));
      }
      group.addEventListener('mouseenter', syncExpanded);
      group.addEventListener('mouseleave', syncExpanded);
      group.addEventListener('focusin', syncExpanded);
      group.addEventListener('focusout', syncExpanded);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var active = document.activeElement;
      if (active && groups.some(function (g) { return g.contains(active); })) active.blur();
    });
  })();
</script>
