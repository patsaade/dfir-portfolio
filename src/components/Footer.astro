---
// Site footer — brand + social, five link columns (By topic / Reference /
// Tools / Drills / Site), and a centred clock + version/commit bar.
import { css } from 'styled-system/css';
import { SITE, SOCIALS, NAV_LINKS, DOMAINS, MORE_LINKS, PERSONAL_HREFS, groupsFor, type EntryType } from '../consts';
import { VERSION, SHORT_COMMIT, COMMIT_URL } from '../utils/version';
import PixelStar from './PixelStar.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const colHead = css({
  fontFamily: 'sans',
  fontSize: '0.7rem',
  textTransform: 'uppercase',
  letterSpacing: '0.12em',
  color: 'textMuted',
  mb: '0.6rem',
});
const fLink = css({
  display: 'block',
  fontSize: '0.9rem',
  color: 'textMuted',
  py: '0.15rem',
  transition: 'color 150ms ease',
  _hover: { color: 'primary' },
});
const socialBtn = css({
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '34px',
  h: '34px',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  color: 'textMuted',
  transition: 'color 200ms ease, border-color 200ms ease, transform 200ms ease',
  _hover: { color: 'primary', borderColor: 'primary', transform: 'translateY(-2px)' },
});

const moreLinks = MORE_LINKS;
// Flat, single-level selector on purpose — never nested (Panda gotcha).
const hideOnCyberkit = css({ '[data-brand="cyberkit"] &': { display: 'none' } });

// `groupsFor` comes from consts.ts — the one shape Navigation.astro and
// ToolSidebar.astro derive their menus from too, so all three stay in sync.

// Each section column is one overview link plus one anchor per category of
// that type — never a flat dump of all 48 entries (an earlier version of this
// footer dumped every DFIR link through a 2-column CSS multicol hack and grew
// every time a tool shipped). Derived, so a new category shows up here for
// free and the anchors can't drift from the section page's own `id`s.
const sectionFooterLinks = (type: EntryType, base: string) => [
  { href: base, label: 'Overview' },
  ...groupsFor(type).map((g) => ({ href: `${base}#${g.id}`, label: g.category })),
];

const referenceFooterLinks = sectionFooterLinks('reference', '/reference/');
const toolsFooterLinks = sectionFooterLinks('tool', '/tools/');

// Drills deliberately does NOT use sectionFooterLinks. It is the only
// single-category type ('drills' is the only CategoryId of type 'drill'), so a
// per-category build would emit exactly one row, labelled "Drills", under a
// column already headed "Drills" — and pointing at `/drills/#drills`, an anchor
// that page doesn't even emit (src/pages/drills/index.astro renders a flat
// MODULES grid; only /reference/ and /tools/ emit per-group <section id>).
// So this flattens to one row per LINK, exactly as Navigation.astro's own
// Drills dropdown does for the same reason (see its comment there).
// `flatMap` over the groups rather than indexing [0], so a second drill
// category would still render every link instead of silently dropping some.
const drillsFooterLinks = [
  { href: '/drills/', label: 'Overview' },
  ...groupsFor('drill').flatMap((g) => g.links).map((e) => ({ href: e.href, label: e.label })),
];

// Topic hubs — the domains that earned their own hub page (`hub: true`).
// Derived from DOMAINS so promoting/demoting a hub in consts.ts is the only
// edit needed. These are topic-hub pages for domain tags (see DOMAINS in
// consts.ts), not personal-identity content, so no cyberkit brand toggle.
// Hub paths come from DOMAINS itself (`hubHref`) rather than being rebuilt as
// `/${d.id}/` here — same single source DomainHub and the index-page topic tiles
// read, so the path can't drift between the three.
const hubLinks = DOMAINS.filter((d) => d.hub).map((d) => ({ href: d.hubHref!, label: d.label }));
---

<footer
  class={css({
    position: 'relative',
    borderTop: '1px solid token(colors.border)',
    mt: '4rem',
    // Translucent + frosted so the ambient node-field (and any content behind)
    // shows through as a soft blurred ghost — the page dissolves into the footer
    // instead of hitting a flat slab. Same dissolve recipe as the header (see
    // Navigation.astro): 55% surface + blur(5px) (lower opacity and a lighter blur
    // let the background nodes read through clearly — a heavy blur smears the thin
    // node lines into nothing). The gradient seam fades the content above into the
    // footer's top edge.
    bg: 'color-mix(in srgb, token(colors.bgSubtle) 55%, transparent)',
    backdropFilter: 'blur(5px)',
    _before: {
      content: '""',
      position: 'absolute',
      left: 0,
      right: 0,
      top: '-2.5rem',
      height: '2.5rem',
      pointerEvents: 'none',
      background: 'linear-gradient(to bottom, transparent, color-mix(in srgb, token(colors.bgSubtle) 55%, transparent))',
    },
  })}
>
  <div
    class={css({
      maxW: '960px',
      mx: 'auto',
      px: '1.25rem',
      py: { base: '2rem', sm: '2.25rem' },
      display: 'grid',
      // Brand + five nav columns (Explore / By topic / Reference / Tools / More).
      // The nav columns share one `1fr` each so no category label gets a column
      // narrower than its neighbours. Six children don't fit legibly at `md`
      // (768px would give each ~120px, and the Reference/Tools rows are long
      // category names like "Converters & Calculators"), so md lays them out as
      // two balanced rows of three and only lg puts all six on one line.
      gridTemplateColumns: {
        base: '1fr',
        sm: 'repeat(2, 1fr)',
        md: '1.4fr repeat(2, 1fr)',
        lg: '1.4fr repeat(5, 1fr)',
      },
      gap: { base: '1.75rem', sm: '1.75rem 1.5rem' },
    })}
  >
    {/* Brand + social — domain-based swap, see Navigation.astro's own comment
        on the `[data-brand="cyberkit"]` mechanism (BaseHead.astro sets it
        pre-paint). The whole social row is personal-identity content
        (Patrick's own LinkedIn/GitHub/Credly profiles, plus an RSS feed for
        a blog that's redirected away on this domain anyway), so it hides as
        one unit on cyberkit.win rather than filtering per-icon. */}
    <div>
      <a
        href="/"
        class={css({ display: 'inline-flex', alignItems: 'center', gap: '0.45rem', fontFamily: 'redaction50', fontWeight: 700, fontSize: '1.2rem', color: 'text', letterSpacing: '-0.01em', _hover: { color: 'primary' } })}
      >
        <PixelStar size={16} class={css({ flexShrink: 0 })} />
        <span class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.brand}</span>
        <span class={css({ display: 'none', '[data-brand="cyberkit"] &': { display: 'inline' } })}>CyberKit</span>
      </a>
      <p class={css({ fontSize: '0.875rem', color: 'textMuted', mt: '0.6rem', lineHeight: 1.65, maxW: '320px' })}>
        <span class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>{SITE.tagline} — writeups, labs, tooling, and a daily security term.</span>
        <span class={css({ display: 'none', '[data-brand="cyberkit"] &': { display: 'inline' } })}>Free, browser-based DFIR &amp; IT tools — nothing you enter ever leaves your browser.</span>
      </p>
      {/* Provenance — cyberkit.win only. The social row below is hidden there
          (personal profiles), so this is the one place on that domain a
          visitor can find out who maintains the toolkit and where the
          portfolio side lives. Flat single-level selector, never nested. */}
      <p class={css({ display: 'none', fontSize: '0.8rem', color: 'textMuted', mt: '0.75rem', lineHeight: 1.65, maxW: '320px', '[data-brand="cyberkit"] &': { display: 'block' } })}>
        Built and maintained by{' '}
        <a
          href={SITE.url}
          class={css({ color: 'textMuted', textDecoration: 'underline', transition: 'color 150ms ease', _hover: { color: 'primary' } })}
        >{SITE.author}</a>, with support from Claude Code.
      </p>
      <div class={css({ display: 'flex', gap: '0.6rem', mt: '1.4rem', '[data-brand="cyberkit"] &': { display: 'none' } })}>
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class={socialBtn}><Icon name="linkedin" size={17} /></a>
        <a href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub" class={socialBtn}><Icon name="github" size={17} /></a>
        <a href={SOCIALS.credly} target="_blank" rel="noopener" aria-label="Credly" class={socialBtn}><Icon name="award" size={17} /></a>
        <a href="/rss.xml" aria-label="RSS feed" class={socialBtn}><Icon name="rss" size={16} /></a>
      </div>
    </div>

    {/* By topic — the topic hubs (/dfir/, /networking/, /systems/): the site's
        SECOND axis. The nav is organized by object type + verb, and domain is a
        cross-cutting tag, so a hub is "everything about one subject, whatever
        kind of thing it is". It leads the nav columns because it cuts across
        the three type columns that follow. Not personal-identity content, so no
        cyberkit toggle. */}
    <nav aria-label="Footer — browse by topic">
      <p class={colHead}>By topic</p>
      {hubLinks.map((l) => <a href={l.href} class={fLink}>{l.label}</a>)}
    </nav>

    {/* The three TYPE columns, in nav order: read it / feed it input / practice.
        Reference and Tools list one row per CATEGORY; Drills lists one row per
        LINK — see drillsFooterLinks for why the two shapes differ. */}
    <nav aria-label="Footer — reference">
      <p class={colHead}>Reference</p>
      {referenceFooterLinks.map((l) => <a href={l.href} class={fLink}>{l.label}</a>)}
    </nav>

    <nav aria-label="Footer — tools">
      <p class={colHead}>Tools</p>
      {toolsFooterLinks.map((l) => <a href={l.href} class={fLink}>{l.label}</a>)}
    </nav>

    <nav aria-label="Footer — drills">
      <p class={colHead}>Drills</p>
      {drillsFooterLinks.map((l) => <a href={l.href} class={fLink}>{l.label}</a>)}
    </nav>

    {/* Site — Blog/Labs/About (formerly their own "Explore" column) merged with
        the meta links. Explore was dissolved for two reasons: giving Drills its
        own column would otherwise have needed a 7th grid child, which doesn't
        fit legibly in the 960px container shared with the header and page body;
        and once Drills moved out, every remaining Explore row carried
        `hideOnCyberkit`, so that column rendered as a bare heading over an empty
        cell on cyberkit.win. Merging solves both at once, and needs NO new
        hiding logic — PERSONAL_HREFS already covers Blog/Labs/About as well as
        Certifications, so the existing per-row predicate below is unchanged.
        Privacy and Colophon are site-level and carry no toggle, which is what
        guarantees this column can never go empty on either domain. */}
    <nav aria-label="Footer — site and meta">
      <p class={colHead}>Site</p>
      {[...NAV_LINKS, ...moreLinks].map((l) => (
        <a href={l.href} class={PERSONAL_HREFS.includes(l.href) ? `${fLink} ${hideOnCyberkit}` : fLink}>{l.label}</a>
      ))}
    </nav>
  </div>

  {/* Bottom bar */}
  <div class={css({ borderTop: '1px solid token(colors.border)' })}>
    <div
      class={css({
        maxW: '960px',
        mx: 'auto',
        px: '1.25rem',
        py: '0.85rem',
        // THREE TRACKS with mathematically equal outer rails, so the clock sits
        // at the bar's true centre no matter what flanks it. This was a
        // `justify-content: space-between` flex row, which only *looks* centred
        // while the copyright and the version string happen to be the same
        // width — they never are, and both move independently: the copyright
        // forks per domain ("© 2026 Patrick Saade." vs "© 2026 CyberKit."), and
        // the version grows on every push as `git rev-list --count HEAD` climbs
        // (build.35 → build.100 → build.1000, see utils/version.ts). The drift
        // was (width3 − width1) / 2.
        //
        // `minmax(0, 1fr)` NOT a bare `1fr`: an `fr` track keeps a min-content
        // floor, so a long copyright would inflate its own rail and re-break the
        // symmetry that makes this work.
        display: 'grid',
        gridTemplateColumns: { base: '1fr', sm: 'minmax(0, 1fr) auto minmax(0, 1fr)' },
        alignItems: 'center',
        // Below sm the bar is a single stacked column, where "centre of a row"
        // has no meaning — so centre the whole stack instead. Both of these MUST
        // name their `sm` value explicitly: Panda is mobile-first, so a lone
        // `base` entry would leak upward into every larger breakpoint.
        justifyItems: { base: 'center', sm: 'stretch' },
        textAlign: { base: 'center', sm: 'start' },
        gap: '0.6rem',
        fontSize: '0.8rem',
        color: 'textMuted',
      })}
    >
      <span>
        <span class={css({ '[data-brand="cyberkit"] &': { display: 'none' } })}>© {year} {SITE.author}. Built with Astro + Panda CSS.</span>
        <span class={css({ display: 'none', '[data-brand="cyberkit"] &': { display: 'inline' } })}>© {year} CyberKit. Built with Astro + Panda CSS.</span>
      </span>

      {/* Live status line — a forensic/terminal touch. Defaults to UTC, which
          ties to the UTC-keyed Term of the Day (it rolls over at 00:00 UTC) and
          matches every timestamp this site prints; click it to swap to local
          time and back. Resolution is HH:MM, not HH:MM:SS — a seconds field is
          what forced a 1 Hz timer to run for the life of every open tab (see the
          script below); at minute resolution the page wakes up 60× less often
          for a status line that sits below the fold. The no-JS fallback is the
          inert "UTC --:--" label. */}
      <span
        class={css({
          display: 'inline-flex',
          alignItems: 'center',
          gap: '0.4rem',
          fontFamily: 'mono',
          fontSize: '0.72rem',
          color: 'textMuted',
          // Inert while the centre track is `auto` (content-sized), but states
          // the intent so a future edit to the track list can't silently
          // de-centre this.
          justifySelf: 'center',
        })}
      >
        <span
          class={`totd-pulse-dot ${css({ w: '6px', h: '6px', borderRadius: 'full', bg: 'primary', flexShrink: 0 })}`}
          style="animation: totd-pulse 2.4s ease-in-out infinite;"
          aria-hidden="true"
        ></span>
        <button
          type="button"
          id="footer-clock"
          data-sound="tick"
          aria-live="off"
          title="Show this time in your local timezone"
          class={css({
            fontFamily: 'mono',
            fontSize: '0.72rem',
            color: 'textMuted',
            bg: 'transparent',
            border: 'none',
            p: 0,
            cursor: 'pointer',
            borderBottom: '1px dotted token(colors.border)',
            transition: 'color 150ms ease, border-color 150ms ease',
            _hover: { color: 'primary', borderBottomColor: 'primary' },
            _focusVisible: { color: 'primary', outline: '2px solid token(colors.primary)', outlineOffset: '2px' },
          })}
        >UTC&nbsp;--:--</button>
        <span aria-hidden="true" class={css({ color: 'border' })}>·</span>
        <span>static</span>
      </span>

      <a
        href={COMMIT_URL}
        target="_blank"
        rel="noopener"
        aria-label={`Version ${VERSION}${SHORT_COMMIT ? `, commit ${SHORT_COMMIT}` : ''} on GitHub`}
        class={css({
          fontFamily: 'mono',
          fontSize: '0.75rem',
          color: 'textMuted',
          display: 'inline-flex',
          alignItems: 'center',
          gap: '0.4rem',
          transition: 'color 150ms ease',
          _hover: { color: 'primary' },
          // Required, not cosmetic. Under the bar's `justifyItems: stretch`
          // this inline-flex anchor blockifies and stretches across its whole
          // track, which would park the version at the track's LEFT edge —
          // visibly jumping it inward from the bar's right edge.
          justifySelf: { base: 'center', sm: 'end' },
        })}
      >
        <Icon name="github" size={13} />
        {VERSION}{SHORT_COMMIT ? ` · ${SHORT_COMMIT}` : ''}
      </a>
    </div>
  </div>

  <script>
    // @ts-nocheck — vanilla DOM client script
    (function () {
      var el = document.getElementById('footer-clock');
      if (!el) return;
      // UTC is the default because the Term of the Day rolls over at 00:00 UTC
      // and every timestamp this site prints is UTC — but a visitor reading a
      // log against their own wall clock wants local, so one click swaps it.
      // Persisted like every other stateful control here (see privacy.astro).
      var KEY = 'clock-tz';
      var local = false;
      try { local = localStorage.getItem(KEY) === 'local'; } catch (e) {}
      // Short zone label ("PDT", "CET") when the browser offers one; falls back
      // to a UTC±H[:MM] offset so the button always says which zone it is showing.
      function localLabel() {
        try {
          var parts = new Intl.DateTimeFormat(undefined, { timeZoneName: 'short' }).formatToParts(new Date());
          for (var i = 0; i < parts.length; i++) if (parts[i].type === 'timeZoneName') return parts[i].value;
        } catch (e) {}
        // Stay in MINUTES. This used to be `-getTimezoneOffset() / 60` printed
        // raw, which is only correct for whole-hour zones: India came out as
        // "UTC+5.5" and Nepal as "UTC+5.75", neither of which is a notation
        // anyone writes. Format H:MM instead, dropping the ":00" for the
        // whole-hour majority. (`pad` is a hoisted function declaration in this
        // same IIFE, so calling it before its line is fine.)
        var mins = -new Date().getTimezoneOffset(); // minutes EAST of UTC
        var abs = Math.abs(mins);
        var rem = abs % 60;
        return 'UTC' + (mins < 0 ? '-' : '+') + Math.floor(abs / 60) + (rem ? ':' + pad(rem) : '');
      }
      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      function render() {
        var d = new Date();
        el.textContent = local
          ? localLabel() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
          : 'UTC ' + pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes());
        el.title = local ? 'Show this time in UTC' : 'Show this time in your local timezone';
      }

      // A self-scheduling setTimeout rather than a 1 Hz setInterval. Two wins
      // over the old `setInterval(tick, 1000)` + `if (document.hidden) return;`
      // shape: (1) at HH:MM resolution there is nothing to redraw between minute
      // boundaries, so the tab wakes once a minute instead of 60×; (2) the old
      // hidden-check only skipped the WORK — the timer itself kept firing every
      // second for as long as the tab existed. Here a hidden tab has no pending
      // timer at all.
      //
      // Each timeout is aimed at the next wall-clock minute boundary (+50ms of
      // slack so a slightly-early wakeup doesn't render the minute that is about
      // to end), so the display flips when the minute actually flips and cannot
      // drift with how long the page has been open. Every timezone offset in use
      // is a whole number of minutes, so a UTC minute boundary is a local minute
      // boundary too — one schedule serves both modes.
      var timer = null;
      function stop() {
        if (timer !== null) { clearTimeout(timer); timer = null; }
      }
      function schedule() {
        stop();
        timer = setTimeout(function () {
          timer = null;
          run();
        }, 60000 - (Date.now() % 60000) + 50);
      }
      function run() {
        render();
        if (!document.hidden) schedule();
      }

      el.addEventListener('click', function () {
        local = !local;
        try { localStorage.setItem(KEY, local ? 'local' : 'utc'); } catch (e) {}
        // Redraw only — the pending timeout is already aimed at the next minute
        // boundary, which the timezone swap doesn't move.
        render();
      });
      document.addEventListener('visibilitychange', function () {
        // Backgrounded: drop the timer entirely. Foregrounded: catch up on
        // whatever minutes passed, then re-arm.
        if (document.hidden) stop();
        else run();
      });
      run();
    })();
  </script>
</footer>
