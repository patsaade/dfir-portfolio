---
// Site-wide "Term of the Day" ticker — a scrolling banner pinned to the
// top of every page. The term is chosen SERVER-SIDE at build by termForDate()
// (keyed to the UTC calendar day), so it's baked into the HTML — identical for
// every visitor, no client JS, no flash. A daily redeploy (00:10 UTC, see
// .github/workflows/daily-deploy.yml) re-renders it for the new UTC day. The marquee
// track holds the content many times and animates to -50% for a seamless loop (see
// global.css → @keyframes totd-marquee).
import { css } from 'styled-system/css';
import Icon from './Icon.astro';
import { termForDate } from '../data/securityTerms';

const today = termForDate(new Date());
const href = `/reference/glossary/${today.slug}/`;

// Identical copies; -50% translate lands on a matching frame. Enough copies to
// span ultra-wide viewports without a gap.
const COPIES = 12;

// flex centers the line box; the small translateY optically centers the Redaction
// serif, whose glyphs otherwise sit a hair high in the tight bar.
const itemClass = css({ display: 'inline-flex', alignItems: 'center', gap: '0.5rem', flexShrink: 0, transform: 'translateY(1px)' });
const termClass = css({ color: 'primary', fontWeight: 700, letterSpacing: '0.03em' });
const dashClass = css({ color: 'textMuted', opacity: 0.7 });
const shortClass = css({ color: 'text', fontWeight: 500 });
const sepClass = css({ color: 'primary', opacity: 0.4, px: '1.1rem', fontSize: '0.7em' });

// Pause/play control (WCAG 2.2.2 Pause, Stop, Hide, Level A). The marquee is
// auto-starting, runs indefinitely and sits alongside other content on every
// page, so it needs a real mechanism to stop it — the pre-existing `_hover`
// pause below is mouse-only and does nothing for a keyboard or touch visitor.
// It's a sibling of the link, never a child: a <button> nested inside an <a>
// is invalid HTML and unusable with assistive tech.
//
// It ships `hidden` and is un-hidden by the script (the same armed-by-script
// pattern BackToTop/Search use), so a no-JS visitor never gets an inert
// control — for them the ticker simply scrolls as it always has, which is the
// accepted limit of a static, prerendered page. The explicit `&[hidden]`
// override is required: the native `hidden` attribute loses to this element's
// own unconditional `display` (see CLAUDE.md → Debugging gotchas).
const pauseBtnClass = css({
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  alignSelf: 'stretch',
  flexShrink: 0,
  w: { base: '30px', sm: '34px' },
  p: 0,
  bg: 'transparent',
  border: 'none',
  borderLeft: '1px solid token(colors.border)',
  color: 'textMuted',
  cursor: 'pointer',
  transition: 'color 150ms ease, background 150ms ease',
  _hover: { color: 'primary', bg: 'color-mix(in srgb, token(colors.primary) 13%, transparent)' },
  '&[hidden]': { display: 'none' },
});
// Same `&[hidden]` reasoning — the script swaps which glyph is showing.
const pauseIconClass = css({ display: 'block', '&[hidden]': { display: 'none' } });
---

<aside data-totd aria-label="Cybersecurity term of the day" class={css({
  position: 'relative',
  display: 'flex',
  alignItems: 'stretch',
  w: '100%',
  bg: 'bgSubtle',
  borderBottom: '1px solid token(colors.border)',
  overflow: 'hidden',
  fontFamily: 'redaction50',
  lineHeight: 1,
})}>
  <a
    href={href}
    aria-label={`Cybersecurity term of the day: ${today.term}. ${today.short} Read the full entry.`}
    class={css({
      display: 'flex',
      alignItems: 'stretch',
      flex: 1,
      minW: 0,
      h: { base: '34px', sm: '36px' },
      color: 'text',
      _hover: {
        '& .totd-marquee-track': { animationPlayState: 'paused' },
        '& .totd-cue': { color: 'primary', transform: 'translateX(2px)' },
      },
    })}
  >
    {/* Static label chip */}
    <span class={css({
      display: 'inline-flex',
      alignItems: 'center',
      gap: '0.45rem',
      flexShrink: 0,
      px: { base: '0.7rem', sm: '0.95rem' },
      bg: 'color-mix(in srgb, token(colors.primary) 13%, transparent)',
      borderRight: '1px solid token(colors.border)',
      color: 'primary',
      fontSize: { base: '0.58rem', sm: '0.68rem' },
      fontWeight: 700,
      letterSpacing: '0.12em',
      textTransform: 'uppercase',
      whiteSpace: 'nowrap',
    })}>
      <span class={`totd-pulse-dot ${css({
        w: '6px',
        h: '6px',
        borderRadius: 'full',
        bg: 'currentColor',
        flexShrink: 0,
        animation: 'totd-pulse 2s ease-in-out infinite',
      })}`} aria-hidden="true"></span>
      <span>Term of the Day</span>
    </span>

    {/* Scrolling viewport (decorative; the link's aria-label carries the text) */}
    <span
      aria-hidden="true"
      class={css({
        position: 'relative',
        flex: 1,
        minW: 0,
        display: 'flex',
        alignItems: 'center',
        overflow: 'hidden',
        maskImage: 'linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent)',
        WebkitMaskImage: 'linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent)',
      })}
    >
      <span class={`totd-marquee-track ${css({
        display: 'inline-flex',
        alignItems: 'center',
        flexShrink: 0,
        whiteSpace: 'nowrap',
        pl: '1.25rem',
        fontSize: { base: '0.78rem', sm: '0.85rem' },
        willChange: 'transform',
        animation: 'totd-marquee 75s linear infinite',
      })}`}>
        {
          Array.from({ length: COPIES }).map(() => (
            <span class={itemClass}>
              <strong class={termClass}>{today.term}</strong>
              <span class={dashClass}>—</span>
              <span class={shortClass}>{today.short}</span>
              <span class={sepClass}>◆</span>
            </span>
          ))
        }
      </span>
    </span>

    {/* "More" cue */}
    <span class={`totd-cue ${css({
      display: { base: 'none', sm: 'inline-flex' },
      alignItems: 'center',
      flexShrink: 0,
      px: '0.7rem',
      color: 'textMuted',
      borderLeft: '1px solid token(colors.border)',
      transition: 'color 200ms ease, transform 200ms ease',
    })}`} aria-hidden="true">
      <Icon name="chevron-right" size={14} strokeWidth={2.5} />
    </span>
  </a>

  {/* Pause/play. The label flips between "Pause…"/"Resume…" (the standard
      media-control convention) rather than carrying a fixed label plus
      aria-pressed — one unambiguous statement of what activating it does,
      instead of two overlapping ones. Icons are inline here because Icon.astro
      has no pause/play glyph. */}
  <button
    type="button"
    data-totd-toggle
    hidden
    class={pauseBtnClass}
    aria-label="Pause the scrolling term of the day"
    title="Pause the scrolling term of the day"
    data-sound="tick"
  >
    <svg data-totd-icon="pause" class={pauseIconClass} viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true" focusable="false">
      <rect x="7" y="5" width="3.6" height="14" rx="1"></rect>
      <rect x="13.4" y="5" width="3.6" height="14" rx="1"></rect>
    </svg>
    {/* `hidden` is spread rather than written literally: it is an HTMLElement
        IDL property and Astro's JSX types reject it on <svg>. The ATTRIBUTE
        still applies, which is all the `&[hidden]` CSS rule and the script's
        setAttribute/removeAttribute toggling need. */}
    <svg data-totd-icon="play" class={pauseIconClass} {...{ hidden: true }} viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M8 5.2v13.6L19 12z"></path>
    </svg>
  </button>
</aside>

<script is:inline>
  // @ts-nocheck — vanilla DOM client script. `is:inline` (not a bundled
  // module) so it runs during parse, right after the bar it controls: a
  // deferred module would let a stored "paused" preference flash a frame or
  // two of scrolling before it applied.
  (function () {
    var bar = document.querySelector('[data-totd]');
    if (!bar) return;
    var btn = bar.querySelector('[data-totd-toggle]');
    if (!btn) return;
    var iconPause = btn.querySelector('[data-totd-icon="pause"]');
    var iconPlay = btn.querySelector('[data-totd-icon="play"]');
    var KEY = 'totd-paused';
    var PAUSE_LABEL = 'Pause the scrolling term of the day';
    var PLAY_LABEL = 'Resume the scrolling term of the day';
    var COOLDOWN = 150; // matches the button's own longest transition
    var paused = false;
    var busy = false;

    function reduced() {
      try { return window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; }
    }
    function read() {
      try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; }
    }
    function save() {
      try {
        if (paused) localStorage.setItem(KEY, '1');
        else localStorage.removeItem(KEY);
      } catch (e) { /* private mode / storage disabled — the control still works for this page */ }
    }
    function render() {
      // The attribute drives both infinite animations at once (the marquee
      // track and the "live" pulse dot) via one flat rule in global.css.
      if (paused) bar.setAttribute('data-totd-paused', '');
      else bar.removeAttribute('data-totd-paused');
      var label = paused ? PLAY_LABEL : PAUSE_LABEL;
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      // setAttribute, NOT the `.hidden` IDL property: these are <svg> elements,
      // and `hidden` is defined on HTMLElement — assigning `svg.hidden = true`
      // silently sets a plain JS property that reflects to no attribute and
      // therefore matches no CSS.
      showIcon(iconPause, !paused);
      showIcon(iconPlay, paused);
    }
    function showIcon(el, show) {
      if (!el) return;
      if (show) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    }
    function arm() {
      // Under reduced motion global.css already stops the marquee and the
      // pulse dot outright, so there is nothing left to pause — don't offer a
      // control that would do nothing.
      if (reduced()) btn.setAttribute('hidden', '');
      else btn.removeAttribute('hidden');
    }

    // Debounced the same way ToolSidebar's `debounceClick` does it (ignore
    // while busy + a cooldown, not a trailing-edge debounce that delays the
    // first click), so a rapid double-click can't land mid-transition and
    // thrash the state back to where it started.
    btn.addEventListener('click', function () {
      if (busy) return;
      busy = true;
      setTimeout(function () { busy = false; }, COOLDOWN);
      paused = !paused;
      save();
      render();
    });

    paused = read();
    render();
    arm();
    try {
      var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (mq.addEventListener) mq.addEventListener('change', arm);
    } catch (e) { /* no matchMedia — the button stays armed, which is the safe default */ }
  })();
</script>
