// 'extract' — one labeled blank per field. Reuses testCaseRowCss/
// testCaseIconCss's own pass/fail/pending vocabulary (same data-state
// values) rather than inventing a second one.
const extractListCss = css({ display: 'flex', flexDirection: 'column', gap: '0.5rem', mt: '0.75rem' });
const extractRowCss = css({
  display: 'flex',
  flexWrap: 'wrap',
  alignItems: 'center',
  gap: '0.5rem',
  p: '0.5rem 0.6rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  bg: 'bgSubtle',
  '&[data-state="pass"]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 10%, transparent)' },
  '&[data-state="fail"]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 8%, transparent)' },
});
const extractLabelCss = css({ fontFamily: 'sans', fontSize: '0.82rem', fontWeight: 600, color: 'text', flex: '1 1 200px', minW: '160px' });
const extractInputCss = css({
  flex: '1 1 200px',
  minW: '140px',
  fontFamily: 'mono',
  fontSize: '0.88rem',
  color: 'text',
  bg: 'bgCard',
  border: '1px solid token(colors.borderStrong)',
  borderRadius: 'md',
  px: '0.6rem',
  py: '0.4rem',
  transition: 'border-color 150ms ease',
  _focus: { outline: 'none', borderColor: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.7 },
});
const extractIconCss = css({
  flexShrink: 0,
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '16px',
  h: '16px',
  borderRadius: 'full',
  fontSize: '0.7rem',
  lineHeight: 1,
  color: 'textMuted',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  '[data-state="pass"] &': { borderColor: 'accent', color: 'accent' },
  '[data-state="fail"] &': { borderColor: 'danger', color: 'danger' },
});

// 'match' — one row per item, a small fixed button group per row instead of
// one shared input. Buttons reuse choiceBtnCss's own look at a smaller size
// rather than a third button style.
const matchListCss = css({ display: 'flex', flexDirection: 'column', gap: '0.5rem', mt: '0.75rem' });
const matchRowCss = css({
  display: 'flex',
  flexWrap: 'wrap',
  alignItems: 'center',
  gap: '0.6rem',
  p: '0.55rem 0.65rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  bg: 'bgSubtle',
  '&[data-state="pass"]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 10%, transparent)' },
  '&[data-state="fail"]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 8%, transparent)' },
});
// Same ✓/✕ status ring 'construct'/'extract' rows already use — added here
// because a match row used to signal pass/fail by border + background tint
// ALONE, which is a WCAG 1.4.1 (Use of Color) failure and invisible to a
// screen reader. drillEngine.ts fills this with a glyph and fills the
// sibling srOnly span with the word "correct"/"incorrect".
const matchIconCss = css({
  flexShrink: 0,
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '16px',
  h: '16px',
  borderRadius: 'full',
  fontSize: '0.7rem',
  lineHeight: 1,
  color: 'textMuted',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  '[data-state="pass"] &': { borderColor: 'accent', color: 'accent' },
  '[data-state="fail"] &': { borderColor: 'danger', color: 'danger' },
});
const matchTextCss = css({ fontFamily: 'mono', fontSize: '0.85rem', color: 'text', wordBreak: 'break-all', flex: '1 1 220px', minW: '160px' });
const matchGroupCss = css({ display: 'flex', flexWrap: 'wrap', gap: '0.35rem' });
const matchBtnCss = css({
  fontFamily: 'sans',
  fontSize: '0.78rem',
  fontWeight: 600,
  color: 'textMuted',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'full',
  px: '0.65rem',
  py: '0.3rem',
  cursor: 'pointer',
  transition: 'all 150ms ease',
  _hover: { borderColor: 'primary', color: 'primary' },
  _disabled: { cursor: 'not-allowed' },
  '&[data-active]': { borderColor: 'primary', color: 'onPrimary', bg: 'primary' },
});

// 'sequence' — an "available tiles" pool + an ordered "your sequence" list,
// both populated client-side only (there is no meaningful no-JS
// interaction for click-to-reorder — same accepted limitation every
// answerType already has for actual grading, see this file's header
// comment). Tiles reuse matchBtnCss-scale typography for visual family.
const sequencePoolCss = css({ display: 'flex', flexWrap: 'wrap', gap: '0.4rem', mt: '0.75rem' });
const sequenceOrderCss = css({
  display: 'flex',
  flexWrap: 'wrap',
  gap: '0.4rem',
  mt: '0.6rem',
  minH: '2.4rem',
  p: '0.4rem',
  borderRadius: 'md',
  border: '1px dashed token(colors.border)',
  listStyle: 'none',
});
const sequenceTileCss = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.35rem',
  fontFamily: 'mono',
  fontSize: '0.8rem',
  fontWeight: 600,
  color: 'text',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  px: '0.6rem',
  py: '0.35rem',
  cursor: 'pointer',
  transition: 'all 150ms ease',
  _hover: { borderColor: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.7 },
  '&[data-state="pass"]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 12%, transparent)' },
  '&[data-state="fail"]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 10%, transparent)' },
});
// A sequence tile's position used to be graded by border/background alone
// (WCAG 1.4.1). It now carries the same ✓/✕ glyph the other iterate-style
// answerTypes use, plus a visually-hidden "correct"/"incorrect" sibling.
// The glyph is `display: none` until the tile actually has a data-state, so
// an ungraded tile renders exactly as it did before (an empty inline span
// would still trigger the tile's own flex `gap` and widen every tile).
const sequenceIconCss = css({
  display: 'none',
  flexShrink: 0,
  fontSize: '0.72rem',
  lineHeight: 1,
  color: 'textMuted',
  // Flat, single-level `[data-x] &` selectors only — the same proven shape
  // testCaseIconCss/extractIconCss use. (Nesting a second self-selector
  // inside one of these is the documented Panda gotcha that compiles to a
  // rule with the ancestor condition baked into the class NAME only.)
  '[data-state="pass"] &': { display: 'inline', color: 'accent' },
  '[data-state="fail"] &': { display: 'inline', color: 'danger' },
});
const sequenceResetBtnCss = css({
  fontFamily: 'sans',
  fontSize: '0.8rem',
  fontWeight: 600,
  color: 'textMuted',
  bg: 'transparent',
  border: 'none',
  p: 0,
  mt: '0.6rem',
  cursor: 'pointer',
  _hover: { color: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.6 },
});

const hintRowCss = css({ mt: '0.6rem' });
const hintBtnCss = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.3rem',
  fontFamily: 'sans',
  fontSize: '0.8rem',
  fontWeight: 600,
  color: 'textMuted',
  bg: 'transparent',
  border: 'none',
  p: 0,
  cursor: 'pointer',
  _hover: { color: 'primary' },
  '&[hidden]': { display: 'none' },
});
const hintTextCss = css({ fontSize: '0.85rem', color: 'textMuted', lineHeight: 1.5, mt: '0.35rem', m: 0, '&[hidden]': { display: 'none' } });

// Shared base for Check/Next/Try again — same css(base, primary) deep-merge
// pattern IocExtractor.astro's actionBtn/primaryActionBtn use (composing two
// atomized class STRINGS instead would silently drop the base's own _hover,
// per docs/STYLE_GUIDE.md's "Buttons" section).
const actionBtnBase = {
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.4rem',
  fontSize: '0.85rem',
  fontFamily: 'sans',
  fontWeight: 600,
  px: '0.85rem',
  py: '0.5rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  color: 'text',
  cursor: 'pointer',
  bg: 'bgCard',
  transition: 'all 150ms ease',
  _hover: { borderColor: 'primary', color: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.5, _hover: { borderColor: 'border', color: 'text' } },
  // The [hidden] cascade gotcha (CLAUDE.md invariant 12 territory): this
  // class sets `display` unconditionally, so the native `hidden` attribute
  // toggled by drillEngine.ts needs an explicit override or it's a no-op.
  '&[hidden]': { display: 'none' },
} as const;
const primaryBtnBase = { bg: 'primary', color: 'onPrimary', borderColor: 'primary', _hover: { opacity: 0.9, color: 'onPrimary' } } as const;
const checkBtnCss = css(actionBtnBase, primaryBtnBase);
const nextBtnCss = css(actionBtnBase, primaryBtnBase);
const restartBtnCss = css(actionBtnBase);

const checkRowCss = css({ display: 'flex', mt: '0.9rem' });
const nextRowCss = css({ display: 'flex', alignItems: 'center', gap: '0.75rem', flexWrap: 'wrap', mt: '0.9rem' });

const feedbackCss = css({
  display: 'flex',
  flexDirection: 'column',
  gap: '0.35rem',
  p: '0.75rem 0.9rem',
  mt: '0.9rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  bg: 'bgSubtle',
  '&[hidden]': { display: 'none' },
  '&[data-state="correct"]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 10%, transparent)' },
  '&[data-state="incorrect"]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 8%, transparent)' },
  // 'construct' only, via a hiddenTestCases generalization check (see
  // drillEngine.ts) — every visible test case already passes, but the
  // pattern doesn't generalize past the shown samples. Distinct from a
  // flat "incorrect" (the learner is close, not wrong) and from "correct"
  // (it isn't solved yet) — its own primary-tinted state reads as "keep
  // going," not "you failed."
  '&[data-state="generalization"]': { borderColor: 'primary', bg: 'color-mix(in srgb, token(colors.primary) 8%, transparent)' },
});
const feedbackStateCss = css({ fontFamily: 'sans', fontSize: '0.85rem', fontWeight: 700, color: 'text', m: 0 });
const explanationCss = css({ fontSize: '0.88rem', color: 'textMuted', lineHeight: 1.55, m: 0 });
const refLinkCss = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.3rem',
  fontSize: '0.82rem',
  fontWeight: 600,
  color: 'primary',
  mt: '0.15rem',
  _hover: { textDecoration: 'underline' },
  '&[hidden]': { display: 'none' },
});
const summaryCss = css({
  fontFamily: 'sans',
  fontSize: '0.95rem',
  fontWeight: 600,
  color: 'primary',
  m: 0,
  '&[hidden]': { display: 'none' },
});
---

<section data-drill={drill} class={rootCss}>
  <div class={headCss}>
    <h2 class={`declassify ${headingCss}`}>{heading}</h2>
    {intro && <p class={introCss}>{intro}</p>}
  </div>

  <p data-drill-progress role="status" aria-live="polite" class={progressCss}>
    {`Question 1 of ${totalQuestions} — 0 correct`}
  </p>

  <div class={cardCss}>
    <p data-drill-prompt tabindex="-1" class={promptCss}>{firstQuestion.prompt}</p>

    <pre data-drill-artifact tabindex="0" role="region" aria-label="Artifact to analyse" hidden={!firstQuestion.artifact} class={artifactCss}>{firstQuestion.artifact}</pre>

    <div class={hintRowCss}>
      <button type="button" data-drill-hint-btn hidden={!firstQuestion.hint} aria-expanded="false" class={hintBtnCss}>
        Show hint
      </button>
      <p data-drill-hint-text hidden={!firstQuestion.hint} class={hintTextCss}>{firstQuestion.hint}</p>
    </div>

    <div data-drill-answer class={answerCss}>
      {
        isChoice ? (
          <div data-drill-choices role="group" aria-label="Answer choices" class={choicesCss}>
            {(firstQuestion.choices ?? []).map((choice) => (
              <button type="button" class={choiceBtnCss} data-drill-choice-btn>
                {choice}
              </button>
            ))}
          </div>
        ) : isConstruct ? (
          <>
            <input
              type="text"
              data-drill-text-input
              class={textInputCss}
              placeholder="Type your pattern"
              autocomplete="off"
              spellcheck="false"
              aria-label="Your pattern"
            />
            <ul data-drill-testcases aria-label="Test cases" class={testCaseListCss}>
              {(firstQuestion.testCases ?? []).map((tc) => (
                <li data-state="pending" class={testCaseRowCss}>
                  <span data-drill-testcase-icon aria-hidden="true" class={testCaseIconCss}></span>
                  <code data-drill-testcase-text class={testCaseTextCss}>{tc.text}</code>
                  <span data-drill-testcase-label class={testCaseLabelCss}>{tc.shouldMatch ? 'should match' : 'should NOT match'}</span>
                </li>
              ))}
            </ul>
          </>
        ) : isSubnet ? (
          <>
            <input
              type="text"
              data-drill-text-input
              class={textInputCss}
              value={firstQuestion.subnetStart}
              placeholder="e.g. 10.0.0.0/24"
              autocomplete="off"
              spellcheck="false"
              aria-label="Your CIDR block"
            />
            <ul data-drill-testcases aria-label="Addresses to cover" class={testCaseListCss}>
              {(firstQuestion.testCases ?? []).map((tc) => (
                <li data-state="pending" class={testCaseRowCss}>
                  <span data-drill-testcase-icon aria-hidden="true" class={testCaseIconCss}></span>
                  <code data-drill-testcase-text class={testCaseTextCss}>{tc.text}</code>
                  <span data-drill-testcase-label class={testCaseLabelCss}>{tc.shouldMatch ? 'must be inside' : 'must be outside'}</span>
                </li>
              ))}
            </ul>
          </>
        ) : isExtract ? (
          <div data-drill-extract-fields aria-label="Fields to extract" class={extractListCss}>
            {(firstQuestion.fields ?? []).map((f) => (
              <div data-drill-extract-row data-state="pending" class={extractRowCss}>
                <span data-drill-extract-label class={extractLabelCss}>{f.label}</span>
                <input type="text" data-drill-extract-input class={extractInputCss} autocomplete="off" spellcheck="false" aria-label={f.label} />
                <span data-drill-extract-icon aria-hidden="true" class={extractIconCss}></span>
              </div>
            ))}
          </div>
        ) : isMatch ? (
          <div data-drill-match-items aria-label="Items to sort" class={matchListCss}>
            {(firstQuestion.matchItems ?? []).map((item) => (
              <div data-drill-match-row data-state="pending" class={matchRowCss}>
                <span data-drill-match-icon aria-hidden="true" class={matchIconCss}></span>
                <code data-drill-match-text class={matchTextCss}>{item.text}</code>
                <span data-drill-match-status class={srOnlyCss}></span>
                <div data-drill-match-group role="group" aria-label={`Category for ${item.text}`} class={matchGroupCss}>
                  {(firstQuestion.matchCategories ?? []).map((cat) => (
                    <button type="button" class={matchBtnCss} data-drill-match-btn data-category={cat}>{cat}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : isSequence ? (
          <>
            <div data-drill-sequence-pool role="group" aria-label="Available items" class={sequencePoolCss}>
              {(firstQuestion.sequenceItems ?? []).map((item) => (
                <button type="button" class={sequenceTileCss} data-drill-sequence-tile>
                  <span data-drill-sequence-label>{item}</span>
                  <span data-drill-sequence-icon aria-hidden="true" class={sequenceIconCss}></span>
                  <span data-drill-sequence-status class={srOnlyCss}></span>
                </button>
              ))}
            </div>
            <ol data-drill-sequence-order aria-label="Your sequence" class={sequenceOrderCss}></ol>
            <button type="button" data-drill-sequence-reset class={sequenceResetBtnCss}>Reset order</button>
          </>
        ) : (
          <input
            type="text"
            data-drill-text-input
            class={textInputCss}
            placeholder="Type your answer"
            autocomplete="off"
            spellcheck="false"
            aria-label="Your answer"
          />
        )
      }
    </div>

    <div class={checkRowCss}>
      <button type="button" data-drill-check hidden={isChoice} class={checkBtnCss}>
        Check answer
      </button>
    </div>

    <div data-drill-feedback hidden class={feedbackCss}>
      <p data-drill-feedback-state class={feedbackStateCss}></p>
      <p data-drill-feedback-explanation class={explanationCss}></p>
      <a data-drill-feedback-link hidden class={refLinkCss} target="_blank" rel="noopener"></a>
    </div>

    <div class={nextRowCss}>
      <button type="button" data-drill-next hidden class={nextBtnCss}>
        Next question →
      </button>
      <p data-drill-summary hidden role="status" aria-live="polite" class={summaryCss}></p>
      <button type="button" data-drill-restart hidden class={restartBtnCss}>
        Try again
      </button>
    </div>
  </div>

  {/* Cloned by drillEngine.ts for every question (including a re-render of
      the first one, so there's a single rendering code path) — see this
      file's header comment. */}
  <template data-drill-text-input-template>
    <input
      type="text"
      class={textInputCss}
      data-drill-text-input
      placeholder="Type your answer"
      autocomplete="off"
      spellcheck="false"
      aria-label="Your answer"
    />
  </template>
  <template data-drill-choice-template>
    <button type="button" class={choiceBtnCss} data-drill-choice-btn></button>
  </template>
  <template data-drill-testcase-template>
    <li data-state="pending" class={testCaseRowCss}>
      <span data-drill-testcase-icon aria-hidden="true" class={testCaseIconCss}></span>
      <code data-drill-testcase-text class={testCaseTextCss}></code>
      <span data-drill-testcase-label class={testCaseLabelCss}></span>
    </li>
  </template>
  {/* 'subnet' — the whole builder in one clone. Four octets and five readout
      rows are fixed counts, so they're written out literally here rather
      than needing a per-row template; drillEngine.ts fills the slot marked
      `data-drill-subnet-input-slot` with the same text input every other
      typed answerType uses, which is what keeps handleConstructCheck (and
      the no-JS server render) working unchanged. */}
  <template data-drill-subnet-template>
    <div data-drill-subnet class={subnetBuilderCss}>
      <div data-drill-subnet-octets class={subnetOctetsCss}>
        <div class={subnetFieldCss}>
          <label for="drill-subnet-octet-0" class={subnetFieldLabelCss}>Octet 1</label>
          <input type="number" id="drill-subnet-octet-0" data-drill-subnet-octet="0" min="0" max="255" step="1" inputmode="numeric" class={subnetNumberCss} />
          <input type="range" data-drill-subnet-octet-range="0" min="0" max="255" step="1" class={subnetRangeCss} aria-label="Octet 1 slider" />
        </div>
        <div class={subnetFieldCss}>
          <label for="drill-subnet-octet-1" class={subnetFieldLabelCss}>Octet 2</label>
          <input type="number" id="drill-subnet-octet-1" data-drill-subnet-octet="1" min="0" max="255" step="1" inputmode="numeric" class={subnetNumberCss} />
          <input type="range" data-drill-subnet-octet-range="1" min="0" max="255" step="1" class={subnetRangeCss} aria-label="Octet 2 slider" />
        </div>
        <div class={subnetFieldCss}>
          <label for="drill-subnet-octet-2" class={subnetFieldLabelCss}>Octet 3</label>
          <input type="number" id="drill-subnet-octet-2" data-drill-subnet-octet="2" min="0" max="255" step="1" inputmode="numeric" class={subnetNumberCss} />
          <input type="range" data-drill-subnet-octet-range="2" min="0" max="255" step="1" class={subnetRangeCss} aria-label="Octet 3 slider" />
        </div>
        <div class={subnetFieldCss}>
          <label for="drill-subnet-octet-3" class={subnetFieldLabelCss}>Octet 4</label>
          <input type="number" id="drill-subnet-octet-3" data-drill-subnet-octet="3" min="0" max="255" step="1" inputmode="numeric" class={subnetNumberCss} />
          <input type="range" data-drill-subnet-octet-range="3" min="0" max="255" step="1" class={subnetRangeCss} aria-label="Octet 4 slider" />
        </div>
      </div>

      <div class={subnetPrefixRowCss}>
        <span class={subnetPrefixLabelCss}>Prefix length</span>
        {/* Visual echo of the slider's own value. Deliberately a plain,
            aria-hidden span rather than an output element: the range input
            already announces its value on every change, and an output is an
            implicit polite live region, which would turn a single drag into
            a stream of duplicate announcements. */}
        <span data-drill-subnet-prefix-value aria-hidden="true" class={subnetPrefixValueCss}></span>
        <span class={subnetPrefixSliderWrapCss}>
          <input type="range" data-drill-subnet-prefix min="0" max="32" step="1" class={subnetRangeCss} aria-label="Prefix length" />
        </span>
      </div>

      <div>
        <label for="drill-subnet-cidr" class={subnetInputLabelCss}>CIDR block</label>
        <span data-drill-subnet-input-slot></span>
      </div>

      <dl data-drill-subnet-readout class={subnetReadoutCss}>
        <div class={subnetReadoutItemCss}>
          <dt class={subnetReadoutKeyCss}>Network</dt>
          <dd data-drill-subnet-network class={subnetReadoutValCss}>—</dd>
        </div>
        <div class={subnetReadoutItemCss}>
          <dt class={subnetReadoutKeyCss}>Broadcast</dt>
          <dd data-drill-subnet-broadcast class={subnetReadoutValCss}>—</dd>
        </div>
        <div class={subnetReadoutItemCss}>
          <dt class={subnetReadoutKeyCss}>Netmask</dt>
          <dd data-drill-subnet-netmask class={subnetReadoutValCss}>—</dd>
        </div>
        <div class={subnetReadoutItemCss}>
          <dt class={subnetReadoutKeyCss}>Usable range</dt>
          <dd data-drill-subnet-hostrange class={subnetReadoutValCss}>—</dd>
        </div>
        <div class={subnetReadoutItemCss}>
          <dt class={subnetReadoutKeyCss}>Host count</dt>
          <dd data-drill-subnet-hostcount class={subnetReadoutValCss}>—</dd>
        </div>
      </dl>

      <p data-drill-subnet-note hidden class={subnetNoteCss}></p>
    </div>
  </template>
  <template data-drill-extract-field-template>
    <div data-drill-extract-row data-state="pending" class={extractRowCss}>
      <span data-drill-extract-label class={extractLabelCss}></span>
      <input type="text" data-drill-extract-input class={extractInputCss} autocomplete="off" spellcheck="false" />
      <span data-drill-extract-icon aria-hidden="true" class={extractIconCss}></span>
    </div>
  </template>
  <template data-drill-match-item-template>
    <div data-drill-match-row data-state="pending" class={matchRowCss}>
      <span data-drill-match-icon aria-hidden="true" class={matchIconCss}></span>
      <code data-drill-match-text class={matchTextCss}></code>
      <span data-drill-match-status class={srOnlyCss}></span>
      <div data-drill-match-group role="group" class={matchGroupCss}></div>
    </div>
  </template>
  <template data-drill-match-category-btn-template>
    <button type="button" class={matchBtnCss} data-drill-match-btn></button>
  </template>
  {/* The tile's own visible text lives in its `data-drill-sequence-label`
      span, NOT directly on the button — drillEngine.ts grades a sequence by
      comparing that span's textContent against `correctOrder`, so the ✓/✕
      glyph and the visually-hidden state word must be separate children or
      they'd contaminate the comparison. */}
  <template data-drill-sequence-tile-template>
    <button type="button" class={sequenceTileCss} data-drill-sequence-tile>
      <span data-drill-sequence-label></span>
      <span data-drill-sequence-icon aria-hidden="true" class={sequenceIconCss}></span>
      <span data-drill-sequence-status class={srOnlyCss}></span>
    </button>
  </template>
</section>
