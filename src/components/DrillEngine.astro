---
// Generic interactive-quiz shell shared by 6 of the 7 /drills/* modules
// (regex, IP & CIDR math, hashing, MITRE ATT&CK, Windows Event IDs; Terminal
// Commands has its own bespoke shell, TerminalDrill.astro, since it
// simulates a live shell rather than a question/answer loop). This
// component renders ONLY the static markup — no embedded <script>. Each
// drill page owns its own question generator + grading and wires it up by
// importing `initDrill` from `../../scripts/drillEngine` directly in its own
// inline module script (see that file's header comment for why this is
// deliberately NOT a global BaseLayout mount like AnimatedDetails.astro —
// invariant 5's "minimal JS, mount only where needed" applies here since
// this is a handful of pages, not site-wide).
//
// Seven answerTypes — see drillEngine.ts's own header comment for the full
// rundown of 'text'/'choice'/'construct'/'subnet'/'extract'/'match'/
// 'sequence' and which are single-shot vs. iterate-until-correct. This file
// only renders each one's markup; drillEngine.ts owns all grading/state logic.
//
// No-JS contract: a visitor without JS must still see real content, not an
// empty shell — the interactive grading genuinely requires JS (there's no
// server to check an answer against), but the FIRST question's prompt and
// answer control render for real server-side from the `firstQuestion` prop.
// 'subnet' is the one type whose server render is deliberately a SUBSET of
// its hydrated one: SSR emits the plain CIDR text input (pre-filled with the
// question's own `subnetStart`) plus the containment list, and the octet/
// prefix builder is added by JS on top. That's on purpose — a range slider
// with no script behind it is a control that moves and does nothing, which
// is worse than not offering it; the text input is a genuinely complete
// no-JS answer control on its own, and the builder is a pure enhancement
// that writes into that same input rather than replacing it.
// The calling page computes this the same way the client script will: call
// its own `nextQuestion(0)` once in frontmatter (build time) and pass the
// result in. If a drill's generator is randomized rather than deterministic,
// note that JS will immediately re-render from its own `nextQuestion(0)`
// call on mount (see drillEngine.ts's own comment), which can briefly swap
// the visible question a moment after hydration — keeping `nextQuestion(0)`
// itself deterministic (even if later indices randomize) avoids that. For
// 'sequence' specifically, the no-JS render shows the shuffled tiles as a
// static, unclickable pool — there is no meaningful no-JS reordering
// interaction, same accepted limitation every answerType already has for
// actual grading (there's no server to check anything against either way).
//
// Every dynamically-created element (subsequent questions' input/choice/
// extract/match/sequence controls) is cloned from the <template>s below
// rather than built with `document.createElement` + a hardcoded class-name
// string — same "keeps the client script free of Panda class-name strings"
// convention as IocExtractor.astro's `data-ioc-item-template`. All
// interactive state (correct/incorrect, disabled, hidden, per-row/field/tile
// pass/fail) is expressed via plain HTML attributes (`data-state`,
// `data-correct`, `data-incorrect`, `data-active`, `disabled`, `hidden`)
// that css() below already styles by attribute selector — so drillEngine.ts
// never needs to know a single Panda-generated class name.
//
// Use of Color (WCAG 1.4.1): NO answerType may signal correctness by tint
// alone. Every per-row/field/tile pass/fail state therefore ships three
// things together — the color tint, an aria-hidden ✓/✕ glyph span, and a
// visually-hidden "— correct"/"— incorrect" span (`srOnlyCss`) that puts
// the same verdict in the accessibility tree. drillEngine.ts's own
// `setRowStatus()` writes the latter two; keep any new answerType on that
// same three-part shape rather than adding a color-only state.
import { css } from 'styled-system/css';

interface DrillEngineFirstQuestion {
  prompt: string;
  answerType: 'text' | 'choice' | 'construct' | 'subnet' | 'extract' | 'match' | 'sequence';
  choices?: string[];
  /** Any answerType — a longer artifact (a raw log excerpt, etc.) shown verbatim above the answer area, currently used by 'extract'. */
  artifact?: string;
  /** 'construct'/'subnet' — rendered server-side as a real, labeled test-case list (no-JS contract). */
  testCases?: { text: string; shouldMatch: boolean }[];
  /** 'subnet' only — the CIDR block the builder opens on, also pre-filled into the server-rendered text input so a no-JS visitor starts from a concrete block. */
  subnetStart?: string;
  /** 'extract' only — one labeled blank per field, rendered server-side (no-JS contract). */
  fields?: { label: string; correctValue: string }[];
  /** 'match' only — the items to sort, rendered server-side as static rows (no-JS contract). */
  matchItems?: { text: string; correctCategory: string }[];
  /** 'match' only — the fixed category buttons offered per item row. */
  matchCategories?: string[];
  /** 'sequence' only — the shuffled tiles, rendered server-side in the pool (no-JS contract; reordering itself needs JS). */
  sequenceItems?: string[];
  /** Optional, any answerType — rendered behind a "Show hint" toggle when set. */
  hint?: string;
}

interface Props {
  /** data-drill value — the client script's `config.root` selector target, e.g. "regex". */
  drill: string;
  /** Widget heading, e.g. "RegEx Range Drill". */
  heading: string;
  /** Optional one/two-sentence blurb under the heading. */
  intro?: string;
  /** Total question count, for the "Question 1 of N" progress readout. */
  totalQuestions: number;
  /** The calling page's own `nextQuestion(0)`, rendered server-side so a no-JS visitor sees real content. */
  firstQuestion: DrillEngineFirstQuestion;
}

const { drill, heading, intro, totalQuestions, firstQuestion } = Astro.props;
const isChoice = firstQuestion.answerType === 'choice';
const isConstruct = firstQuestion.answerType === 'construct';
const isSubnet = firstQuestion.answerType === 'subnet';
const isExtract = firstQuestion.answerType === 'extract';
const isMatch = firstQuestion.answerType === 'match';
const isSequence = firstQuestion.answerType === 'sequence';

const rootCss = css({ display: 'flex', flexDirection: 'column' });
const headCss = css({ mb: '1.25rem' });
const headingCss = css({ fontSize: '1.4rem', fontWeight: 700, color: 'text', m: 0 });
const introCss = css({ color: 'textMuted', fontSize: '0.95rem', mt: '0.4rem', mb: 0, maxW: '560px' });
const progressCss = css({ fontFamily: 'sans', fontSize: '0.85rem', color: 'textMuted', mb: '1rem' });
const cardCss = css({ bg: 'bgCard', border: '1px solid token(colors.border)', borderRadius: 'lg', p: { base: '1rem', sm: '1.35rem' } });
const promptCss = css({ fontSize: '1.05rem', fontWeight: 600, color: 'text', lineHeight: 1.5, m: 0 });
const answerCss = css({ mt: '0.9rem' });
const choicesCss = css({ display: 'flex', flexDirection: 'column', gap: '0.4rem' });

const choiceBtnCss = css({
  display: 'block',
  width: '100%',
  textAlign: 'left',
  fontFamily: 'sans',
  fontSize: '0.9rem',
  fontWeight: 500,
  color: 'text',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  px: '0.85rem',
  py: '0.6rem',
  cursor: 'pointer',
  transition: 'all 150ms ease',
  _hover: { borderColor: 'primary', color: 'primary' },
  _disabled: { cursor: 'not-allowed' },
  '&:disabled:not([data-correct]):not([data-incorrect])': { opacity: 0.5 },
  '&[data-correct]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 12%, transparent)' },
  // The `danger` semantic token (per-palette, contrast-checked) — never the
  // raw `red` keyword this used to use, which sat outside the theme system
  // entirely and couldn't be tuned per palette. Note every incorrect/fail
  // state below ALSO carries a ✓/✕ glyph plus visually-hidden text, so the
  // signal never depends on color alone (WCAG 1.4.1).
  '&[data-incorrect]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 10%, transparent)' },
});

// Shared visually-hidden helper — the same recipe Search.astro uses for its
// own live-region count. Used here to expose each per-row/tile pass/fail
// state as real text, so the ✓/✕ glyph and the color tint aren't the only
// carriers of "correct"/"incorrect".
const srOnlyCss = css({
  position: 'absolute',
  w: '1px',
  h: '1px',
  p: 0,
  m: '-1px',
  overflow: 'hidden',
  whiteSpace: 'nowrap',
  border: 0,
  clipPath: 'inset(50%)',
});

const textInputCss = css({
  width: '100%',
  fontFamily: 'mono',
  fontSize: '0.95rem',
  color: 'text',
  bg: 'bgCard',
  border: '1px solid token(colors.borderStrong)',
  borderRadius: 'md',
  px: '0.75rem',
  py: '0.55rem',
  transition: 'border-color 150ms ease',
  _focus: { outline: 'none', borderColor: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.7 },
  '&::placeholder': { color: 'textMuted', opacity: 0.7 },
});

// 'construct' (golf-style) test-case list — each row shows the sample
// string, whether it should or shouldn't match, and (once Checked) a
// pass/fail state. `data-state` starts "pending" (neutral — not checked
// yet) server-side and JS re-sets it to "pass"/"fail" per row on every
// Check click; never "correct"/"incorrect" like feedbackCss above, kept as
// a distinct vocabulary since a row's pass/fail is per-test-case, not the
// whole question's outcome.
const testCaseListCss = css({ display: 'flex', flexDirection: 'column', gap: '0.35rem', mt: '0.75rem', listStyle: 'none', p: 0, m: 0 });
const testCaseRowCss = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.55rem',
  fontSize: '0.85rem',
  px: '0.6rem',
  py: '0.4rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  bg: 'bgSubtle',
  '&[data-state="pass"]': { borderColor: 'accent', bg: 'color-mix(in srgb, token(colors.accent) 10%, transparent)' },
  '&[data-state="fail"]': { borderColor: 'danger', bg: 'color-mix(in srgb, token(colors.danger) 8%, transparent)' },
});
const testCaseIconCss = css({
  flexShrink: 0,
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '16px',
  h: '16px',
  borderRadius: 'full',
  fontSize: '0.7rem',
  lineHeight: 1,
  color: 'textMuted',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  // Empty by default (pending) — JS sets textContent to a check/x glyph
  // once a row has a real pass/fail state; CSS alone can't express "show a
  // ✓ glyph" without embedding it as content here too, so the row's own
  // data-state additionally recolors this ring for a belt-and-suspenders
  // signal that doesn't rely on the glyph alone (color-blind friendly).
  '[data-state="pass"] &': { borderColor: 'accent', color: 'accent' },
  '[data-state="fail"] &': { borderColor: 'danger', color: 'danger' },
});
const testCaseTextCss = css({ fontFamily: 'mono', fontSize: '0.85rem', color: 'text', wordBreak: 'break-all' });
const testCaseLabelCss = css({ fontFamily: 'sans', fontSize: '0.75rem', color: 'textMuted', ml: 'auto', flexShrink: 0, whiteSpace: 'nowrap' });

// 'subnet' — the interactive CIDR builder. Four octet controls + a prefix
// slider drive a live readout (network/broadcast/netmask/host range/host
// count) and the same containment list 'construct' uses. Every control here
// is JS-mounted (see this file's header comment on why the server render
// deliberately stops at the plain text input), so drillEngine.ts clones the
// whole block from `data-drill-subnet-template` below rather than building
// it with class-name strings.
//
// Each octet gets BOTH a number field and a slider on purpose: a 0-255
// slider is ~2 values per pixel on a phone-width track, so it's fine for
// sweeping a block around but can't reliably land on .64 — the number field
// is there for exact entry, the slider for feeling how the block moves. The
// prefix is slider-only: 33 stops, and "drag left for a bigger block" IS the
// mental model the drill is teaching, with a live /nn readout beside it.
// Nothing here animates, so there's no reduced-motion state to settle and no
// transition for a rapid click to land mid-flight (invariant 12) — the
// controls just write values.
const subnetBuilderCss = css({
  display: 'flex',
  flexDirection: 'column',
  gap: '0.85rem',
  p: '0.85rem',
  mt: '0.15rem',
  mb: '0.75rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  bg: 'bgSubtle',
});
const subnetOctetsCss = css({ display: 'grid', gridTemplateColumns: 'repeat(4, minmax(0, 1fr))', gap: '0.5rem' });
const subnetFieldCss = css({ display: 'flex', flexDirection: 'column', gap: '0.3rem', minW: 0 });
const subnetFieldLabelCss = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 600,
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  color: 'textMuted',
});
const subnetNumberCss = css({
  width: '100%',
  minW: 0,
  fontFamily: 'mono',
  fontSize: '0.9rem',
  textAlign: 'center',
  color: 'text',
  bg: 'bgCard',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  px: '0.35rem',
  py: '0.35rem',
  transition: 'border-color 150ms ease',
  _focus: { outline: 'none', borderColor: 'primary' },
  _disabled: { cursor: 'not-allowed', opacity: 0.7 },
});
const subnetRangeCss = css({
  width: '100%',
  minW: 0,
  // A real Panda colors-category utility (preset-base `interactivity`), so
  // the bare token name resolves — this is what tints the native range
  // thumb/track per palette without any hand-rolled slider styling.
  accentColor: 'primary',
  cursor: 'pointer',
  _disabled: { cursor: 'not-allowed', opacity: 0.6 },
});
const subnetPrefixRowCss = css({ display: 'flex', alignItems: 'center', gap: '0.75rem', flexWrap: 'wrap' });
const subnetPrefixLabelCss = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 600,
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  color: 'textMuted',
  flexShrink: 0,
});
const subnetPrefixValueCss = css({ fontFamily: 'mono', fontSize: '0.95rem', fontWeight: 700, color: 'primary', minW: '2.75rem', flexShrink: 0 });
const subnetPrefixSliderWrapCss = css({ flex: '1 1 180px', minW: '140px', display: 'flex' });
const subnetReadoutCss = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 148px), 1fr))',
  gap: '0.5rem',
  m: 0,
  pt: '0.75rem',
  borderTop: '1px solid token(colors.border)',
});
const subnetReadoutItemCss = css({ display: 'flex', flexDirection: 'column', gap: '0.15rem', minW: 0 });
const subnetReadoutKeyCss = css({
  fontFamily: 'sans',
  fontSize: '0.66rem',
  fontWeight: 600,
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  color: 'textMuted',
  m: 0,
});
const subnetReadoutValCss = css({ fontFamily: 'mono', fontSize: '0.85rem', color: 'text', m: 0, wordBreak: 'break-all' });
const subnetNoteCss = css({ fontSize: '0.8rem', color: 'textMuted', lineHeight: 1.5, m: 0, '&[hidden]': { display: 'none' } });
const subnetInputLabelCss = css({ fontFamily: 'sans', fontSize: '0.8rem', color: 'textMuted', display: 'block', mb: '0.3rem' });

// A longer artifact (a raw log excerpt, etc.) shown verbatim above the
// answer area — currently only 'extract' questions use it, but any
// answerType can set DrillQuestion.artifact.
const artifactCss = css({
  fontFamily: 'mono',
  fontSize: '0.82rem',
  lineHeight: 1.6,
  color: 'text',
  bg: 'bgSubtle',
  border: '1px solid token(colors.borderStrong)',
  borderRadius: 'md',
  p: '0.75rem 0.9rem',
  mt: '0.75rem',
