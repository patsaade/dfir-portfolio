---
// Back-to-top control — fixed bottom-right. Zero JavaScript: it is a plain
// in-page anchor to `#top` (the HTML spec's own "top of the document"
// fragment, honoured case-insensitively when no element carries that id — no
// element on this site does), and the scroll it performs is smooth via
// global.css's `html { scroll-behavior: smooth }`, which that file already
// downgrades to `auto` under `prefers-reduced-motion: reduce`.
//
// The reveal-on-scroll is CSS too: global.css runs a scroll-driven animation
// (`animation-timeline: scroll(root)`) that fades/rises it in across 480–560px
// of page scroll, replacing the `scroll` listener this component used to add on
// every page. That listener ran on every scroll frame of every page purely to
// toggle one attribute.
//
// The styles below are therefore the button's VISIBLE state, not a hidden start
// state — deliberately. Browsers without scroll-driven animations (and every
// reduced-motion visitor) get a permanently visible control rather than one
// that never appears: this is a navigation affordance, so failing open is the
// only acceptable direction. It also means there is no JS-armed hidden state to
// regress, so a no-JS visitor now gets a *working* control where they
// previously got none at all.
import { css } from 'styled-system/css';
import Icon from './Icon.astro';

const btnCls = css({
  position: 'fixed',
  right: '1.25rem',
  bottom: '1.25rem',
  zIndex: 40,
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '44px',
  h: '44px',
  borderRadius: 'full',
  bg: 'primary',
  color: 'onPrimary',
  border: 'none',
  boxShadow: 'cardHover',
  cursor: 'pointer',
  textDecoration: 'none',
  transition: 'background 200ms ease',
  _hover: { bg: 'primaryHover' },
});
---

<a
  href="#top"
  id="back-to-top"
  class={btnCls}
  title="Back to top"
  aria-label="Back to top"
  data-sound="tick"
>
  <Icon name="arrow-up" size={20} strokeWidth={2.5} />
</a>
