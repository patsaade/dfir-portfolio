        // between) must not write centerY's untouched init value of 0 —
        // that would silently jam the rail under the header on the *next*
        // page load, with no visible link back to the stray click that
        // caused it.
        if (positioned) {
          try {
            localStorage.setItem(POSITION_KEY, String(centerY / window.innerHeight));
          } catch (err) {}
        }
      }

      dragHandleEl.addEventListener('pointerdown', function (e) {
        if (dragPointerId !== null) return; // ignore a second pointer while one drag is already active
        if (e.button !== undefined && e.button !== 0) return; // primary button/touch/pen only
        dragPointerId = e.pointerId;
        dragStartY = e.clientY;
        dragStartCenterY = currentCenterY();
        try {
          dragHandleEl.setPointerCapture(dragPointerId);
        } catch (err) {}
        document.addEventListener('pointermove', onDragPointerMove);
        document.addEventListener('pointerup', endDrag);
        document.addEventListener('pointercancel', endDrag);
        // Matches the handle's own `cursor: grabbing` (see dragHandle's CSS)
        // even if the pointer strays outside the handle mid-drag, and stops
        // the rest of the page from selecting text while dragging across it.
        document.body.style.cursor = 'grabbing';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });

      // Double-click/double-tap recenters — the drag equivalent of every
      // other stateful control on this site having a "back to default" path.
      dragHandleEl.addEventListener('dblclick', function () {
        withTopTransition(resetPosition);
      });

      // Keyboard equivalent for the same move: arrow keys nudge (Shift for a
      // bigger jump), Home recenters. Both animate briefly via
      // withTopTransition — unlike the live drag above, each keypress is one
      // discrete change, so a short settle transition reads as intentional
      // feedback rather than as lag.
      dragHandleEl.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
          e.preventDefault();
          var step = e.shiftKey ? 80 : 20;
          var delta = e.key === 'ArrowUp' ? -step : step;
          withTopTransition(function () {
            setCenterY(currentCenterY() + delta, true);
          });
        } else if (e.key === 'Home') {
          e.preventDefault();
          withTopTransition(resetPosition);
        }
      });
    }
  })();
</script>
