---
// Loader for the opt-in interface-sound feature. Sound is OFF by default, so
// the Web Audio synth itself (window.__sound, the cue palette, the delegated
// pointerdown/click listeners) now lives in src/scripts/soundEngine.ts and is
// pulled in via a dynamic import() — its own chunk, fetched only when it will
// actually be used. On a default (sound-off) page load nothing but the tiny
// loader below ships, which is the entire point: the engine was ~1 KB gzipped
// of always-shipped code for a feature almost every visitor leaves off.
//
// What stays eager here is only: read the stored preference, and expose
// window.__soundLoad() so the nav's SoundToggle can pull the engine in on
// demand. If the preference is already 'on' the engine is requested straight
// away, so a returning sound-on visitor is in exactly the state they were
// before — the engine's own `if (window.__sound) return;` guard makes a late
// (or duplicated) init safe, and every other consumer (SoundToggle,
// HoverCards, Search) already guards its calls with `if (window.__sound)`.
//
// No-JS / import-failure: window.__sound simply never exists, every consumer's
// guard short-circuits, and the site is silent — the same state a visitor who
// never enables sound is already in. Nothing else degrades.
---

<script>
  // @ts-nocheck — vanilla DOM client script
  (function () {
    if (window.__soundLoad) return;
    var loading = null;
    // Fetch + initialise the engine chunk, once. Returns a promise that settles
    // after window.__sound exists (or, on a failed fetch, after the failure —
    // callers must still null-check, same as every other consumer). A rejected
    // load clears the cache so a later click can retry rather than being stuck.
    function load() {
      if (!loading) {
        loading = import('../scripts/soundEngine')
          .then(function (m) { m.initSound(); })
          .catch(function () { loading = null; });
      }
      return loading;
    }
    window.__soundLoad = load;

    var on = false;
    try { on = localStorage.getItem('sound') === 'on'; } catch (e) {}
    if (on) load();
  })();
</script>
