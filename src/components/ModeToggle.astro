---
import { css } from 'styled-system/css';
import Icon from './Icon.astro';

// Standalone light/dark/system switch. Reads & writes the shared theme
// controller (window.__theme) and re-syncs on the global `themechange` event,
// so it stays in lockstep with the palette picker.
const modes = [
  { id: 'system', label: 'System theme', icon: 'monitor' as const },
  { id: 'light', label: 'Light mode', icon: 'sun' as const },
  { id: 'dark', label: 'Dark mode', icon: 'moon' as const },
];

const segBtn = css({
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  w: '30px',
  h: '30px',
  borderRadius: 'sm',
  border: '1px solid transparent',
  bg: 'transparent',
  color: 'textMuted',
  cursor: 'pointer',
  transition: 'all 150ms ease',
  _hover: { color: 'text', transform: 'translateY(-1px)' },
  '&[data-active]': {
    bg: 'bgCard',
    color: 'primary',
    borderColor: 'border',
    boxShadow: 'card',
  },
  // Once AnimatedSwitch arms a sliding thumb underneath (see
  // animatedSwitch.ts), that thumb takes over rendering the bg/border/shadow.
  // The redundant per-button copy is suppressed by a hand-written global CSS
  // rule instead of a Panda condition here — see motion.css's
  // "switch-armed suppression" rule for why: the natural way to express this
  // in Panda, `{'[data-switch-armed] &': {'&[data-active]': {...}}}`, does
  // NOT compile to a real `[data-switch-armed] .btn[data-active]` compound
  // selector (confirmed by inspecting the compiled CSS) — it collapses to
  // plain `.btn[data-active]`, identical specificity to the rule above and
  // later in the stylesheet, so it unconditionally won regardless of
  // whether the group was actually armed. A literal single-string selector
  // (`'[data-switch-armed] &[data-active]'`) isn't accepted either — Panda's
  // types only allow `&` at the very start or end of a custom selector, not
  // followed by more selector text. The active *color* still stays: a
  // plain, non-moving text/icon tint layered on top of the thumb is fine,
  // only bg/border/shadow are suppressed.
});
---

<div
  role="radiogroup"
  aria-label="Color mode"
  data-mode-toggle
  class={css({
    position: 'relative', // containing block + stacking context for the animated switch thumb (see AnimatedSwitch)
    zIndex: 0,
    display: 'inline-flex',
    gap: '0.15rem',
    // 34px total to match the other three nav controls: 30px segments + 2x1px
    // padding + 2x1px border. It was `p: 0.2rem` (38.4px), which left this and
    // the theme picker sitting ~4px taller than search and sound.
    p: '1px',
    h: '34px',
    bg: 'bgSubtle',
    border: '1px solid token(colors.border)',
    borderRadius: 'md',
  })}
>
  {
    modes.map((m) => (
      <button type="button" role="radio" aria-checked="false" aria-label={m.label} title={m.label} class={segBtn} data-mode-pref={m.id}>
        <Icon name={m.icon} size={15} />
      </button>
    ))
  }
</div>

<script>
  // @ts-nocheck — vanilla DOM client script
  (function () {
    var root = document.querySelector('[data-mode-toggle]');
    if (!root || !window.__theme) return;
    var btns = Array.prototype.slice.call(root.querySelectorAll('[data-mode-pref]'));

    function sync() {
      var mode = window.__theme.getMode();
      btns.forEach(function (b) {
        var active = b.getAttribute('data-mode-pref') === mode;
        if (active) b.setAttribute('data-active', '');
        else b.removeAttribute('data-active');
        b.setAttribute('aria-checked', active ? 'true' : 'false');
      });
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        window.__theme.setMode(b.getAttribute('data-mode-pref'));
      });
    });

    document.addEventListener('themechange', sync);
    sync();
  })();
</script>
