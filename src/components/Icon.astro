---
// Icon set (lucide-style, stroke-based, currentColor). Renders at build time —
// no client JS, no dependency.
//
// The geometry lives in src/data/icons.ts and is served ONCE per visitor as an
// external sprite (/icons.svg, built by src/pages/icons.svg.ts); each call site
// emits only a <use> reference. That's ~3,916 B brotli off every page versus
// inlining the bodies 110-700 times — see src/utils/iconSprite.ts for the
// measurement and the caching contract.
//
// ⚠ The five paint attributes below (fill, stroke, stroke-width,
// stroke-linecap, stroke-linejoin) MUST stay on this host <svg> and MUST NOT be
// copied into the sprite's <symbol> elements. A presentation attribute inside
// the referenced document beats what the host inherits down, which would break
// every per-call-site override — including the 7 `star` sites that pass
// strokeWidth={0} plus a CSS `fill` to turn a stroked outline into a solid
// accent glyph. test/iconSprite.test.ts guards this.
import { type IconName } from '../data/icons';
import { iconHref } from '../utils/iconSprite';

// Re-exported so the ~17 existing `import type { IconName } from
// '.../Icon.astro'` call sites (consts.ts, tools.ts, certifications.ts,
// securityTerms.ts, threatActorNaming.ts, Badge/DomainHub/FilterBar/FilterToggle
// and 8 reference pages) keep working unchanged.
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string; // when set, icon is exposed to a11y tree; otherwise hidden
}

const { name, size = 18, strokeWidth = 2, class: className, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}><use href={iconHref(name)}></use></svg
>
