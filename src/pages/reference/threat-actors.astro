---
// Threat Actor / APT Reference — every group MITRE ATT&CK tracks (generated
// from the Enterprise STIX bundle, src/data/threatActors.ts), searchable by
// name, alias, or MITRE group id. Same "grouped, searchable list" family as
// the Tool Catalog / Event ID Reference, but flatter: MITRE's own group data
// carries no natural sub-taxonomy to bucket into collapsible sections the way
// event-ids.astro's Security/Sysmon split does, so this is one flat
// card-grid — closer to Blog/Labs' shape than the ATT&CK map's. Each card
// links to its own detail page (/reference/threat-actors/[id]/).
export const prerender = true;
import { css } from 'styled-system/css';
import { tag, card } from 'styled-system/recipes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import Term from '../../components/Term.astro';
import TagCombobox from '../../components/TagCombobox.astro';
import FilterToggle from '../../components/FilterToggle.astro';
import ListFilter from '../../components/ListFilter.astro';
import { THREAT_ACTORS, THREAT_ACTORS_TOTAL, THREAT_ACTORS_ATTACK_VERSION, threatActorSlug } from '../../data/threatActors';
import { VENDOR_NAMING_SCHEMES, WHY_MANY_NAMES } from '../../data/threatActorNaming';

// Alphabetical by name for browsing — the dataset itself stays sorted by MITRE
// group id (G0001, G0002, …), which the detail page's prev/next still follows;
// this is purely a display-order choice for the index grid, same as sorting a
// copy rather than mutating the shared array.
const actors = [...THREAT_ACTORS].sort((a, b) => a.name.localeCompare(b.name));
const total = THREAT_ACTORS_TOTAL;
const softwareCount = THREAT_ACTORS.filter((a) => a.software.length > 0).length;

// "Naming conventions" section — grounds VENDOR_NAMING_SCHEMES (verified
// vendor taxonomy, see threatActorNaming.ts) in four of THIS SITE'S OWN
// tracked groups, so the explainer isn't just abstract vendor trivia. Every
// alias cited below is checked against that group's own real
// THREAT_ACTORS[].aliases at build time (mustHaveAlias throws if one doesn't
// match — same fail-fast discipline as threatActorsDrill.ts's mustGetActor)
// rather than trusted as typed — a typo here would otherwise silently show a
// fabricated alias next to a real group.
interface NamingExampleNote {
  label: string;
  /** A real alias (or "A / B" for two aliases from the same vendor) — verified against the group's own aliases[] below. */
  alias: string;
}
interface NamingExample {
  groupId: string;
  caption: string;
  notes: NamingExampleNote[];
}
function mustGetActorForExample(groupId: string) {
  const a = THREAT_ACTORS.find((x) => x.id === groupId);
  if (!a) throw new Error(`Naming conventions example: unknown group id "${groupId}"`);
  return a;
}
function mustHaveAlias(actorName: string, aliases: string[], alias: string) {
  for (const part of alias.split(' / ')) {
    if (!aliases.includes(part)) {
      throw new Error(`Naming conventions example: "${part}" is not a real alias of ${actorName} — check threat-actors.astro's NAMING_EXAMPLES against threat-actors.generated.ts`);
    }
  }
}
const NAMING_EXAMPLES: NamingExample[] = [
  {
    groupId: 'G0016',
    caption: "The richest example on this site: one Russia-attributed (SVR) group, five unrelated vendor grammars, all on one MITRE page.",
    notes: [
      { label: 'CrowdStrike', alias: 'Cozy Bear' },
      { label: 'Microsoft (2023+)', alias: 'Midnight Blizzard' },
      { label: 'Microsoft (legacy, pre-2023)', alias: 'NOBELIUM' },
      { label: "Mandiant's original cluster", alias: 'UNC2452' },
      { label: 'Secureworks', alias: 'IRON RITUAL / IRON HEMLOCK' },
    ],
  },
  {
    groupId: 'G0007',
    caption: 'A group can carry a vendor\'s OLD scheme and its NEW scheme at once — not just names from different vendors.',
    notes: [
      { label: 'CrowdStrike', alias: 'Fancy Bear' },
      { label: 'Microsoft (legacy, pre-2023)', alias: 'STRONTIUM' },
      { label: 'Microsoft (2023+)', alias: 'Forest Blizzard' },
      { label: 'Secureworks', alias: 'IRON TWILIGHT' },
      { label: 'Trend Micro (independently coined, not one of the schemes above)', alias: 'Pawn Storm' },
    ],
  },
  {
    groupId: 'G1015',
    caption: "A currently-active group still visibly mid-convergence. MITRE's own canonical name here follows CrowdStrike's animal-cryptonym pattern (Spider = eCrime) even though it's the primary name, not an alias.",
    notes: [
      { label: "Mandiant's original uncategorized cluster", alias: 'UNC3944' },
      { label: 'Microsoft (temporary, before promotion)', alias: 'Storm-0875' },
      { label: 'Microsoft (promoted to a permanent name)', alias: 'Octo Tempest' },
    ],
  },
  {
    groupId: 'G0046',
    caption: "Naming convergence isn't only about nation-state attribution — financially-motivated activity has its own cross-vendor vocabulary too.",
    notes: [
      { label: 'CrowdStrike', alias: 'Carbon Spider' },
      { label: 'Microsoft', alias: 'Sangria Tempest' },
      { label: 'Secureworks', alias: 'GOLD NIAGARA' },
      { label: "Mandiant's internal codename", alias: 'ELBRUS' },
    ],
  },
];
const namingExamples = NAMING_EXAMPLES.map((ex) => {
  const actor = mustGetActorForExample(ex.groupId);
  for (const note of ex.notes) mustHaveAlias(actor.name, actor.aliases, note.alias);
  return { ...ex, actor };
});

const statLink = css({ color: 'primary', display: 'inline-flex', alignItems: 'center', gap: '0.3rem', _hover: { textDecoration: 'underline' } });
const filterRow = css({ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap', mb: '0.75rem' });
const grid = css({ mt: '1rem' });
const actorCard = `${card()} ${css({
  transition: 'border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease',
  _hover: { boxShadow: 'card', '& .actor-go': { transform: 'translateX(2px)', color: 'primary' } },
})}`;
const actorTop = css({ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '0.5rem' });
const actorIdBadge = css({ fontFamily: 'mono', fontWeight: 700, fontSize: '0.75rem', color: 'primary', flexShrink: 0 });
const goCls = css({ color: 'textMuted', flexShrink: 0, transition: 'transform 200ms ease, color 200ms ease' });
const actorName = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.95rem', color: 'text', lineHeight: 1.3 });
// Fixed single-line height regardless of whether a group has aliases, so a
// card with zero aliases doesn't render shorter than its .card-grid siblings
// (see STYLE_GUIDE.md's card-size rule — a grid row stretches to its tallest
// cell, so uneven card content drags the row's white space with it).
const aliasRow = css({
  color: 'textMuted',
  fontSize: '0.78rem',
  lineHeight: 1.4,
  minH: '1.1rem',
  overflow: 'hidden',
  textOverflow: 'ellipsis',
  whiteSpace: 'nowrap',
});
const tagRow = css({ display: 'flex', flexWrap: 'wrap', gap: '0.3rem', mt: 'auto', pt: '0.15rem' });

// "Naming conventions" section — same sectionH2/collapsible-card idiom as
// the DFIR Command Cheat Sheet / Regex Syntax Cheat Sheet, plus a real
// <table> (not a card grid) for the code -> meaning mappings, matching the
// IP & CIDR Reference's own CIDR quick-reference table for exactly this
// "short code, short meaning" shape of data.
const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  scrollMarginTop: '90px',
});
const schemeGrid = css({ display: 'flex', flexDirection: 'column', gap: '1rem', mb: '1.5rem' });
const schemeCard = css({ p: '1rem 1.25rem', bg: 'bgCard', border: '1px solid token(colors.border)', borderRadius: 'md' });
const schemeHead = css({ display: 'flex', alignItems: 'center', gap: '0.5rem', fontSize: '1.05rem', fontWeight: 700, color: 'text', m: 0 });
const schemeExplain = css({ color: 'textMuted', fontSize: '0.9rem', lineHeight: 1.7, mt: '0.6rem', mb: 0 });
const mapTableWrap = css({ maxH: '16rem', overflowY: 'auto', overflowX: 'auto', mt: '0.85rem', border: '1px solid token(colors.border)', borderRadius: 'md' });
const mapTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.82rem' });
const mapTh = css({
  position: 'sticky',
  top: 0,
  textAlign: 'left',
  color: 'textMuted',
  fontFamily: 'sans',
  fontWeight: 600,
  fontSize: '0.68rem',
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  bg: 'bgCard',
  p: '0.45rem 0.65rem',
  borderBottom: '1px solid token(colors.border)',
});
const mapTdCode = css({ fontFamily: 'mono', fontWeight: 700, fontSize: '0.82rem', color: 'primary', p: '0.4rem 0.65rem', borderBottom: '1px solid token(colors.border)', whiteSpace: 'nowrap' });
const mapTdMeaning = css({ fontFamily: 'sans', fontSize: '0.82rem', color: 'text', p: '0.4rem 0.65rem', borderBottom: '1px solid token(colors.border)' });
const schemeSourceLink = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.3rem',
  fontSize: '0.78rem',
  fontWeight: 600,
  color: 'primary',
  mt: '0.75rem',
  _hover: { textDecoration: 'underline' },
});
const exampleGrid = css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(2, 1fr)' }, gap: '1rem', mb: '1.5rem' });
const exampleCard = `${card()} ${css({ gap: '0.5rem' })}`;
const exampleHead = css({ display: 'flex', alignItems: 'center', gap: '0.5rem', flexWrap: 'wrap' });
const exampleName = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.95rem', color: 'text' });
const exampleCaption = css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.6, m: 0 });
const exampleAliasRow = css({ display: 'flex', flexDirection: 'column', gap: '0.3rem', mt: '0.3rem' });
const exampleAliasLine = css({ display: 'flex', gap: '0.4rem', alignItems: 'baseline', fontSize: '0.8rem', flexWrap: 'wrap' });
const exampleAliasLabel = css({ color: 'textMuted', flexShrink: 0 });
const exampleAliasValue = css({ fontFamily: 'mono', fontWeight: 700, color: 'primary' });
---

<BaseLayout
  title="Threat Actor / APT Reference"
  description="Every threat actor group MITRE ATT&CK tracks — names, aliases, documented techniques, and malware/tools — generated from MITRE's official Enterprise ATT&CK dataset."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Reference', href: '/reference/' }, { label: 'Threat Actor / APT Reference' }]}
    eyebrow="Frameworks"
    title="Threat Actor / APT Reference"
    description={`${total} threat actor groups tracked by MITRE ATT&CK — names, known aliases, documented techniques, and the malware/tools each is reported using.`}
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      MITRE ATT&CK tracks <strong class={css({ color: 'text' })}>groups</strong> — activity clusters the
      security community follows under a common name, whether attributed to a specific nation-state or
      criminal organization or tracked only by shared tradecraft. Multiple <em>aliases</em> per group are
      normal: different vendors often name the same observed activity independently before{' '}
      <Term slug="attribution">attribution</Term> converges (e.g. APT28 / Fancy Bear / Sofacy / Sednit all refer to the same tracked group).
    </p>
  </aside>

  {/* ── Naming conventions: why one group has so many names ── */}
  <h2 id="naming-conventions" class={sectionH2}>
    <Icon name="tag" size={20} class={css({ color: 'primary' })} /> Naming conventions: why one group has so many names
  </h2>

  <p class={css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1.5rem' })}>{WHY_MANY_NAMES}</p>

  <div class={schemeGrid}>
    {
      VENDOR_NAMING_SCHEMES.map((scheme) => (
        <div class={schemeCard}>
          <h3 class={schemeHead}>
            <Icon name={scheme.icon} size={17} class={css({ color: 'primary', flexShrink: 0 })} /> {scheme.vendor}
          </h3>
          <p class={schemeExplain}>{scheme.explanation}</p>
          <div class={mapTableWrap} tabindex="0" role="region" aria-label={`${scheme.vendor} naming scheme table`}>
            <table class={mapTable}>
              <thead>
                <tr>
                  <th class={mapTh}>Code</th>
                  <th class={mapTh}>Indicates</th>
                </tr>
              </thead>
              <tbody>
                {scheme.mappings.map((m) => (
                  <tr>
                    <td class={mapTdCode}>{m.code}</td>
                    <td class={mapTdMeaning}>{m.meaning}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <a href={scheme.sourceUrl} target="_blank" rel="noopener" class={schemeSourceLink}>
            <Icon name="external-link" size={12} /> {scheme.sourceLabel}
          </a>
        </div>
      ))
    }
  </div>

  <h3 class={css({ fontSize: '1.05rem', fontWeight: 700, color: 'text', mb: '0.85rem' })}>
    Seen on this reference: the same group, five vendor names
  </h3>
  <div class={exampleGrid}>
    {
      namingExamples.map((ex) => (
        <div class={exampleCard}>
          <div class={exampleHead}>
            <a href={`/reference/threat-actors/${threatActorSlug(ex.actor.name)}/`} class={css({ color: 'primary', _hover: { textDecoration: 'underline' } })}>
              <span class={exampleName}>{ex.actor.name}</span>
            </a>
            <span class={tag({ tone: 'muted', mono: true })}>{ex.actor.id}</span>
          </div>
          <p class={exampleCaption}>{ex.caption}</p>
          <div class={exampleAliasRow}>
            {ex.notes.map((n) => (
              <div class={exampleAliasLine}>
                <span class={exampleAliasLabel}>{n.label}:</span>
                <span class={exampleAliasValue}>{n.alias}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {/* Cross-link to where the technique/software links below actually lead */}
  <a
    href="/reference/attack-map/"
    class={css({
      display: 'flex',
      alignItems: 'center',
      gap: '0.6rem',
      mb: '1.5rem',
      p: '0.7rem 1rem',
      borderRadius: 'md',
      border: '1px solid token(colors.border)',
      bg: 'bgCard',
      fontSize: '0.9rem',
      color: 'text',
      transition: 'border-color 200ms ease, color 200ms ease',
      _hover: { borderColor: 'primary', color: 'primary', '& .x-arrow': { transform: 'translateX(3px)' } },
    })}
  >
    <Icon name="crosshair" size={16} class={css({ color: 'primary', flexShrink: 0 })} />
    <span>See every technique these groups map to — <strong class={css({ fontWeight: 700 })}>MITRE ATT&amp;CK Coverage Map</strong></span>
    <Icon name="arrow-right" size={15} class={`x-arrow ${css({ ml: 'auto', color: 'primary', flexShrink: 0, transition: 'transform 200ms ease' })}`} />
  </a>

  <a
    href="/drills/threat-actors/"
    class={css({
      display: 'flex',
      alignItems: 'center',
      gap: '0.6rem',
      mb: '1.5rem',
      p: '0.7rem 1rem',
      borderRadius: 'md',
      border: '1px solid token(colors.border)',
      bg: 'bgCard',
      fontSize: '0.9rem',
      color: 'text',
      transition: 'border-color 200ms ease, color 200ms ease',
      _hover: { borderColor: 'primary', color: 'primary', '& .x-arrow2': { transform: 'translateX(3px)' } },
    })}
  >
    <Icon name="user" size={16} class={css({ color: 'primary', flexShrink: 0 })} />
    <span>Practice recognizing groups and applying these naming conventions — <strong class={css({ fontWeight: 700 })}>Threat Actor / APT Drill</strong></span>
    <Icon name="arrow-right" size={15} class={`x-arrow2 ${css({ ml: 'auto', color: 'primary', flexShrink: 0, transition: 'transform 200ms ease' })}`} />
  </a>

  <div class={css({ mb: '0.6rem' })}>
    <TagCombobox
      id="actor-cb"
      options={[]}
      placeholder={`Search ${total} groups by name, alias, or MITRE id…`}
      label="Search threat actor groups"
    />
  </div>

  <div class={filterRow}>
    <p role="status" aria-live="polite" class={css({ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '0.3rem 0.6rem', color: 'textMuted', fontSize: '0.9rem', m: 0 })}>
      <span><span id="actor-result-count">{total}</span> threat actor groups</span>
      <span aria-hidden="true">·</span>
      <span>{softwareCount} with documented malware/tools</span>
      <span aria-hidden="true">·</span>
      <a href="https://attack.mitre.org/groups/" target="_blank" rel="noopener" class={statLink}>ATT&amp;CK v{THREAT_ACTORS_ATTACK_VERSION} <Icon name="external-link" size={12} /></a>
    </p>
    <div class={css({ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: '0.5rem', ml: { sm: 'auto' } })}>
      <FilterToggle id="actor-software-toggle" icon="wrench" label="Has documented tools" tone="primary" />
    </div>
  </div>

  <div class={`card-grid ${grid}`}>
    {
      actors.map((a) => {
        const slug = threatActorSlug(a.name);
        const techCount = a.techniquesTotal ?? a.techniques.length;
        return (
          <a
            href={`/reference/threat-actors/${slug}/`}
            class={actorCard}
            data-actor-card={`${a.id} ${a.name} ${a.aliases.join(' ')}`.toLowerCase()}
            {...(a.software.length > 0 ? { 'data-has-software': true } : {})}
          >
            <span class={actorTop}>
              <span class={actorIdBadge}>{a.id}</span>
              <Icon name="arrow-right" size={14} class={`actor-go ${goCls}`} />
            </span>
            <span class={actorName}>{a.name}</span>
            <span class={aliasRow} title={a.aliases.join(', ')}>
              {a.aliases.length > 0 ? `Also known as: ${a.aliases.join(', ')}` : ' '}
            </span>
            <span class={tagRow}>
              <span class={tag({ tone: 'primary' })}>{techCount} technique{techCount === 1 ? '' : 's'}</span>
              <span class={tag({ tone: 'muted' })}>{a.software.length} tool{a.software.length === 1 ? '' : 's'}</span>
            </span>
          </a>
        );
      })
    }
  </div>

  <p id="actor-empty" hidden role="status" aria-live="polite" class={css({ color: 'textMuted', textAlign: 'center', py: '3rem' })}>
    No threat actor groups match your search.
  </p>

  <p class={css({ fontSize: '0.78rem', color: 'textMuted', mt: '2.5rem', pt: '1.5rem', borderTop: '1px solid token(colors.border)', lineHeight: 1.6 })}>
    ATT&CK® and MITRE ATT&CK® are registered trademarks of The MITRE Corporation. Group names, aliases,
    and descriptions are drawn from the public ATT&CK knowledge base (v{THREAT_ACTORS_ATTACK_VERSION}); this
    reference links back to the canonical MITRE pages.
  </p>

  <ListFilter
    config={{
      comboboxId: 'actor-cb',
      cardSelector: '[data-actor-card]',
      searchAttr: 'data-actor-card',
      countId: 'actor-result-count',
      emptyId: 'actor-empty',
      toggles: [{ id: 'actor-software-toggle', attr: 'data-has-software' }],
      urlSync: { queryParam: 'q' },
    }}
  />
</BaseLayout>
