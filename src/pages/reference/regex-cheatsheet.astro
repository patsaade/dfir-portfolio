---
// Regex Syntax Cheat Sheet — a token-by-token reference for JavaScript/ECMAScript
// regex syntax (src/data/regexCheatSheet.ts's REGEX_CHEAT_SHEET), grouped by
// category, searchable by token/description/example. Distinct from the DFIR
// Regex Tester's own DFIR_REGEX_PATTERNS library: that's a curated set of
// ready-to-use whole patterns (IPv4, SID, GUID, ...); this is the underlying
// grammar those patterns (and any pattern you write yourself) are built from.
// Same structural pattern as the DFIR Command Cheat Sheet (cheatsheet.astro):
// PageHeader -> GroupOverview jump-strip -> TagCombobox search -> one
// collapsible <details> group per category -> ListFilter wiring. Static —
// prerendered.
export const prerender = true;
import { css } from 'styled-system/css';
import { card } from 'styled-system/recipes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import Term from '../../components/Term.astro';
import CollapseAll from '../../components/CollapseAll.astro';
import TagCombobox from '../../components/TagCombobox.astro';
import ListFilter from '../../components/ListFilter.astro';
import GroupOverview from '../../components/GroupOverview.astro';
import ExternalResources from '../../components/ExternalResources.astro';
import { EXTERNAL_RESOURCES } from '../../data/externalResources';
import { toolChip } from '../../components/RelatedTools.astro';
import { tagSlug } from '../../utils/posts';
import { REGEX_CHEAT_SHEET } from '../../data/regexCheatSheet';

// Icon + one-line blurb per category — purely presentational metadata, kept
// here (not in the data file) since regexCheatSheet.ts is meant to stay pure
// content. Keyed by the data file's own `category` strings, so a category
// typo'd or renamed there surfaces as a missing tile below rather than a
// silent mismatch.
const CATEGORY_META: Record<string, { icon: IconName; blurb: string }> = {
  'Anchors & Boundaries': { icon: 'map-pin', blurb: 'Positions in the string — start/end, line edges, and word boundaries — not characters themselves.' },
  'Character Classes': { icon: 'grid', blurb: 'What counts as a match at a single position: digits, word characters, custom sets, Unicode properties.' },
  Quantifiers: { icon: 'rotate-cw', blurb: 'How many times the preceding element repeats — greedy by default, with a lazy form of each.' },
  'Groups & Backreferences': { icon: 'layers', blurb: 'Group sub-patterns, capture what they matched, and refer back to that capture later in the pattern.' },
  'Lookaround (Lookahead/Lookbehind)': { icon: 'crosshair', blurb: "Assert what's immediately before or after a position without consuming those characters." },
  Flags: { icon: 'tag', blurb: 'Modifiers on the whole pattern — case sensitivity, multiline, global search, Unicode mode, and more.' },
  'Escape Sequences & Special Characters': { icon: 'hash', blurb: 'Literal characters that would otherwise be read as syntax, plus control-character escapes.' },
  'Replacement Patterns': { icon: 'arrow-left-right', blurb: 'Special tokens usable inside a .replace()/.replaceAll() replacement string.' },
  'RegExp Methods & Properties (JS API)': { icon: 'terminal', blurb: 'The RegExp and String methods that actually run a pattern against text.' },
};
const FALLBACK_META = { icon: 'list' as IconName, blurb: '' };

interface CategoryGroup {
  id: string;
  title: string;
  icon: IconName;
  blurb: string;
  entries: typeof REGEX_CHEAT_SHEET;
}

// Group entries by category, preserving first-occurrence order — the data
// file's own category order IS the pedagogical order (anchors -> character
// classes -> quantifiers -> groups -> lookaround -> flags -> escapes ->
// replacement patterns -> the RegExp/String API), so no separate ordering
// list is needed here.
const categories: CategoryGroup[] = [];
const byCategory = new Map<string, CategoryGroup>();
for (const entry of REGEX_CHEAT_SHEET) {
  let group = byCategory.get(entry.category);
  if (!group) {
    const meta = CATEGORY_META[entry.category] ?? FALLBACK_META;
    group = { id: `regexcheat-${tagSlug(entry.category)}`, title: entry.category, icon: meta.icon, blurb: meta.blurb, entries: [] };
    byCategory.set(entry.category, group);
    categories.push(group);
  }
  group.entries.push(entry);
}

const totalEntries = REGEX_CHEAT_SHEET.length;

const categoryTiles = categories.map((c) => ({ id: c.id, icon: c.icon, title: c.title, blurb: c.blurb, count: c.entries.length }));
const categoryOptions = categories.map((c) => ({ value: tagSlug(c.title), label: c.title, count: c.entries.length }));

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const entryCard = `${card()} ${css({ gap: '0.5rem' })}`;
const syntaxCode = css({
  display: 'inline-block',
  fontFamily: 'mono',
  fontSize: '0.95rem',
  fontWeight: 700,
  color: 'primary',
  bg: 'bgSubtle',
  border: '1px solid token(colors.border)',
  borderRadius: 'sm',
  px: '0.55rem',
  py: '0.15rem',
  wordBreak: 'break-word',
  alignSelf: 'flex-start',
});
const entryDesc = css({ fontSize: '0.88rem', color: 'text', lineHeight: 1.65, m: 0 });
const entryExample = css({
  display: 'flex',
  alignItems: 'flex-start',
  gap: '0.4rem',
  fontFamily: 'mono',
  fontSize: '0.8rem',
  color: 'textMuted',
  lineHeight: 1.6,
  wordBreak: 'break-word',
  pt: '0.45rem',
  borderTop: '1px dashed token(colors.border)',
  m: 0,
});
const entriesGrid = css({ display: 'flex', flexDirection: 'column', gap: '0.75rem' });

// Same collapsible-<details>-per-category idiom as the Command Cheat Sheet.
const groupDetails = css({ borderTop: '1px solid token(colors.border)', py: '1.25rem', scrollMarginTop: '90px' });
const groupSummary = css({
  cursor: 'pointer',
  listStyle: 'none',
  userSelect: 'none',
  '&::-webkit-details-marker': { display: 'none' },
  '&::marker': { display: 'none' },
  _hover: { '& .regexcheat-grp-title': { color: 'primary' } },
});
const chevCls = css({ color: 'textMuted', flexShrink: 0, transition: 'transform 200ms ease', 'details[open] &': { transform: 'rotate(90deg)' } });
const grpCount = css({ fontFamily: 'sans', fontSize: '0.68rem', fontWeight: 600, color: 'textMuted', bg: 'bgSubtle', border: '1px solid token(colors.border)', borderRadius: 'full', px: '0.5rem', py: '0.1rem' });

const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
---

<BaseLayout
  title="Regex Syntax Cheat Sheet"
  description={`A token-by-token reference for JavaScript/ECMAScript regex syntax — ${totalEntries} anchors, character classes, quantifiers, groups, lookaround, flags, escapes, replacement tokens, and RegExp/String methods, searchable and grouped by category.`}
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Reference', href: '/reference/' }, { label: 'Tool Catalog', href: '/reference/tool-catalog/' }, { label: 'Regex Syntax Cheat Sheet' }]}
    eyebrow="Reference"
    title="Regex Syntax Cheat Sheet"
    description={`${totalEntries} JavaScript/ECMAScript regex syntax tokens across ${categories.length} categories — anchors, character classes, quantifiers, groups, lookaround, flags, escapes, replacement patterns, and the RegExp/String API. Every entry is the underlying grammar; for ready-to-use whole patterns, see the Regex Tester's own pattern library.`}
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      This is <strong class={css({ color: 'text' })}>JavaScript/ECMAScript</strong> regex syntax specifically — the
      exact engine this site's own tools run (a plain <code class={css({ fontFamily: 'mono', color: 'primary' })}>new RegExp(pattern, flags)</code>,
      via <a href="/tools/regex-tester/" class={css({ color: 'primary' })}>the Regex Tester</a>'s own compile step),
      not PCRE, PCRE2, Python's <code class={css({ fontFamily: 'mono', color: 'primary' })}>re</code>, or POSIX
      BRE/ERE. Most of it will look familiar if you've used another flavor, but JavaScript deliberately has no
      possessive quantifiers, atomic groups, recursive patterns, backtracking-control verbs, Python-style{' '}
      <code class={css({ fontFamily: 'mono', color: 'primary' })}>(?P&lt;name&gt;...)</code> named groups, or an{' '}
      <code class={css({ fontFamily: 'mono', color: 'primary' })}>/x</code> verbose flag — there's nothing to list
      for those here because JavaScript simply doesn't have them. A pattern you write here behaves identically once
      pasted into <a href="/tools/regex-tester/" class={css({ color: 'primary' })}>the Regex Tester</a>, the{' '}
      <a href="/drills/regex/" class={css({ color: 'primary' })}>RegEx Range Drill</a>, or a{' '}
      <a href="/tools/sigma-tester/" class={css({ color: 'primary' })}>Sigma rule's</a>{' '}
      <code class={css({ fontFamily: 'mono', color: 'primary' })}>|re</code> field modifier — all four run the same
      compile step under the hood.
    </p>
  </aside>

  <GroupOverview items={categoryTiles} heading="Jump to category" />

  {/* Search + category filter (typeahead combobox) */}
  <div class={css({ mb: '0.6rem' })}>
    <TagCombobox
      id="regexcheat-cb"
      options={categoryOptions}
      placeholder={`Search ${totalEntries} syntax entries, or type a category…`}
      label="Search the regex cheat sheet or filter by category"
    />
  </div>

  <div class={css({ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap', mb: '0.75rem' })}>
    <p role="status" aria-live="polite" class={css({ color: 'textMuted', fontSize: '0.9rem', m: 0 })}>
      <span id="regexcheat-result-count">{totalEntries}</span> entries shown
    </p>
    <CollapseAll target="[data-regexcheat-group]" class={css({ ml: { sm: 'auto' } })} />
  </div>

  <p id="regexcheat-empty" hidden role="status" aria-live="polite" class={css({ color: 'textMuted', textAlign: 'center', py: '3rem' })}>
    No syntax entries match your search.
  </p>

  {
    categories.map((c) => (
      <details id={c.id} data-regexcheat-group open class={groupDetails}>
        <summary class={groupSummary}>
          <h2 class={sectionH2}>
            <Icon name="chevron-right" size={17} class={chevCls} />
            <Icon name={c.icon} size={20} class={css({ color: 'primary', flexShrink: 0 })} />
            <span class="regexcheat-grp-title">{c.title}</span>
            <span class={grpCount}>{c.entries.length}</span>
          </h2>
        </summary>
        <div class={entriesGrid}>
          {c.entries.map((e) => (
            <div
              class={entryCard}
              data-cat={tagSlug(c.title)}
              data-regexcheat-card={`${e.category} ${e.syntax} ${e.description} ${e.example}`.toLowerCase()}
            >
              <code class={syntaxCode}>{e.syntax}</code>
              <p class={entryDesc}>{e.description}</p>
              <p class={entryExample}>
                <Icon name="arrow-right" size={12} class={css({ flexShrink: 0, mt: '0.2rem' })} />
                <span>{e.example}</span>
              </p>
            </div>
          ))}
        </div>
      </details>
    ))
  }

  <h2 id="related" class={sectionH2}>
    <Icon name="wrench" size={20} class={css({ color: 'primary' })} /> Related tools
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/tools/regex-tester/" class={toolChip}>
        <Icon name="search" size={13} /> DFIR Regex Tester & Pattern Library <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Try any syntax token above against your own sample text live, with inline match highlighting and a
        capture-group breakdown — plus a curated library of ready-to-use DFIR patterns (IPv4, SID, GUID, hashes)
        built from this exact grammar.
      </p>
    </div>
    <div>
      <a href="/drills/regex/" class={toolChip}>
        <Icon name="target" size={13} /> RegEx Range Drill <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Practice writing patterns yourself — 11 progressive challenges, graded live by compiling and running your
        pattern against real test cases with the same engine as this reference.
      </p>
    </div>
    <div>
      <a href="/tools/sigma-tester/" class={toolChip}>
        <Icon name="target" size={13} /> Sigma Rule Tester <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        A <Term slug="sigma-rule">Sigma rule</Term>'s <code class={css({ fontFamily: 'mono', fontSize: '0.85rem', color: 'primary' })}>|re</code>{' '}
        field modifier runs on this exact same JavaScript regex engine — a pattern that behaves as expected here
        will behave identically once pasted into a rule.
      </p>
    </div>
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['regex-cheatsheet']} />

  <ListFilter
    config={{
      comboboxId: 'regexcheat-cb',
      cardSelector: '[data-regexcheat-card]',
      searchAttr: 'data-regexcheat-card',
      groupSelector: '[data-regexcheat-group]',
      countId: 'regexcheat-result-count',
      emptyId: 'regexcheat-empty',
      facetAttr: 'data-cat',
      urlSync: { queryParam: 'q', facetParam: 'cat' },
    }}
  />
</BaseLayout>
