---
// ASCII Table & Character Encoding Reference — the full standard 7-bit ASCII
// table (decimal 0-127: dec/hex/oct/bin plus character or mnemonic), preceded
// by a plain-English explainer of ASCII vs. the Unicode/UTF-8 encoding that
// superseded it for general text. Nothing here is written with an
// attacker/defender lens, unlike e.g. the Network Port Reference's
// deliberately DFIR-flavored port notes — a `reference` entry in SITE_ENTRIES,
// category `lookup-tables`, tagged `domains: ['systems']`.
//
// Same page shell as the other IT reference pages: PageHeader -> intro copy
// -> a searchable/filterable data table -> External resources -> Related.
// Unlike ip-reference.astro/network-ports.astro (grouped card lists), the
// dataset here is a single, inherently ordered sequence (dec 0-127) best read
// as one continuous table, so there's no <details> grouping — closer to
// ip-reference.astro's own CIDR quick-reference table (a flat, height-capped,
// internally-scrolling <table>), just for the full 128-row dataset instead of
// 16. Category filtering still goes through the shared TagCombobox + ListFilter
// combo (facetAttr on each row), matching every other searchable reference
// page's convention, rather than a bespoke grouping mechanism for this page.
//
// All dataset content (mnemonics, full names, category boundaries) lives in
// src/utils/asciiTable.ts, transcribed directly from the Unicode Consortium's
// own "C0 Controls and Basic Latin" code chart — see that file's header
// comment and test/asciiTable.test.ts for the verification trail. Static
// page — prerender to HTML served from the CDN.
export const prerender = true;
import { css } from 'styled-system/css';
import { tag } from 'styled-system/recipes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import TagCombobox from '../../components/TagCombobox.astro';
import ListFilter from '../../components/ListFilter.astro';
import ExternalResources from '../../components/ExternalResources.astro';
import { toolChip } from '../../components/RelatedTools.astro';
import { EXTERNAL_RESOURCES } from '../../data/externalResources';
import { ASCII_TABLE, ASCII_CATEGORY_LABELS, type AsciiCategory } from '../../utils/asciiTable';

const totalCount = ASCII_TABLE.length;
const controlCount = ASCII_TABLE.filter((e) => e.category === 'control').length;

const catCounts: Record<string, number> = {};
for (const e of ASCII_TABLE) catCounts[e.category] = (catCounts[e.category] ?? 0) + 1;
// Fixed, meaningful order (not alphabetical) — control range first, then the
// printable ranges roughly in code-point order.
const CATEGORY_ORDER: AsciiCategory[] = ['control', 'punctuation', 'digit', 'upper', 'lower'];
const catOptions = CATEGORY_ORDER.map((c) => ({ value: c, label: ASCII_CATEGORY_LABELS[c], count: catCounts[c] ?? 0 }));

// Search text pools every representation a reader might type: the bare
// decimal, the hex form with and without its "0x" prefix, octal, binary, the
// literal character (for printable rows), the mnemonic (for control-range
// rows), and the full name — so typing "65", "0x41", "41", "a", "nul", or
// "line feed" all find the row they'd expect.
const searchText = (e: (typeof ASCII_TABLE)[number]) =>
  [e.dec, e.hex, e.hex.replace('0x', ''), e.oct, e.bin, e.char, e.mnemonic ?? '', e.name].join(' ').toLowerCase();

const bodyP = css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1rem' });

const factGrid = css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(3, 1fr)' }, gap: '0.85rem', mt: '1.25rem', mb: '1.5rem' });
const factCell = css({ display: 'flex', flexDirection: 'column', gap: '0.4rem', p: '1rem 1.1rem', bg: 'bgCard', border: '1px solid token(colors.border)', borderRadius: 'md' });
const factTitle = css({ display: 'flex', alignItems: 'center', gap: '0.5rem', fontFamily: 'sans', fontWeight: 700, fontSize: '0.92rem', color: 'text' });
const factDesc = css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.65, m: 0 });

const filterRow = css({ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap', mb: '0.75rem' });

const tableWrap = css({
  maxH: '38rem',
  overflowY: 'auto',
  overflowX: 'auto',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
});
const dataTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' });
const th = css({
  position: 'sticky',
  top: 0,
  textAlign: 'left',
  color: 'textMuted',
  fontFamily: 'sans',
  fontWeight: 600,
  fontSize: '0.68rem',
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  bg: 'bgCard',
  p: '0.5rem 0.75rem',
  borderBottom: '1px solid token(colors.border)',
  whiteSpace: 'nowrap',
});
const tdBase = css({ p: '0.4rem 0.75rem', borderBottom: '1px solid token(colors.border)', whiteSpace: 'nowrap' });
const tdMono = `${tdBase} ${css({ fontFamily: 'mono', color: 'text' })}`;
const tdDec = `${tdMono} ${css({ fontWeight: 700, color: 'primary' })}`;
const tdChar = `${tdBase} ${css({ fontFamily: 'mono', fontSize: '1rem', fontWeight: 700, color: 'text', textAlign: 'center' })}`;
const tdName = `${tdBase} ${css({ fontFamily: 'sans', color: 'textMuted', whiteSpace: 'normal' })}`;
const mnemonicTag = `${tag({ tone: 'muted', mono: true })} ${css({ fontSize: '0.72rem' })}`;

const noteCard = css({
  mt: '1rem',
  p: '0.85rem 1.1rem',
  bg: 'bgSubtle',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  color: 'textMuted',
  fontSize: '0.84rem',
  lineHeight: 1.7,
});

const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem', mt: '1.25rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
---

<BaseLayout
  title="ASCII Table & Character Encoding Reference"
  description="The full 7-bit ASCII table (0-127) with decimal, hex, octal, and binary for every code point, plus how Unicode and UTF-8 relate to it."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Reference', href: '/reference/' }, { label: 'ASCII Table & Character Encoding Reference' }]}
    eyebrow="Reference"
    title="ASCII Table & Character Encoding Reference"
    description={`The complete standard ASCII table, decimal 0–${totalCount - 1}, with hex, octal, and binary for every code point — searchable by value, character, or name.`}
  />

  <p class={bodyP}>
    ASCII (the American Standard Code for Information Interchange) assigns every one of the numbers 0 through 127 to
    either a printable character or a control code. It began at the American Standards Association in 1960, was
    first approved as a standard on June 17, 1963 (as ASA X3.4-1963, without lowercase letters), and reached the
    form still in use today with the 1967 revision that added lowercase and the 1968 revision (ANSI X3.4-1968) that
    the U.S. federal government mandated for electronic data interchange between agencies.
  </p>
  <p class={bodyP}>
    Because a 7-bit code only has 128 possible values, ASCII splits cleanly into two ranges: decimal 32 through 126
    are printable — digits, the uppercase and lowercase Latin alphabet, and common punctuation — while 0 through 31
    plus 127 (DEL) are <strong class={css({ color: 'text' })}>control characters</strong>, originally meant to
    steer physical teletypes and serial links rather than to be displayed. Most of those control functions (BEL,
    device controls, the block/synchronous-idle signaling codes) are obsolete outside of legacy hardware, but a
    handful — line feed, carriage return, tab, and escape above all — are still load-bearing in nearly every text
    format and terminal protocol in use today.
  </p>
  <p class={bodyP}>
    ASCII's 128 values only ever covered unaccented English text, which is why it was superseded by{' '}
    <strong class={css({ color: 'text' })}>Unicode</strong> for general-purpose text — a single standard that
    assigns a unique code point to characters from virtually every written script, not just English. Its dominant
    encoding on today's web, <strong class={css({ color: 'text' })}>UTF-8</strong> (designed in September 1992 by
    Ken Thompson, to design criteria Rob Pike specified), was deliberately built so code points U+0000 through
    U+007F map to the exact same single-byte values as 7-bit ASCII — meaning any plain ASCII file is already valid
    UTF-8 without modification. That backward compatibility is exactly why the table below still matters even in a
    Unicode-first world: every value in it is simultaneously an ASCII code point and a UTF-8 byte.
  </p>

  <div class={factGrid}>
    <div class={factCell}>
      <span class={factTitle}><Icon name="hash" size={16} class={css({ color: 'primary' })} /> 7 bits, 128 values</span>
      <p class={factDesc}>Every ASCII code point fits in 7 bits — decimal 0 through 127, hex 0x00 through 0x7F, all listed below.</p>
    </div>
    <div class={factCell}>
      <span class={factTitle}><Icon name="terminal" size={16} class={css({ color: 'primary' })} /> {controlCount} control characters</span>
      <p class={factDesc}>Decimal 0–31 plus 127 (DEL) were designed for hardware/protocol signaling, not display — LF, CR, TAB, and ESC are still everywhere.</p>
    </div>
    <div class={factCell}>
      <span class={factTitle}><Icon name="globe" size={16} class={css({ color: 'primary' })} /> Byte-identical to UTF-8</span>
      <p class={factDesc}>UTF-8 was deliberately designed so its first 128 code points are single bytes identical to 7-bit ASCII.</p>
    </div>
  </div>

  <div class={css({ mb: '0.6rem' })}>
    <TagCombobox
      id="ascii-cb"
      options={catOptions}
      placeholder={`Search ${totalCount} characters by decimal, hex, char, or name, or type a category…`}
      label="Search ASCII characters or filter by category"
    />
  </div>

  <div class={filterRow}>
    <p role="status" aria-live="polite" class={css({ color: 'textMuted', fontSize: '0.9rem', m: 0 })}>
      <span id="ascii-result-count">{totalCount}</span> characters
    </p>
  </div>

  <div class={tableWrap} tabindex="0" role="region" aria-label="ASCII table">
    <table class={dataTable}>
      <thead>
        <tr>
          <th class={th}>Dec</th>
          <th class={th}>Hex</th>
          <th class={th}>Oct</th>
          <th class={th}>Bin</th>
          <th class={th}>Char</th>
          <th class={th}>Name</th>
        </tr>
      </thead>
      <tbody>
        {
          ASCII_TABLE.map((e) => (
            <tr data-ascii-row={searchText(e)} data-cat={e.category}>
              <td class={tdDec}>{e.dec}</td>
              <td class={tdMono}>{e.hex}</td>
              <td class={tdMono}>{e.oct}</td>
              <td class={tdMono}>{e.bin}</td>
              <td class={tdChar}>{e.hasMnemonic ? <span class={mnemonicTag}>{e.char}</span> : e.char}</td>
              <td class={tdName}>{e.name}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p id="ascii-empty" hidden role="status" aria-live="polite" class={css({ color: 'textMuted', textAlign: 'center', py: '3rem' })}>
    No characters match your search.
  </p>

  <div class={noteCard}>
    <strong class={css({ color: 'text' })}>Format notes:</strong> hex is shown as 2-digit uppercase (0x00–0x7F);
    octal as 3-digit (000–177); binary as the 8-bit zero-padded form of the underlying 7-bit value (e.g.{' '}
    <code class={css({ fontFamily: 'mono' })}>01000001</code> for 'A') — matching how a single byte is normally
    displayed, rather than a bare 7-bit string. The non-printable entries (control characters, space, and DEL) show
    their standard mnemonic in the Char column instead of an unprintable glyph.
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['ascii-table']} />

  <h2 id="related" class={sectionH2}>
    <Icon name="link" size={20} class={css({ color: 'primary' })} /> Related
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/tools/base-converter/" class={toolChip}>
        <Icon name="hash" size={13} /> Number Base Converter <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Need to convert one specific value between binary, octal, decimal, and hex live, with its own ASCII decode?
        The Number Base Converter computes it instead of looking it up.
      </p>
    </div>
    <div>
      <a href="/reference/osi-model/" class={toolChip}>
        <Icon name="layers" size={13} /> OSI & TCP/IP Model Reference <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Character encoding is a Presentation-layer concern in the OSI model's classic seven-layer telling — see how
        that layer fits between Session and Application.
      </p>
    </div>
  </div>

  <ListFilter
    config={{
      comboboxId: 'ascii-cb',
      cardSelector: '[data-ascii-row]',
      searchAttr: 'data-ascii-row',
      countId: 'ascii-result-count',
      emptyId: 'ascii-empty',
      facetAttr: 'data-cat',
      urlSync: { queryParam: 'q', facetParam: 'category' },
    }}
  />
</BaseLayout>
