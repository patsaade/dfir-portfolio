---
// Home page — a single, distinct, minimal-typographic hero per domain, sized
// to fit one viewport with no scrolling required. Patrick's version: identity
// + current role + headline certs at a glance, two CTAs into the blog/labs —
// content depth (the full post archive, full certification detail) lives on
// its own pages (/blog/, /certifications/), not stacked below the fold here.
// CyberKit's version (data-brand="cyberkit", see CLAUDE.md invariant 14):
// wordmark + purpose statement + three links into DFIR/IT/Drills. This is
// the first page besides Navigation.astro/Footer.astro to fork by brand —
// cyberkit.win's own "/" used to redirect into /dfir/ (which forked its own
// hero the same way); that's been decoupled so /dfir/ can stay a single,
// fully-scrollable reference hub on both domains while this page carries the
// zero-scroll splash instead.
export const prerender = true;
import { css } from 'styled-system/css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PixelStar from '../components/PixelStar.astro';
import { SOCIALS } from '../consts';

// Sizing shared by both hero variants — `minH` is the viewport height minus
// the known fixed chrome above <main>: Ticker (~35px base / ~37px sm+) +
// Navigation's sticky header (64px + 1px border) + BaseLayout <main>'s own
// top padding (32px base / 48px md+). `minHeight`, not `height`/
// `overflow:hidden` — BaseLayout's <main> is shared by every other page, so
// an unusually short viewport should gracefully grow a small natural scroll
// rather than get clipped.
const heroSizing = {
  display: 'flex',
  flexDirection: 'column',
  justifyContent: 'center',
  minH: { base: 'calc(100dvh - 140px)', md: 'calc(100dvh - 158px)' },
} as const;
// Each is ONE css(base, variant) call — not two separately-called css()
// results concatenated as class strings. Both objects set `display`, and
// STYLE_GUIDE.md's "Buttons" gotcha already bit this codebase once (the
// primary-button hover-color bug) when two independently-atomized classes
// each override the same property: they race on source order instead of
// deep-merging. A single call is what guarantees the brand override wins.
const defaultHeroWrap = css({ ...heroSizing }, { '[data-brand="cyberkit"] &': { display: 'none' } });
const cyberkitHeroWrap = css({ ...heroSizing, display: 'none' }, { '[data-brand="cyberkit"] &': { display: 'flex' } });

// The three top-level sections CyberKit spans.
const CYBERKIT_SECTIONS = [
  { href: '/dfir/', label: 'DFIR tools', icon: 'shield' },
  { href: '/it/', label: 'IT tools', icon: 'wifi' },
  { href: '/drills/', label: 'Practice drills', icon: 'target' },
] as const;

const eyebrow = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.4rem',
  fontFamily: 'mono',
  fontSize: '0.78rem',
  fontWeight: 700,
  letterSpacing: '0.12em',
  textTransform: 'uppercase',
  color: 'primary',
  mb: '0.6rem',
});
const heroH1 = css({
  fontSize: { base: '2.6rem', md: '3.75rem', lg: '4.25rem' },
  fontWeight: 700,
  lineHeight: 1.05,
  letterSpacing: '-0.04em',
  mb: '0.85rem',
});
const tagline = css({ fontSize: '1.05rem', color: 'textMuted', maxW: '620px', lineHeight: 1.5 });
const ctaRow = css({ display: 'flex', flexWrap: 'wrap', gap: '0.75rem', mt: '1.25rem' });
const ctaPrimary = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.5rem',
  bg: 'primary',
  color: 'onPrimary',
  fontWeight: 600,
  px: '1.25rem',
  py: '0.7rem',
  borderRadius: 'md',
  transition: 'background 200ms ease, transform 200ms ease',
  _hover: { bg: 'primaryHover', transform: 'translateY(-1px)' },
});
const ctaGhost = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.5rem',
  border: '1px solid token(colors.border)',
  color: 'text',
  fontWeight: 600,
  px: '1.25rem',
  py: '0.7rem',
  borderRadius: 'md',
  transition: 'border-color 200ms ease',
  _hover: { borderColor: 'primary' },
});
const signOffLink = css({ color: 'primary', fontWeight: 600, _hover: { textDecoration: 'underline' } });
const signOffRow = css({ display: 'flex', alignItems: 'center', gap: '0.75rem', mt: '1rem' });
---

<BaseLayout>
  {/* Patrick's own homepage hero — unchanged, what patricksaade.com always shows. */}
  <section class={defaultHeroWrap}>
    <p class={eyebrow}>Field Report</p>
    <h1 class={`declassify-hero ${heroH1}`}>
      DFIR-focused.<br />
      <span class={css({ color: 'primary' })}>SOC &amp; Incident Response @ First American.</span>
    </h1>
    <p class={tagline}>
      3+ years in live incident response — memory &amp; host forensics, EDR, and detection.
      CISSP certified; in pursuit of GCFA, GCFE, and GCIH.
    </p>
    <div class={ctaRow}>
      <a href="/blog/" class={ctaPrimary}>
        Latest posts <Icon name="arrow-right" size={17} />
      </a>
      <a href="/labs/" class={ctaGhost}>
        <Icon name="flask" size={17} /> Lab writeups
      </a>
    </div>
    <div class={signOffRow}>
      <PixelStar size={22} />
      <a href={SOCIALS.linkedin} target="_blank" rel="noopener" class={signOffLink}>LinkedIn</a>
      <span class={css({ color: 'border' })}>·</span>
      <a href={SOCIALS.github} target="_blank" rel="noopener" class={signOffLink}>GitHub</a>
    </div>
  </section>

  {/* CyberKit's own homepage hero — cyberkit.win's actual landing page. No
      breadcrumb, no personal identity — names the toolkit, states its
      purpose, and links straight into the three sections it spans. */}
  <section class={cyberkitHeroWrap}>
    <p class={eyebrow}>
      <PixelStar size={14} />
      Free &amp; Browser-Based
    </p>
    <h1 class={`declassify-hero ${heroH1}`}>CyberKit</h1>
    <p class={tagline}>
      A free digital forensics, incident response, and IT security toolkit — every tool runs
      entirely in your browser. Nothing you enter is ever uploaded, logged, or sent anywhere.
    </p>
    <div class={ctaRow}>
      {
        CYBERKIT_SECTIONS.map((s, i) => (
          <a href={s.href} class={i === 0 ? ctaPrimary : ctaGhost}>
            <Icon name={s.icon} size={17} /> {s.label}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
