---
// MITRE ATT&CK Drill (/drills/attack/) — one of the 6 /drills/* knowledge-
// check modules (see src/pages/drills/index.astro). Every question is
// generated from ATTACK_TECHNIQUES (src/data/references.ts), the same
// generated-from-MITRE's-STIX-bundle dataset the full /attack-map/ renders —
// see src/data/drills/attackDrill.ts for the pure, deterministic generator.
// Shares the DrillEngine.astro/drillEngine.ts quiz shell with the other 5
// modules; nothing here reimplements grading/progress/state.
export const prerender = true;
import { css } from 'styled-system/css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import Term from '../../../components/Term.astro';
import DrillEngine from '../../../components/DrillEngine.astro';
import { toolChip } from '../../../components/RelatedTools.astro';
import ExternalResources from '../../../components/ExternalResources.astro';
import { EXTERNAL_RESOURCES } from '../../../data/externalResources';
import { ATTACK_TECHNIQUES, ATTACK_VERSION } from '../../../data/references';
import { getAttackDrillQuestion, ATTACK_DRILL_TOTAL } from '../../../data/drills/attackDrill';

// Called once here (build time, for the no-JS shell) and again by the
// client <script> below on mount — see DrillEngine.astro's own header
// comment for why question 0 must be deterministic to avoid a flash.
const q0 = getAttackDrillQuestion(0);

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
---

<BaseLayout
  title="MITRE ATT&CK Drill"
  description="A knowledge-check drill on MITRE ATT&CK technique and tactic recognition, generated entirely from this site's own ATT&CK dataset — real procedure examples, real technique names, real tactics."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Drills', href: '/drills/' }, { label: 'MITRE ATT&CK' }]}
    eyebrow="Practice"
    title="MITRE ATT&CK Drill"
    description="Technique and tactic recognition, generated from the same ATT&CK dataset behind this site's full coverage map — real procedure examples, real technique names, real tactics."
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      This is a knowledge-check drill built from real site data — MITRE's Enterprise ATT&amp;CK v{ATTACK_VERSION} matrix,{' '}
      {ATTACK_TECHNIQUES.length} techniques strong — not a certification exam. Every question below is generated
      from an actual MITRE procedure example, technique name, or tactic mapping; nothing here is invented.
    </p>
  </aside>

  <p class={css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1.5rem' })}>
    Two question shapes alternate: given a real, documented adversary procedure, type the{' '}
    <Term slug="mitre-attack">MITRE ATT&amp;CK</Term> technique ID it describes (e.g. "T1059"); and given a
    technique's name and id, type the tactic it maps to in the Enterprise matrix. No multiple choice — every answer
    is typed and graded against the real dataset, and links straight to that technique's own detail page for the
    full definition, platforms, detection guidance, and mitigations.
  </p>

  <DrillEngine
    drill="attack"
    heading="MITRE ATT&CK Drill"
    intro="Ten questions, drawn from across the full Enterprise matrix — not just the handful of techniques this site's writeups happen to cover."
    totalQuestions={ATTACK_DRILL_TOTAL}
    firstQuestion={q0}
  />

  <h2 id="related" class={sectionH2}>
    <Icon name="crosshair" size={20} class={css({ color: 'primary' })} /> Related
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/attack-map/" class={toolChip}>
        <Icon name="crosshair" size={13} /> MITRE ATT&amp;CK Coverage Map <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Browse the full Enterprise matrix this drill draws from — every tactic, every technique, with detection
        telemetry, real-world procedure examples, and mitigations for each.
      </p>
    </div>
    <div>
      <a href="/d3fend/" class={toolChip}>
        <Icon name="shield" size={13} /> D3FEND Countermeasure Map <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Once a technique is second nature, see what actually counters it — D3FEND is this map's defensive twin,
        cross-linked to ATT&amp;CK on both sides.
      </p>
    </div>
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['attack']} />
</BaseLayout>

<script>
  import { initDrill } from '../../../scripts/drillEngine';
  import { getAttackDrillQuestion, ATTACK_DRILL_TOTAL } from '../../../data/drills/attackDrill';
  const root = document.querySelector('[data-drill="attack"]');
  if (root) initDrill({ root, totalQuestions: ATTACK_DRILL_TOTAL, nextQuestion: getAttackDrillQuestion });
</script>
