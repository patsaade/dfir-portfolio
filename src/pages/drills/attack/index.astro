---
// MITRE ATT&CK Drill (/drills/attack/) — one of the 6 /drills/* knowledge-
// check modules (see src/pages/drills/index.astro). Every question is
// generated from ATTACK_TECHNIQUES (src/data/references.ts), the same
// generated-from-MITRE's-STIX-bundle dataset the full /attack-map/ renders —
// see src/data/drills/attackDrill.ts for the pure, deterministic generator.
// Shares the DrillEngine.astro/drillEngine.ts quiz shell with the other 5
// modules; nothing here reimplements grading/progress/state.
export const prerender = true;
import { css } from 'styled-system/css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import Term from '../../../components/Term.astro';
import DrillEngine from '../../../components/DrillEngine.astro';
import { toolChip } from '../../../components/RelatedTools.astro';
import ExternalResources from '../../../components/ExternalResources.astro';
import { EXTERNAL_RESOURCES } from '../../../data/externalResources';
import { ATTACK_TECHNIQUES, ATTACK_VERSION } from '../../../data/references';
import { attackDrillQuestionBank, ATTACK_DRILL_TOTAL } from '../../../data/drills/attackDrill';

// The ENTIRE question bank, materialised at build time and handed to the
// client as a JSON island below. The generator is a pure, deterministic
// function of the question index, so there's nothing the client needs it for
// at runtime — and keeping it out of the client bundle is what stops Rollup
// pulling the whole ATT&CK Enterprise dataset (~490 KB raw) into this page to
// ask fourteen questions. See src/data/drills/graders.ts for how the `grade`
// closures survive the JSON round-trip.
const QUESTIONS = attackDrillQuestionBank();
// Question 0 renders for real server-side (DrillEngine's no-JS contract). It's
// the SAME object the client hydrates for index 0, not a second call to the
// generator, so SSR and hydration cannot drift.
const q0 = QUESTIONS[0];
const questionsJson = JSON.stringify(QUESTIONS).replace(/</g, '\\u003c');

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
---

<BaseLayout
  title="MITRE ATT&CK Drill"
  description="A knowledge-check drill on MITRE ATT&CK technique and tactic recognition, generated entirely from this site's own ATT&CK dataset — real procedure examples, real technique names, real tactics."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Drills', href: '/drills/' }, { label: 'MITRE ATT&CK' }]}
    eyebrow="Practice"
    title="MITRE ATT&CK Drill"
    description="Technique and tactic recognition, generated from the same ATT&CK dataset behind this site's full coverage map — real procedure examples, real technique names, real tactics."
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      This is a knowledge-check drill built from real site data — MITRE's Enterprise ATT&amp;CK v{ATTACK_VERSION} matrix,{' '}
      {ATTACK_TECHNIQUES.length} techniques strong — not a certification exam. Every question below is generated
      from an actual MITRE procedure example, technique name, or tactic mapping; nothing here is invented.
    </p>
  </aside>

  <p class={css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1.5rem' })}>
    Three question shapes rotate: given a real, documented adversary procedure, type the{' '}
    <Term slug="mitre-attack">MITRE ATT&amp;CK</Term> technique ID it describes (e.g. "T1059"); given a
    technique's name and id, type the tactic it maps to in the Enterprise matrix; and a handful of "Order the
    intrusion" questions drag a small set of real techniques from a single tactic into the sequence an attacker
    would actually execute them. No multiple choice on the recall questions — every typed answer is graded against
    the real dataset, and links straight to that technique's own detail page for the full definition, platforms,
    detection guidance, and mitigations.
  </p>

  <DrillEngine
    drill="attack"
    heading="MITRE ATT&CK Drill"
    intro="Fourteen questions, drawn from across the full Enterprise matrix — not just the handful of techniques this site's writeups happen to cover."
    totalQuestions={ATTACK_DRILL_TOTAL}
    firstQuestion={q0}
  />

  <script type="application/json" data-drill-questions="attack" is:inline set:html={questionsJson} />

  <h2 id="related" class={sectionH2}>
    <Icon name="crosshair" size={20} class={css({ color: 'primary' })} /> Related
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/reference/attack-map/" class={toolChip}>
        <Icon name="crosshair" size={13} /> MITRE ATT&amp;CK Coverage Map <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Browse the full Enterprise matrix this drill draws from — every tactic, every technique, with detection
        telemetry, real-world procedure examples, and mitigations for each.
      </p>
    </div>
    <div>
      <a href="/reference/d3fend/" class={toolChip}>
        <Icon name="shield" size={13} /> D3FEND Countermeasure Map <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Once a technique is second nature, see what actually counters it — D3FEND is this map's defensive twin,
        cross-linked to ATT&amp;CK on both sides.
      </p>
    </div>
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['attack']} />
</BaseLayout>

<script>
  // Imports the drill engine and the tiny grader shim ONLY — never
  // ../../../data/drills/attackDrill, which would drag the whole ATT&CK
  // dataset into this page's bundle. The questions come from the JSON island
  // the frontmatter above emitted.
  import { initDrill } from '../../../scripts/drillEngine';
  import { hydrateQuestion, type SerialisableDrillQuestion } from '../../../data/drills/graders';
  const root = document.querySelector('[data-drill="attack"]');
  const dataEl = document.querySelector('[data-drill-questions="attack"]');
  if (root && dataEl) {
    const questions: SerialisableDrillQuestion[] = JSON.parse(dataEl.textContent || '[]');
    if (questions.length) {
      initDrill({
        root,
        totalQuestions: questions.length,
        nextQuestion: (i: number) => hydrateQuestion(questions[((i % questions.length) + questions.length) % questions.length]),
      });
    }
  }
</script>
