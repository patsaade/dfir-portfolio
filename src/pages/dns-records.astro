---
// DNS Record Type Reference — general networking fundamentals, IT-framed (no
// attacker/defender lens; see CLAUDE.md's IT vs. DFIR framing rule). A single
// searchable/filterable table of the common DNS resource record (RR) types,
// no per-entry detail pages — same "reference table" shape as ip-reference.astro,
// just rendered as a literal <table> rather than a card grid since the data is
// inherently tabular (type / TYPE value / RFC / purpose / example). Every
// TYPE value and defining RFC is sourced from IANA's own "Domain Name System
// (DNS) Parameters" registry — see src/data/dnsRecordTypes.ts's own header
// for the exact citation and verification note. Static page — prerender to
// HTML served from the CDN.
export const prerender = true;
import { css } from 'styled-system/css';
import { tag } from 'styled-system/recipes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import TagCombobox from '../components/TagCombobox.astro';
import ListFilter from '../components/ListFilter.astro';
import ExternalResources from '../components/ExternalResources.astro';
import Term from '../components/Term.astro';
import { toolChip } from '../components/RelatedTools.astro';
import { EXTERNAL_RESOURCES } from '../data/externalResources';
import { DNS_RECORD_TYPES, DNS_CATEGORY_LABEL, type DnsRecordCategory } from '../data/dnsRecordTypes';

const totalCount = DNS_RECORD_TYPES.length;

const catCounts: Partial<Record<DnsRecordCategory, number>> = {};
for (const r of DNS_RECORD_TYPES) catCounts[r.category] = (catCounts[r.category] ?? 0) + 1;
const catOptions = (Object.keys(catCounts) as DnsRecordCategory[])
  .sort()
  .map((c) => ({ value: c, label: DNS_CATEGORY_LABEL[c], count: catCounts[c] }));

const bodyP = css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1.5rem' });
const filterRow = css({ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap', mb: '0.75rem' });

const tableWrap = css({
  overflowX: 'auto',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  mb: '1rem',
});
const drTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem', minW: '760px' });
const drTh = css({
  position: 'sticky',
  top: 0,
  textAlign: 'left',
  color: 'textMuted',
  fontFamily: 'sans',
  fontWeight: 600,
  fontSize: '0.68rem',
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  bg: 'bgCard',
  p: '0.6rem 0.75rem',
  borderBottom: '1px solid token(colors.border)',
  whiteSpace: 'nowrap',
});
const drTd = css({ color: 'text', p: '0.65rem 0.75rem', borderBottom: '1px solid token(colors.border)', verticalAlign: 'top' });
const typeCell = css({ display: 'flex', flexDirection: 'column', gap: '0.15rem' });
const typeName = css({ fontFamily: 'mono', fontWeight: 700, fontSize: '0.95rem', color: 'primary' });
const typeFields = css({ fontFamily: 'mono', fontSize: '0.68rem', color: 'textMuted' });
const typeValueCell = css({ fontFamily: 'mono', fontSize: '0.85rem', color: 'text' });
const purposeCell = css({ lineHeight: 1.6, maxW: '360px' });
const noteText = css({ display: 'block', color: 'textMuted', fontSize: '0.78rem', mt: '0.3rem', fontStyle: 'italic' });
const exampleCell = css({ fontFamily: 'mono', fontSize: '0.78rem', color: 'textMuted', whiteSpace: 'nowrap' });
const rfcLink = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.25rem',
  fontFamily: 'mono',
  fontSize: '0.8rem',
  color: 'primary',
  textDecoration: 'none',
  _hover: { textDecoration: 'underline' },
});
const meaningCaption = css({ display: 'block', color: 'textMuted', fontSize: '0.72rem', fontStyle: 'italic', mt: '0.15rem' });

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
---

<BaseLayout
  title="DNS Record Type Reference"
  description="The common DNS resource record types — A, AAAA, CNAME, MX, TXT, NS, SOA, PTR, SRV, CAA — with each type's numeric TYPE value, defining RFC, purpose, and a short example, sourced from IANA's DNS Parameters registry."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'DNS Record Type Reference' }]}
    eyebrow="Reference"
    title="DNS Record Type Reference"
    description={`${totalCount} common DNS resource record (RR) types — what each one is for, its numeric TYPE value, and a short example — every value sourced directly from IANA's own DNS Parameters registry.`}
  />

  <p class={bodyP}>
    DNS answers a query with one or more <em>resource records</em>, and every record
    carries a TYPE — a small integer IANA assigns and tracks in its "Domain Name System (DNS) Parameters" registry, in
    the "Resource Record (RR) TYPEs" table. Software never actually sees the mnemonic "MX" on the wire — it sees the
    number 15 — so the mnemonic-to-number mapping below is the literal contract between a DNS message and whatever's
    parsing it. Every TYPE value and RFC citation here was checked directly against that registry, not a second-hand
    summary; every example below uses an address from the RFC 5737/3849 documentation-only ranges rather than a real,
    potentially-stale one.
  </p>

  <div class={css({ mb: '0.6rem' })}>
    <TagCombobox
      id="dr-cb"
      options={catOptions}
      placeholder={`Search ${totalCount} record types, or type a category…`}
      label="Search DNS record types or filter by category"
    />
  </div>

  <div class={filterRow}>
    <p role="status" aria-live="polite" class={css({ color: 'textMuted', fontSize: '0.9rem', m: 0 })}>
      <span id="dr-result-count">{totalCount}</span> record types
    </p>
  </div>

  <div class={tableWrap}>
    <table class={drTable}>
      <thead>
        <tr>
          <th class={drTh}>Type</th>
          <th class={drTh}>TYPE&nbsp;value</th>
          <th class={drTh}>Category</th>
          <th class={drTh}>Purpose</th>
          <th class={drTh}>Example</th>
          <th class={drTh}>Source</th>
        </tr>
      </thead>
      <tbody>
        {
          DNS_RECORD_TYPES.map((r) => (
            <tr
              data-dr-row={`${r.type} ${r.meaning} ${DNS_CATEGORY_LABEL[r.category]} ${r.purpose}`.toLowerCase()}
              data-cat={r.category}
            >
              <td class={drTd}>
                <span class={typeCell}>
                  <span class={typeName}>{r.type}</span>
                  {r.fields && <span class={typeFields}>{r.fields}</span>}
                </span>
              </td>
              <td class={`${drTd} ${typeValueCell}`}>
                {r.typeValue}
                <span class={meaningCaption}>&ldquo;{r.meaning}&rdquo;</span>
              </td>
              <td class={drTd}>
                <span class={tag({ tone: 'muted' })}>{DNS_CATEGORY_LABEL[r.category]}</span>
              </td>
              <td class={`${drTd} ${purposeCell}`}>
                {r.purpose}
                {r.note && <span class={noteText}>{r.note}</span>}
              </td>
              <td class={`${drTd} ${exampleCell}`}>{r.example}</td>
              <td class={drTd}>
                <a href={r.rfc.url} target="_blank" rel="noopener" class={rfcLink}>
                  {r.rfc.name} <Icon name="external-link" size={11} />
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p id="dr-empty" hidden role="status" aria-live="polite" class={css({ color: 'textMuted', textAlign: 'center', py: '3rem' })}>
    No record types match your search.
  </p>

  <p class={css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.7, mt: '1.25rem' })}>
    A handful of these carry structure worth knowing beyond the single-line description: <strong>MX</strong>'s numeric
    preference is <em>lower-is-preferred</em> — the mail server with the smallest number is tried first. A{' '}
    <strong>SOA</strong> record's SERIAL is what secondary name servers compare to notice a zone changed, and its
    REFRESH/RETRY/EXPIRE fields are the timers governing how they stay in sync. An <strong>SRV</strong> record's owner
    name is never a plain hostname — it's always <code>_service._proto.name</code> (e.g. <code>_sip._tcp.example.com.</code>),
    with the service and protocol labels underscore-prefixed specifically so they can't collide with a real hostname
    label. A <strong>TXT</strong> record's payload has no fixed grammar of its own — RFC 1035 just calls it
    "descriptive text" and leaves the meaning to whatever application defines it, which is exactly how an unrelated
    spec like <Term slug="sender-policy-framework">SPF</Term> was able to piggyback on the record type instead of
    getting its own.
  </p>

  <h2 id="related" class={sectionH2}>
    <Icon name="link" size={20} class={css({ color: 'primary' })} /> Related references
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/network-ports/" class={toolChip}>
        <Icon name="server" size={13} /> Network Port Reference <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        DNS itself runs over port 53 (UDP for ordinary lookups, TCP for zone transfers and oversized responses) — see
        the Network Port Reference for that and every other well-known port.
      </p>
    </div>
    <div>
      <a href="/osi-model/" class={toolChip}>
        <Icon name="globe" size={13} /> OSI &amp; TCP/IP Model Reference <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        DNS is a named, recognizable Application-layer protocol — see where it sits relative to everything below it.
      </p>
    </div>
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['dns-records'] ?? []} />

  <ListFilter
    config={{
      comboboxId: 'dr-cb',
      cardSelector: '[data-dr-row]',
      searchAttr: 'data-dr-row',
      countId: 'dr-result-count',
      emptyId: 'dr-empty',
      facetAttr: 'data-cat',
      urlSync: { queryParam: 'q', facetParam: 'category' },
    }}
  />
</BaseLayout>
