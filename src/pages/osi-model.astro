<script>
  // @ts-nocheck — vanilla DOM client script
  // Reverse-order toggle: flips BOTH per-layer stacks (OSI + TCP/IP) between
  // bottom-up (the DOM's own order, Physical first) and top-down, via a
  // single `data-order` attribute read by each `stack`'s own CSS
  // (`[data-order="top-down"] &` -> `flex-direction: column-reverse`) — no
  // DOM reordering, so scroll position and focus stay sane across a toggle.
  // Debounced per CLAUDE.md invariant 12 (any button that cycles state must
  // debounce its own clicks) even though the visual change is an instant
  // CSS flex-direction flip with no transition to thrash mid-animation —
  // the guard is cheap and keeps this consistent with every other stateful
  // toggle on the site.
  (function () {
    function init() {
      var groups = document.querySelectorAll('[data-order-toggle]:not([data-ready])');
      Array.prototype.forEach.call(groups, function (group) {
        var bottomBtn = group.querySelector('[data-order-btn="bottom-up"]');
        var topBtn = group.querySelector('[data-order-btn="top-down"]');
        var root = document.querySelector('main') || document.body;
        if (!bottomBtn || !topBtn) return;
        var KEY = 'osi-model-order';

        function setOrder(order) {
          root.setAttribute('data-order', order);
          var topActive = order === 'top-down';
          [
            [bottomBtn, !topActive],
            [topBtn, topActive],
          ].forEach(function (pair) {
            var btn = pair[0], active = pair[1];
            if (active) btn.setAttribute('data-active', '');
            else btn.removeAttribute('data-active');
            btn.setAttribute('aria-checked', String(active));
          });
          try { localStorage.setItem(KEY, order); } catch (e) {}
        }

        function debounceClick(el, cooldownMs, handler) {
          var busy = false;
          el.addEventListener('click', function () {
            if (busy) return;
            busy = true;
            handler();
            setTimeout(function () { busy = false; }, cooldownMs);
          });
        }

        debounceClick(bottomBtn, 200, function () { setOrder('bottom-up'); });
        debounceClick(topBtn, 200, function () { setOrder('top-down'); });

        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (e) {}
        if (saved === 'top-down') setOrder('top-down');

        group.setAttribute('data-ready', '');
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
