---
// OSI 7-Layer Model + TCP/IP 4-Layer Model Reference — general networking
// fundamentals, IT-framed (no attacker/defender lens; see CLAUDE.md's IT vs.
// DFIR framing rule). Same page shell as the other IT reference page
// (ip-reference.astro): PageHeader -> intro aside -> body sections -> a
// related-references cross-link block. Unlike ip-reference.astro/
// network-ports.astro, there's no TagCombobox/ListFilter here — the entire
// dataset is 7 + 4 fixed, well-known layers, not a large searchable catalog,
// so it reads better as a linear reference than a filterable list. All
// layer/port data is inlined below rather than split into src/data/ — it's
// small, fixed, and only consumed by this one page. Static page — prerender
// to HTML served from the CDN.
//
// Redesigned to teach visually first, text second: each layer's always-
// visible content is a single compact line + example chips (not a paragraph)
// — the original fuller explanation is one click away behind a native
// <details> ("Show more"), so nothing was deleted, just deferred (see
// CLAUDE.md invariant 12 — <details> gets the site's shared expand animation
// and no-JS-safe native fallback for free, no new script needed for that
// part). A reverse-order toggle (data-order attribute + plain CSS
// flex-direction, debounced per invariant 12) lets a reader flip between
// bottom-up (Physical -> Application, the classic teaching order) and
// top-down (Application -> Physical, how an outgoing request actually
// builds up its headers) for both stacks at once. The OSI-to-TCP/IP mapping
// — previously a plain table only — gains a CSS Grid "derivation" diagram on
// wider screens: TCP/IP's 4 layers are rendered as grid cells that literally
// span the same row-lines as the OSI layers they merge (Link spans OSI rows
// 1-2, Application spans OSI rows 5-7), color-matched, so the merge is
// something you SEE, not just read in a table row. The table stays as the
// accessible, always-available baseline on narrow screens (a 2-column
// spanning grid gets cramped there) and is never removed.
export const prerender = true;
import { css } from 'styled-system/css';
import { tag, card } from 'styled-system/recipes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { toolChip } from '../components/RelatedTools.astro';

interface OsiLayer {
  num: number;
  name: string;
  icon: IconName;
  gist: string;
  what: string;
  examples: string[];
  why: string;
}

// Ascending, Physical (1) through Application (7) — the DOM always renders in
// this order; the reverse-order toggle flips it visually via CSS, not by
// re-rendering, so a no-JS visitor always gets this canonical bottom-up order.
const OSI_LAYERS: OsiLayer[] = [
  {
    num: 1,
    name: 'Physical',
    icon: 'cpu',
    gist: 'Raw bits over a physical medium — cabling, voltage, light, radio. No addressing at all.',
    what: "The physical medium and the raw signaling that carries bits across it — cabling, connectors, voltage levels, light pulses, and radio frequencies. Nothing at this layer has any concept of an address; it just moves an electrical, optical, or radio signal from one point to another.",
    examples: ['Ethernet cabling (Cat5e/6)', 'Fiber optics', 'Wi-Fi radio (802.11 PHY)', 'Hubs & repeaters'],
    why: 'A dead link light or an unplugged cable is a Layer 1 problem — worth ruling out first, since nothing above this layer works at all without it.',
  },
  {
    num: 2,
    name: 'Data Link',
    icon: 'wifi',
    gist: 'Packages bits into frames, adds MAC addressing, governs the local segment. Switching happens here.',
    what: 'Packages raw bits into frames, adds physical (MAC) addressing, and governs how devices share access to the same local segment — this is where switching happens.',
    examples: ['Ethernet (802.3)', 'Wi-Fi (802.11 MAC)', 'ARP', 'VLANs (802.1Q)', 'Switches'],
    why: "An ARP conflict or a switch's MAC table filling up is a Layer 2 event — invisible to a Layer 3/4 firewall, since a firewall never looks below the IP header.",
  },
  {
    num: 3,
    name: 'Network',
    icon: 'globe',
    gist: 'Logical addressing and routing across networks — how a packet finds its way there.',
    what: "Handles logical addressing and routing — how a packet gets addressed and forwarded across multiple networks toward a destination that isn't on the local segment.",
    examples: ['IP (IPv4/IPv6)', 'ICMP', 'Routers', 'Routing protocols (OSPF, BGP)'],
    why: "Most firewall rules and routing decisions are written against this layer — 'which network can reach which' is fundamentally a Layer 3 question.",
  },
  {
    num: 4,
    name: 'Transport',
    icon: 'arrow-left-right',
    gist: 'End-to-end delivery between processes — connection setup, reliability, flow control (or none).',
    what: 'Provides end-to-end delivery between two processes on two hosts — connection setup, reliability (retransmission and ordering), and flow control, or the deliberate absence of any of that.',
    examples: ['TCP', 'UDP', 'Port numbers'],
    why: 'Port numbers live here, which is why most firewall and IDS rules match on a source/destination IP + port + protocol tuple — the classic Layer 3/4 five-tuple.',
  },
  {
    num: 5,
    name: 'Session',
    icon: 'message-square',
    gist: 'Opens, tracks, and tears down the logical session between two communicating applications.',
    what: 'Establishes, maintains, and tears down the logical session between two communicating applications — tracking which packets belong to which ongoing exchange, independent of the transport connection underneath it.',
    examples: ['NetBIOS sessions', 'RPC session setup', 'SMB session establishment'],
    why: 'Modern socket APIs abstract most of this away, but the concept still explains why protocols like SMB and RPC track their own session state on top of a plain TCP connection.',
  },
  {
    num: 6,
    name: 'Presentation',
    icon: 'file-text',
    gist: 'Translates data between an app format and a wire format — encoding, serialization, compression.',
    what: "Translates data between the format an application uses and a format suitable for the wire — character encoding, serialization, compression, and, in the model's classic telling, encryption.",
    examples: ['Character encoding (ASCII/Unicode)', 'Data serialization', 'Compression'],
    why: "It's the reason a payload can look encrypted or compressed at the packet level even when the underlying data itself isn't — worth remembering when a capture shows nothing but opaque bytes.",
  },
  {
    num: 7,
    name: 'Application',
    icon: 'monitor',
    gist: 'Where named, recognizable application protocols — and the software people use — live.',
    what: 'The layer application protocols — and the software people actually interact with — operate at. This is where recognizable, named protocols live.',
    examples: ['HTTP/HTTPS', 'DNS', 'SMTP', 'SSH', 'FTP'],
    why: "Deep packet inspection, IDS/IPS signature matching, and web proxies all do their real work here — it's the layer where content, not just addressing, gets inspected.",
  },
];

interface TcpIpLayer {
  name: string;
  icon: IconName;
  gist: string;
  what: string;
  examples: string[];
  /** The real OSI layer numbers this TCP/IP layer collapses — drives BOTH the
   *  text label ("OSI Layers 1–2") and the derivation grid's row-span, so the
   *  two can never drift apart the way two hand-written copies eventually would. */
  osiLayers: number[];
}

// Ascending, Link through Application — mirrors OSI_LAYERS' bottom-up order.
const TCPIP_LAYERS: TcpIpLayer[] = [
  {
    name: 'Link',
    icon: 'link',
    gist: 'Everything involved in physically transmitting and locally addressing data on one segment.',
    what: "Combines OSI's Physical and Data Link layers — everything involved in physically transmitting and locally addressing data on a single network segment.",
    examples: ['Ethernet', 'Wi-Fi', 'ARP'],
    osiLayers: [1, 2],
  },
  {
    name: 'Internet',
    icon: 'globe',
    gist: 'Logical addressing and routing across networks.',
    what: "Corresponds directly to OSI's Network layer — logical addressing and routing across networks.",
    examples: ['IP (IPv4/IPv6)', 'ICMP'],
    osiLayers: [3],
  },
  {
    name: 'Transport',
    icon: 'arrow-left-right',
    gist: 'End-to-end delivery between processes, reliable or not.',
    what: "Corresponds directly to OSI's Transport layer — end-to-end delivery between processes, reliable or not.",
    examples: ['TCP', 'UDP'],
    osiLayers: [4],
  },
  {
    name: 'Application',
    icon: 'monitor',
    gist: 'Session management, data formatting, and the application protocol — all one layer here.',
    what: "Combines OSI's Session, Presentation, and Application layers into one — session management, data formatting, and the application protocol itself are all just the application's problem in this model.",
    examples: ['HTTP/HTTPS', 'DNS', 'SSH', 'SMTP', 'TLS'],
    osiLayers: [5, 6, 7],
  },
];

function osiLabel(nums: number[]): string {
  if (nums.length === 1) return `OSI Layer ${nums[0]}`;
  return `OSI Layers ${nums[0]}–${nums[nums.length - 1]}`;
}

// Same ordering as the cards above, for the accessible table (always
// present; the visual derivation grid below is an md+ enhancement on top of it).
const MAPPING_ROWS = TCPIP_LAYERS.map((l) => ({ name: l.name, osiLabel: osiLabel(l.osiLayers) }));

const PORT_RANGES = [
  {
    title: '0 – 1023 · Well-known',
    desc: "Assigned by IANA to the internet's core, long-established services. Historically, binding to one of these on a Unix-like system requires root or an elevated capability, since they're meant for well-known system services rather than arbitrary user processes.",
  },
  {
    title: '1024 – 49151 · Registered',
    desc: 'Assignable to a specific service on request, but nothing technically enforces that — plenty of widely-used services run here without ever formally registering, because nothing in TCP/IP stops a process from binding any free port in this range.',
  },
  {
    title: '49152 – 65535 · Dynamic / Ephemeral',
    desc: "Never assigned to a named service. This is the range an operating system draws from to hand a client application a temporary source port for the outbound side of a connection — picked per-connection, not configured.",
  },
];

const WELL_KNOWN_PORTS = [
  { port: '80', protocol: 'TCP', service: 'HTTP', desc: 'Unencrypted web traffic.' },
  { port: '443', protocol: 'TCP', service: 'HTTPS', desc: 'Encrypted web traffic (TLS).' },
  { port: '22', protocol: 'TCP', service: 'SSH', desc: 'Encrypted remote shell, file transfer, and tunneling.' },
  { port: '21', protocol: 'TCP', service: 'FTP', desc: 'File transfer control channel (the data channel is negotiated separately).' },
  { port: '25', protocol: 'TCP', service: 'SMTP', desc: 'Mail relay between mail servers.' },
  { port: '53', protocol: 'TCP/UDP', service: 'DNS', desc: 'Name resolution — UDP for ordinary lookups, TCP for zone transfers and oversized responses.' },
  { port: '3389', protocol: 'TCP', service: 'RDP', desc: 'Windows Remote Desktop.' },
  { port: '67 / 68', protocol: 'UDP', service: 'DHCP', desc: 'Automatic IP configuration — 67 is the server, 68 is the client.' },
];

// Per-layer accent hue — evenly spaced around the wheel, same `hue-rotate()`
// idiom ToolSidebar.astro uses for its own per-category color coding: applied
// only to small, isolated, childless decorative elements (the number badge's
// background, the spine dot), never to anything containing text, since
// `filter` recolors an element's whole rendered subtree.
const OSI_HUES = OSI_LAYERS.map((_, i) => Math.round((360 / OSI_LAYERS.length) * i));
const TCPIP_HUES = TCPIP_LAYERS.map((_, i) => Math.round((360 / TCPIP_LAYERS.length) * i));
// Which TCP/IP layer (and therefore which hue) each OSI layer belongs to —
// derived from TCPIP_LAYERS.osiLayers, not hand-duplicated, so the two
// visualizations (per-layer stacks + derivation grid) can never disagree
// about the mapping.
const osiNumToTcpIndex = new Map<number, number>();
TCPIP_LAYERS.forEach((l, i) => l.osiLayers.forEach((n) => osiNumToTcpIndex.set(n, i)));

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const bodyP = css({ color: 'text', lineHeight: 1.8, fontSize: '1rem', mb: '1rem' });

// "Why this matters" 3-cell grid — same shape as network-ports.astro's rangeGrid.
const whyGrid = css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(3, 1fr)' }, gap: '0.85rem' });
const whyCell = css({ p: '1rem 1.1rem', bg: 'bgCard', border: '1px solid token(colors.border)', borderRadius: 'md' });
const whyCellTitle = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.92rem', color: 'text', display: 'block' });
const whyCellDesc = css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.65, mt: '0.4rem' });

// Reverse-order toggle — a plain 2-segment switch (same visual language as
// ViewToggle/ModeToggle: bordered track, active segment gets bgCard+primary).
// Deliberately NOT wired into the shared animatedSwitch.ts sliding-thumb
// system (invariant 12) — that system is for switches whose two options
// are both meant to look equally "normal"; here the flat active/inactive
// treatment alone is enough for a control that's read once, then ignored
// while scanning the stack below it, and skipping it avoids pulling every
// per-page instance of this page's own reverse-toggle into the site-wide
// thumb-retrofit contract for a one-page control.
const orderToggleTrack = css({
  display: 'inline-flex',
  gap: '0.15rem',
  p: '0.2rem',
  bg: 'bgSubtle',
  border: '1px solid token(colors.border)',
  borderRadius: 'md',
  mb: '1.25rem',
});
const orderSegBtn = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.35rem',
  px: '0.65rem',
  py: '0.35rem',
  fontFamily: 'sans',
  fontSize: '0.8rem',
  fontWeight: 600,
  borderRadius: 'sm',
  border: '1px solid transparent',
  bg: 'transparent',
  color: 'textMuted',
  cursor: 'pointer',
  transition: 'all 150ms ease',
  _hover: { color: 'text' },
  '&[data-active]': { bg: 'bgCard', color: 'primary', borderColor: 'border', boxShadow: 'card' },
});

// The per-layer visual stack — a vertical spine (the left border) connecting
// numbered badges, closer to a real stack diagram than a plain card list.
// `flexDirection` flips via the shared `[data-order]` attribute on `<body>`
// (set by the page-local script below) so BOTH stacks (OSI + TCP/IP) reverse
// together from one control.
const stack = css({
  display: 'flex',
  flexDirection: 'column',
  gap: '0.6rem',
  mt: '1.25rem',
  position: 'relative',
  pl: '1.4rem',
  borderLeft: '2px solid token(colors.border)',
  '[data-order="top-down"] &': { flexDirection: 'column-reverse' },
});
const layerRow = `${card()} ${css({ cursor: 'default', position: 'relative' })}`;
const spineDot = css({
  position: 'absolute',
  left: 'calc(-1.4rem - 5px)',
  top: '1.1rem',
  w: '8px',
  h: '8px',
  borderRadius: 'full',
  bg: 'primary',
  boxShadow: '0 0 0 3px token(colors.bg)',
});
const layerHead = css({ display: 'flex', alignItems: 'center', gap: '0.6rem', flexWrap: 'wrap' });
const numBadge = css({
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  width: '2.1rem',
  height: '2.1rem',
  borderRadius: 'md',
  bg: 'color-mix(in srgb, token(colors.primary) 15%, transparent)',
  color: 'primary',
  fontFamily: 'mono',
  fontWeight: 700,
  fontSize: '0.85rem',
  flexShrink: 0,
});
const layerIconTile = css({ color: 'primary', flexShrink: 0 });
const layerName = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '1.02rem', color: 'text' });
const gistText = css({ color: 'text', fontSize: '0.88rem', lineHeight: 1.6, mt: '0.5rem', m: 0 });
const exampleRow = css({ display: 'flex', flexWrap: 'wrap', gap: '0.35rem', mt: '0.6rem' });

const moreDetails = css({ mt: '0.6rem' });
const moreSummary = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '0.3rem',
  cursor: 'pointer',
  listStyle: 'none',
  userSelect: 'none',
  fontFamily: 'sans',
  fontSize: '0.78rem',
  fontWeight: 600,
  color: 'primary',
  '&::-webkit-details-marker': { display: 'none' },
  '&::marker': { display: 'none' },
  '& svg': { transition: 'transform 200ms ease' },
  'details[open] > &': { '& svg': { transform: 'rotate(90deg)' } },
});
const moreBody = css({ color: 'textMuted', fontSize: '0.86rem', lineHeight: 1.7, mt: '0.5rem' });
const moreWhyLabel = css({
  fontFamily: 'sans',
  fontSize: '0.7rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  color: 'primary',
  mt: '0.7rem',
  mb: '0.2rem',
});

const mapNote = css({ color: 'textMuted', fontSize: '0.82rem', mt: '0.65rem', mb: 0 });
const mapNoteStrong = css({ color: 'text', fontWeight: 700 });

// The visual derivation diagram — a single CSS Grid with 7 row-tracks (one
// per OSI layer). OSI cells sit in column 1 at their own row; each TCP/IP
// cell sits in column 3 with `gridRow` spanning the exact row-lines its own
// `osiLayers` covers (computed in frontmatter, see `rowSpan()` below) — so a
// TCP/IP layer's box literally overlaps the vertical space of the OSI rows
// it merges, on screen, rather than needing a reader to cross-reference a
// table. Column 2 is a thin connector rail. md+ only (see `diagramWrap`) —
// a 3-column grid with row-spanning gets cramped below that, where the
// plain `<table>` (always rendered, see `mapTableWrap`) is the accessible
// baseline instead. Deliberately does NOT participate in the reverse-order
// toggle — this is a structural fact ("these layers merge into this one"),
// not a flow direction, so it always reads top-to-bottom in the canonical
// Physical->Application numbering, same as the mapping table underneath it.
const diagramWrap = css({ display: { base: 'none', md: 'block' }, mt: '1.5rem' });
// Guards diagramGrid's hard-coded row count (see its own comment for why it
// can't be interpolated). Fails the build rather than silently rendering a
// diagram whose grid has fewer rows than there are OSI layers to place in it.
if (OSI_LAYERS.length !== 7) {
  throw new Error(
    `osi-model: diagramGrid declares a literal 7 grid rows but OSI_LAYERS.length is ${OSI_LAYERS.length}. Panda needs a static value there, so update both together.`,
  );
}
const diagramGrid = css({
  display: 'grid',
  gridTemplateColumns: '1fr 2rem 1fr',
  // Every OSI layer is ONE equal-height unit, so a TCP/IP box spanning N of
  // them is exactly N units tall — that proportionality is the whole point of
  // the diagram. `auto` rows broke it: a TCP/IP cell spanning a single row
  // (Internet -> L3, Transport -> L4) sized that row to its own content, so
  // rows 3-4 rendered ~73px against ~42px for the other five, leaving the OSI
  // column visibly ragged. A fixed row height (plus the single-line cell
  // layout below, which is what makes one line actually fit) keeps all seven
  // identical. If a label ever needs more room, raise this value — don't go
  // back to `auto`, which re-introduces the raggedness.
  //
  // The row count is a LITERAL, not `repeat(${OSI_LAYERS.length}, …)`, and
  // that matters: Panda only extracts statically-analyzable style values. A
  // dynamic template literal still yields a class *name* at SSR (the element
  // really does get `grid-tr_repeat(7,_2.75rem)`) but Panda never emits a
  // matching CSS rule for it, so the declaration silently does nothing —
  // which is why the original `repeat(${OSI_LAYERS.length}, auto)` here had
  // no effect at all. The assertion above `diagramGrid` keeps this literal
  // honest against the real data.
  gridTemplateRows: 'repeat(7, 2.75rem)',
  gap: '0.4rem 0',
  alignItems: 'stretch',
});
const diagCellBase = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.5rem',
  px: '0.75rem',
  py: '0.55rem',
  borderRadius: 'md',
  border: '1px solid token(colors.border)',
  fontSize: '0.82rem',
  fontWeight: 600,
  color: 'text',
});
const diagOsiCell = css({ gridColumn: 1 });
// One LINE — name on the left, the "OSI Layers x-y" label pushed right —
// rather than the two stacked lines this used to be. Stacking forced a
// single-row cell to be two lines tall, which is what made its grid row
// outgrow the others (see diagramGrid above).
const diagTcpCell = css({
  gridColumn: 3,
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'space-between',
  gap: '0.5rem',
  bg: 'bgCard',
});
const diagRail = css({ gridColumn: 2, display: 'flex', alignItems: 'stretch', justifyContent: 'center' });
const diagRailBar = css({ w: '2px', bg: 'token(colors.border)' });
// Isolated, childless swatches — the only elements that get `hue-rotate()`
// in this diagram (see spineDot's own comment above: `filter` recolors an
// element's whole rendered subtree, so it must never land on anything that
// also contains text, or the text itself silently shifts hue along with it).
const diagSwatch = css({ display: 'inline-block', w: '9px', h: '9px', borderRadius: 'full', bg: 'primary', flexShrink: 0 });
const diagTcpNameRow = css({ display: 'flex', alignItems: 'center', gap: '0.4rem', minW: 0 });
const diagTcpName = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.85rem', whiteSpace: 'nowrap' });
// `flexShrink: 0` + `nowrap`: this label is the diagram's actual payload (which
// OSI layers this box absorbs), so it must never wrap to a second line — a
// wrap here would overflow the now-fixed row height.
const diagTcpSpan = css({ fontFamily: 'sans', fontWeight: 500, fontSize: '0.72rem', color: 'textMuted', whiteSpace: 'nowrap', flexShrink: 0 });

const mapTableWrap = css({ mt: '1.5rem', border: '1px solid token(colors.border)', borderRadius: 'md', overflowX: 'auto', '[data-has-diagram] &': { display: { base: 'block', md: 'none' } } });
const mapTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' });
const mapTh = css({
  textAlign: 'left',
  color: 'textMuted',
  fontFamily: 'sans',
  fontWeight: 600,
  fontSize: '0.68rem',
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  bg: 'bgCard',
  p: '0.55rem 0.85rem',
  borderBottom: '1px solid token(colors.border)',
});
const mapTd = css({ fontSize: '0.88rem', color: 'text', p: '0.55rem 0.85rem', borderBottom: '1px solid token(colors.border)' });
const mapTdMono = css({ fontFamily: 'mono', fontWeight: 700, color: 'primary' });

// Port-range cards — same 3-column shape as the OSI-adjacent whyGrid above,
// reused rather than forked.
const rangeGrid = css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(3, 1fr)' }, gap: '0.85rem', mt: '1.25rem' });
const rangeCell = css({ p: '1rem 1.1rem', bg: 'bgCard', border: '1px solid token(colors.border)', borderRadius: 'md' });
const rangeCellTitle = css({ fontFamily: 'mono', fontWeight: 700, fontSize: '0.85rem', color: 'primary', display: 'block' });
const rangeCellDesc = css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.65, mt: '0.4rem' });

const portTableWrap = css({ mt: '1.5rem', border: '1px solid token(colors.border)', borderRadius: 'md', overflowX: 'auto' });
const portTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' });
const portTh = mapTh;
const portTdPort = css({ fontFamily: 'mono', fontWeight: 700, color: 'primary', p: '0.55rem 0.85rem', borderBottom: '1px solid token(colors.border)', whiteSpace: 'nowrap' });
const portTdProto = css({ fontFamily: 'mono', fontSize: '0.8rem', color: 'textMuted', p: '0.55rem 0.85rem', borderBottom: '1px solid token(colors.border)', whiteSpace: 'nowrap' });
const portTdService = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.85rem', color: 'text', p: '0.55rem 0.85rem', borderBottom: '1px solid token(colors.border)', whiteSpace: 'nowrap' });
const portTdDesc = css({ color: 'textMuted', fontSize: '0.85rem', lineHeight: 1.6, p: '0.55rem 0.85rem', borderBottom: '1px solid token(colors.border)' });

const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
---

<BaseLayout
  title="OSI & TCP/IP Model Reference"
  description="The OSI seven-layer model and the practical four-layer TCP/IP model it's usually simplified to — what each layer does, the protocols that actually run there, a visual derivation diagram, and the three IANA port ranges with the ports that matter most day to day."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'OSI & TCP/IP Model Reference' }]}
    eyebrow="Reference"
    title="OSI & TCP/IP Model Reference"
    description="The OSI seven-layer model, the four-layer TCP/IP model it collapses into in practice, a visual derivation diagram, and the IANA port ranges every connection on the network draws from."
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      Neither model is a protocol — both are just ways of organizing where a given protocol's job starts and
      ends. OSI is the seven-layer teaching framework; TCP/IP is the simpler four-layer version real networking
      is actually built on.
    </p>
  </aside>

  <h2 id="why-it-matters" class={sectionH2}>
    <Icon name="crosshair" size={20} class={css({ color: 'primary' })} /> Why the layers matter
  </h2>
  <div class={whyGrid}>
    <div class={whyCell}>
      <span class={whyCellTitle}>It defines scope</span>
      <p class={whyCellDesc}>
        A Layer 2 problem (an ARP conflict, a switching loop) and a Layer 7 problem (a broken API response) live
        in different parts of the stack — knowing which one you're looking at points you at the right evidence.
      </p>
    </div>
    <div class={whyCell}>
      <span class={whyCellTitle}>It makes packet captures readable</span>
      <p class={whyCellDesc}>
        Every protocol wraps the one above it — an Ethernet frame carries an IP packet, which carries a TCP
        segment, which carries an HTTP request. A raw capture opens with link-layer headers first because of this.
      </p>
    </div>
    <div class={whyCell}>
      <span class={whyCellTitle}>It locates where controls sit</span>
      <p class={whyCellDesc}>
        A stateless ACL only ever looks at Layer 3/4 — source, destination, port, protocol. A proxy or IDS doing
        signature matching works at Layer 7, reading actual content. Knowing the difference tells you what a
        control can and can't see.
      </p>
    </div>
  </div>

  <h2 id="osi-model" class={sectionH2}>
    <Icon name="layers" size={20} class={css({ color: 'primary' })} /> The OSI 7-layer model
  </h2>
