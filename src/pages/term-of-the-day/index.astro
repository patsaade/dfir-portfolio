---
// Compatibility redirect. The glossary page briefly lived at /term-of-the-day/
// before being renamed to /reference/glossary/ ("Term of the Day" now names only the ticker).
// A meta-refresh is used so it composes cleanly with trailingSlash: 'always'.
// Static page — prerender to HTML served from the CDN (output: 'server' is on-demand by default).
export const prerender = true;
const dest = '/reference/glossary/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    {/* Deliberately NO rel=canonical. It used to carry one pointing at the
        destination, which contradicts the noindex directly below: a canonical
        says "index the other URL in place of this one" while noindex says
        "don't index this at all", and Google's own guidance is not to combine
        the two — the conflicting pair is what shows up in Search Console as a
        page with mixed exclusion reasons. The noindex alone is the unambiguous
        instruction, and the meta-refresh plus the real link below already tell
        both crawlers and humans where the content went. (The old canonical was
        also relative rather than absolute, unlike every other on the site.) */}
    <meta name="robots" content="noindex" />
    <title>Moved — Glossary</title>
  </head>
  <body>
    <p>This page has moved to the <a href={dest}>Glossary</a>.</p>
  </body>
</html>
