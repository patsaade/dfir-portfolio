---
// Networking topic hub — a thin wrapper around DomainHub, which renders every
// one of the three hubs (/dfir/, /networking/, /systems/) from SITE_ENTRIES'
// `domains` tags. Everything structural lives there; this file owns only the
// route, the prerender flag and this page's own <BaseLayout> metadata.
//
// `networking` sits at exactly 8 tagged entries — the hub threshold — and only
// clears it because the subnetting drill is tagged. See consts.ts's own note.
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainHub from '../components/DomainHub.astro';
---

<BaseLayout
  title="Networking"
  description="Every networking page on the site in one place — IP/CIDR, DNS record and HTTP status lookups, the OSI and TCP/IP model reference, the MAC analyzer and CIDR calculator, and the subnetting drill."
>
  <DomainHub domain="networking" />
</BaseLayout>
