// `domains` tags. Everything structural lives there; this file owns only the
// route, the prerender flag and this page's own <BaseLayout> metadata.
//
// `systems` sits at exactly 8 tagged entries — the hub threshold — and only
// clears it because two drills are tagged. See consts.ts's own note.
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainHub from '../components/DomainHub.astro';
---

