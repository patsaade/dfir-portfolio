  title="Systems"
  description="Every systems page on the site in one place — the ASCII and character-encoding table, the regex syntax cheat sheet, the cron parser, number-base and data-size converters, and the regex and terminal-command drills."
>
  <DomainHub domain="systems" />
</BaseLayout>
