---
// Recycle Bin ($I) Parser — decode a Windows $I metadata file entirely
// client-side. Same page shape as the LNK Parser / MFT & USN Analyzer
// (intro aside -> interactive tool -> reference notes -> related tools ->
// external resources). Static page — prerender to HTML served from the CDN.
export const prerender = true;
import { css } from 'styled-system/css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import RecycleBinParser from '../../components/RecycleBinParser.astro';
import Term from '../../components/Term.astro';
import { toolChip } from '../../components/RelatedTools.astro';
import ExternalResources from '../../components/ExternalResources.astro';
import { EXTERNAL_RESOURCES } from '../../data/externalResources';

const sectionH2 = css({
  display: 'flex',
  alignItems: 'center',
  gap: '0.6rem',
  fontSize: '1.3rem',
  fontWeight: 700,
  mt: '2.5rem',
  mb: '1rem',
  pt: '1.5rem',
  borderTop: '1px solid token(colors.border)',
  scrollMarginTop: '90px',
});
const refTable = css({ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' });
const refTh = css({
  textAlign: 'left',
  color: 'textMuted',
  fontFamily: 'sans',
  fontWeight: 600,
  fontSize: '0.72rem',
  textTransform: 'uppercase',
  letterSpacing: '0.06em',
  p: '0.5rem 0.7rem',
  borderBottom: '1px solid token(colors.border)',
});
const refTd = css({
  p: '0.5rem 0.7rem',
  borderBottom: '1px solid token(colors.border)',
  color: 'text',
  verticalAlign: 'top',
  fontFamily: 'mono',
  fontSize: '0.82rem',
  whiteSpace: 'nowrap',
});
const refTdMuted = css({
  p: '0.5rem 0.7rem',
  borderBottom: '1px solid token(colors.border)',
  color: 'textMuted',
  fontSize: '0.8rem',
  verticalAlign: 'top',
});
const relatedList = css({ display: 'flex', flexDirection: 'column', gap: '0.85rem' });
const relatedReason = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.35rem', lineHeight: 1.6 });
const bodyText = css({ color: 'textMuted', fontSize: '0.9rem', lineHeight: 1.8, mb: '1rem' });
const inlineCode = css({
  fontFamily: 'mono',
  fontSize: '0.85em',
  bg: 'codeBg',
  border: '1px solid token(colors.border)',
  borderRadius: 'sm',
  px: '0.3rem',
});
const tableCaption = css({
  color: 'textMuted',
  fontFamily: 'sans',
  fontSize: '0.72rem',
  fontWeight: 700,
  textTransform: 'uppercase',
  letterSpacing: '0.08em',
  mt: '1.5rem',
  mb: '0.5rem',
});

interface LayoutRow {
  offset: string;
  size: string;
  field: string;
  note: string;
}

// Offsets per libyal/dtformats' "Windows Recycle.Bin file formats"
// documentation (linked in Other resources below), cross-checked against
// rifiuti2's own $I parser source. src/utils/recycleBin.ts implements
// exactly this table — nothing here is inferred.
const V1_LAYOUT: LayoutRow[] = [
  { offset: '0x00', size: '8', field: 'Format version', note: 'Little-endian; the value 1 identifies a Vista/7/8/8.1 record.' },
  { offset: '0x08', size: '8', field: 'Original file size', note: 'Little-endian byte count of the item as it was before deletion.' },
  { offset: '0x10', size: '8', field: 'Deletion time', note: 'Windows FILETIME — 100-nanosecond ticks since 1601-01-01, in UTC.' },
  {
    offset: '0x18',
    size: '520',
    field: 'Original path',
    note: 'UTF-16LE, null-terminated then zero-padded out to a fixed 260 characters (the legacy MAX_PATH), which is why every version 1 record is exactly 544 bytes.',
  },
];

const V2_LAYOUT: LayoutRow[] = [
  { offset: '0x00', size: '8', field: 'Format version', note: 'Little-endian; the value 2 identifies a Windows 10/11 record.' },
  { offset: '0x08', size: '8', field: 'Original file size', note: 'Same field, same position as version 1.' },
  { offset: '0x10', size: '8', field: 'Deletion time', note: 'Same field, same position as version 1.' },
  {
    offset: '0x18',
    size: '4',
    field: 'Path length',
    note: 'The new field in version 2 — a count of UTF-16 characters, including the terminating null, so the string occupies twice that many bytes.',
  },
  {
    offset: '0x1C',
    size: 'variable',
    field: 'Original path',
    note: 'UTF-16LE, null-terminated. Sized from the field above, which is why version 2 records are usually smaller than the old fixed 544 bytes.',
  },
];
---

<BaseLayout
  title="Recycle Bin ($I) Parser"
  description="Decode a Windows Recycle Bin $I metadata file — the deleted item's original full path, its size, and the deletion timestamp. Both format versions, entirely in your browser, nothing uploaded."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Recycle Bin ($I) Parser' }]}
    eyebrow="Artifact Parsers"
    title="Recycle Bin ($I) Parser"
    description="Upload a $I metadata file to recover the deleted item's original path, its size, and when it was sent to the Recycle Bin — decoded locally in your browser."
  />

  <aside
    class={css({
      bg: 'bgSubtle',
      border: '1px solid token(colors.border)',
      borderLeftWidth: '3px',
      borderLeftColor: 'primary',
      borderRadius: 'md',
      p: '1rem 1.25rem',
      mb: '1.5rem',
    })}
  >
    <p class={css({ color: 'text', lineHeight: 1.7, fontSize: '0.95rem', m: 0 })}>
      A <Term slug="recycle-bin-i-r">$I file</Term> is read locally via the File API and decoded byte-by-byte against the
      documented record layout, entirely in your browser — the file you choose never leaves your machine. Both format
      versions are handled and the one actually found is reported, never assumed. A record whose version field is
      neither 1 nor 2 is rejected with the observed value named, rather than being force-fit into a layout it may not use.
    </p>
  </aside>

  <h2 id="parser" class={css({ display: 'flex', alignItems: 'center', gap: '0.6rem', fontSize: '1.3rem', fontWeight: 700, mb: '1rem', scrollMarginTop: '90px' })}>
    <Icon name="trash-2" size={20} class={css({ color: 'primary' })} /> Parser
  </h2>
  <RecycleBinParser />

  <h2 id="artifact" class={sectionH2}>
    <Icon name="hard-drive" size={20} class={css({ color: 'primary' })} /> Where the file comes from
  </h2>
  <p class={bodyText}>
    On Vista and later, each NTFS volume has a hidden <code class={inlineCode}>$Recycle.Bin</code> folder holding one
    subfolder per user, named for that user's SID. Sending an item to the Recycle Bin does not move it out of the file
    system — it renames it into that folder and writes <em>two</em> files: a{' '}
    <code class={inlineCode}>$R</code> file holding the original content, and a <code class={inlineCode}>$I</code> file
    holding the metadata Explorer needs to show the item's original location, size and deletion date. The two share the
    same randomly generated six-character identifier and the original extension, so{' '}
    <code class={inlineCode}>$IA1B2C3.xlsx</code> pairs with <code class={inlineCode}>$RA1B2C3.xlsx</code>. This tool
    reads the <code class={inlineCode}>$I</code> half; the <code class={inlineCode}>$R</code> half has no header of its
    own — it is simply the original file's bytes under a new name — so there is nothing there to parse, only to recover.
    Pre-Vista Windows (XP, 2000, Server 2003) used a completely different mechanism — one shared{' '}
    <code class={inlineCode}>INFO2</code> index file per drive, not per-item <code class={inlineCode}>$I</code>/
    <code class={inlineCode}>$R</code> pairs — which this tool doesn't cover.
  </p>
  <p class={bodyText}>
    Why it matters for an investigation: the <code class={inlineCode}>$I</code> record preserves the item's{' '}
    <strong class={css({ color: 'text' })}>full original path</strong>, which is often the only surviving evidence of
    where a file lived and what it was called. That makes it a direct source for{' '}
    <Term slug="timeline-analysis">timeline analysis</Term> and for{' '}
    <Term slug="deleted-file-recovery">deleted-file recovery</Term> — and a common check when{' '}
    <Term slug="anti-forensics">anti-forensic</Term> file deletion is suspected, since a user emptying the Recycle Bin
    still has to overwrite or unallocate those records, and{' '}
    <Term slug="file-carving">carving</Term> them back out of{' '}
    <Term slug="unallocated-space">unallocated space</Term> is a standard next step.
  </p>

  <h2 id="layout" class={sectionH2}>
    <Icon name="list" size={20} class={css({ color: 'primary' })} /> Record layout
  </h2>
  <p class={bodyText}>
    Microsoft publishes no specification for this format. The field offsets below come from libyal/dtformats' published
    format documentation, which is exactly what this tool implements — but dtformats documents version 1's path field
    only as variable-length. The fixed 544-byte version 1 record size is a separate fact, confirmed independently from
    the rifiuti2 parser's own source (both linked under Other resources). Every multi-byte field is little-endian.
  </p>

  <p class={tableCaption}>Version 1 — Windows Vista, 7, 8 and 8.1 (a fixed 544-byte record)</p>
  <div class={css({ overflowX: 'auto' })} tabindex="0" role="region" aria-label="Version 1 record layout table">
    <table class={refTable}>
      <thead>
        <tr>
          <th class={refTh}>Offset</th>
          <th class={refTh}>Bytes</th>
          <th class={refTh}>Field</th>
          <th class={refTh}>Notes</th>
        </tr>
      </thead>
      <tbody>
        {
          V1_LAYOUT.map((row) => (
            <tr>
              <td class={refTd}>{row.offset}</td>
              <td class={refTd}>{row.size}</td>
              <td class={refTdMuted}>
                <strong class={css({ color: 'text' })}>{row.field}</strong>
              </td>
              <td class={refTdMuted}>{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class={tableCaption}>Version 2 — Windows 10 and 11 (variable length)</p>
  <div class={css({ overflowX: 'auto' })} tabindex="0" role="region" aria-label="Version 2 record layout table">
    <table class={refTable}>
      <thead>
        <tr>
          <th class={refTh}>Offset</th>
          <th class={refTh}>Bytes</th>
          <th class={refTh}>Field</th>
          <th class={refTh}>Notes</th>
        </tr>
      </thead>
      <tbody>
        {
          V2_LAYOUT.map((row) => (
            <tr>
              <td class={refTd}>{row.offset}</td>
              <td class={refTd}>{row.size}</td>
              <td class={refTdMuted}>
                <strong class={css({ color: 'text' })}>{row.field}</strong>
              </td>
              <td class={refTdMuted}>{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="reading" class={sectionH2}>
    <Icon name="search" size={20} class={css({ color: 'primary' })} /> Reading the output
  </h2>
  <p class={bodyText}>
    A few things worth knowing before you lean on a decoded record:
  </p>
  <ul class={css({ color: 'textMuted', fontSize: '0.9rem', lineHeight: 1.8, pl: '1.2rem', display: 'flex', flexDirection: 'column', gap: '0.5rem', mb: '1rem' })}>
    <li>
      <strong class={css({ color: 'text' })}>The deletion time is UTC.</strong> It is a Windows FILETIME, so it needs no
      timezone correction to be compared against other UTC artifact timestamps — but it will not match what the Recycle
      Bin showed the user, which Explorer renders in local time.
    </li>
    <li>
      <strong class={css({ color: 'text' })}>A zero timestamp is shown as "not set", not as 1601.</strong> The FILETIME
      epoch is 1601-01-01, so a naive parser renders an unset field as that date and quietly poisons a timeline.
    </li>
    <li>
      <strong class={css({ color: 'text' })}>The recorded size is the item's size before deletion,</strong> not the size
      of the <code class={inlineCode}>$I</code> file itself. Comparing it against the paired{' '}
      <code class={inlineCode}>$R</code> file's actual size on disk is a cheap sanity check that the pair belongs
      together and is intact.
    </li>
    <li>
      <strong class={css({ color: 'text' })}>A version 1 record is always 544 bytes.</strong> If a file claiming version
      1 is a different length it was probably carved or truncated, and the tool says so in its notes rather than
      silently reading whatever follows.
    </li>
    <li>
      <strong class={css({ color: 'text' })}>Nothing here proves who deleted the item.</strong> The record has no user
      field — the account attribution comes from the SID-named parent folder the file was sitting in, which is context
      you have to carry in from the acquisition, not something the bytes can tell you.
    </li>
  </ul>

  <h2 id="related" class={sectionH2}>
    <Icon name="wrench" size={20} class={css({ color: 'primary' })} /> Related tools
  </h2>
  <div class={relatedList}>
    <div>
      <a href="/tools/mft-usn-analyzer/" class={toolChip}>
        <Icon name="history" size={13} /> Timestomp Analyzer <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Cross-check a recovered deletion time against the item's own $STANDARD_INFORMATION and $FILE_NAME timestamps in
        its MFT record — a disagreement there is the classic <Term slug="timestomping">timestomping</Term> indicator.
      </p>
    </div>
    <div>
      <a href="/tools/timestamp-converter/" class={toolChip}>
        <Icon name="clock" size={13} /> Timestamp Converter <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        Convert the raw FILETIME tick count this tool surfaces into any other epoch format, or into a specific analyst
        timezone, when you're merging it into a wider timeline.
      </p>
    </div>
    <div>
      <a href="/tools/lnk-parser/" class={toolChip}>
        <Icon name="link" size={13} /> LNK Parser <Icon name="arrow-right" size={13} />
      </a>
      <p class={relatedReason}>
        A shortcut file may still reference the deleted item's original path, independently corroborating what the $I
        record recovered — and often adding the volume serial number the $I record has no field for.
      </p>
    </div>
  </div>

  <ExternalResources resources={EXTERNAL_RESOURCES['recycle-bin-parser']} />
</BaseLayout>
