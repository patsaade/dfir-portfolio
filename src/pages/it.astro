---
// IT landing page — the "browse everything" destination for IT_GROUPS,
// general networking/IT tools that aren't DFIR-specific (see consts.ts's own
// comment, and CLAUDE.md's "Nav grouping" invariant, for the IT-vs-DFIR
// dividing line). Structured the SAME way as dfir.astro: PageHeader → a
// GroupOverview jump-strip (one tile per IT_GROUPS category) → one
// always-visible <section id={g.id}> per category, each a card-grid of that
// category's links — deliberately mirroring DFIR's own pattern even though
// IT currently has only two 1-link categories, so this page's shape doesn't
// need to change again as IT grows (same precedent DFIR_GROUPS itself set —
// see consts.ts).
export const prerender = true;
import { css } from 'styled-system/css';
import { card } from 'styled-system/recipes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import GroupOverview from '../components/GroupOverview.astro';
import Icon from '../components/Icon.astro';
import { IT_GROUPS } from '../consts';

const groupTiles = IT_GROUPS.map((g) => ({
  id: g.id,
  icon: g.links[0].icon,
  title: g.category,
  blurb: g.blurb,
  count: g.links.length,
}));

const allLinks = IT_GROUPS.flatMap((g) => g.links);
const totalLinks = allLinks.length;

const sectionWrap = css({ borderTop: '1px solid token(colors.border)', py: '1.25rem', scrollMarginTop: '90px' });
const sectionHead = css({ display: 'flex', alignItems: 'center', gap: '0.6rem', flexWrap: 'wrap', m: 0, fontSize: '1.25rem', fontWeight: 700 });
const sectionCount = css({
  fontFamily: 'sans',
  fontSize: '0.68rem',
  fontWeight: 600,
  color: 'textMuted',
  bg: 'bgSubtle',
  border: '1px solid token(colors.border)',
  borderRadius: 'full',
  px: '0.5rem',
  py: '0.1rem',
});
const sectionBlurb = css({ color: 'textMuted', fontSize: '0.85rem', mt: '0.5rem', mb: 0 });
const cardsGrid = css({ mt: '1rem' }); // columns/gap come from the shared .card-grid class
const linkCard = `${card()} ${css({ _hover: { boxShadow: 'card' } })}`;
const cardHead = css({ display: 'flex', alignItems: 'center', gap: '0.5rem' });
const cardTitle = css({ fontFamily: 'sans', fontWeight: 700, fontSize: '0.9rem', color: 'text', lineHeight: 1.3 });
const cardDesc = css({ color: 'textMuted', fontSize: '0.82rem', lineHeight: 1.45, mt: '0.3rem' });
---

<BaseLayout
  title="IT"
  description="General IT & networking tools and reference material — subnet math, CIDR planning — kept separate from the DFIR-specific toolkit."
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'IT' }]}
    eyebrow="Reference & Tools"
    title="IT"
    description="General networking and IT reference — the kind of subnet/CIDR math that's useful well beyond incident response. Split out from DFIR so that section stays purely forensics/IR-focused."
  />

  <p role="status" aria-live="polite" class={css({ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '0.3rem 0.6rem', color: 'textMuted', fontSize: '0.9rem', mt: '-0.5rem', mb: '1.5rem' })}>
    <span>{totalLinks} destinations across {IT_GROUPS.length} categories</span>
  </p>

  <GroupOverview items={groupTiles} heading="Browse by category" />

  {
    IT_GROUPS.map((g) => (
      <section id={g.id} class={sectionWrap}>
        <h2 class={sectionHead}>
          <Icon name={g.links[0].icon} size={20} class={css({ color: 'primary', flexShrink: 0 })} />
          <span>{g.category}</span>
          <span class={sectionCount}>{g.links.length}</span>
        </h2>
        <p class={sectionBlurb}>{g.intro}</p>
        <div class={`card-grid ${cardsGrid}`}>
          {g.links.map((link) => (
            <a href={link.href} class={linkCard}>
              <span class={cardHead}>
                <Icon name={link.icon} size={16} class={css({ color: 'primary', flexShrink: 0 })} />
                <span class={cardTitle}>{link.label}</span>
              </span>
              <p class={cardDesc}>{link.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
